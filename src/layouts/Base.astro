---
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import ContactBand from '../components/ContactBand.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import TabBar from '../components/TabBar.astro';
import { getArticles, getProfile } from '../lib/content';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown>[];
  contactBand?: boolean;
}

const { contactBand = true, ...seo } = Astro.props;
const profile = getProfile();
const showArticles = getArticles().length > 0;
---

<!doctype html>
<html lang="fr" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo {...seo} />
    <link rel="preload" href="/fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-64.png" sizes="64x64" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f1ede3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1631" media="(prefers-color-scheme: dark)" />
    <meta name="author" content={profile.name} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <!-- Shared by every print: soft halo of objects, uneven exposure, cyanotype toning of real captures. -->
    <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
      <filter id="pg-soft" x="-10%" y="-10%" width="120%" height="120%"><feGaussianBlur stdDeviation="7"></feGaussianBlur></filter>
      <radialGradient id="pg-exposure" cx="42%" cy="38%" r="75%">
        <stop offset="0" stop-color="#fff" stop-opacity=".1"></stop>
        <stop offset="1" stop-color="#000" stop-opacity=".22"></stop>
      </radialGradient>
      <filter id="pg-cyano" color-interpolation-filters="sRGB">
        <feColorMatrix type="matrix" values=".3 .59 .11 0 0 .3 .59 .11 0 0 .3 .59 .11 0 0 0 0 0 1 0"></feColorMatrix>
        <feComponentTransfer>
          <feFuncR type="table" tableValues=".96 .3 .06 .05"></feFuncR>
          <feFuncG type="table" tableValues=".95 .42 .16 .14"></feFuncG>
          <feFuncB type="table" tableValues=".9 .62 .42 .38"></feFuncB>
        </feComponentTransfer>
      </filter>
    </svg>
    <Header name={profile.name} showArticles={showArticles} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    {contactBand && <ContactBand profile={profile} />}
    <Footer name={profile.name} />
    <TabBar />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
  .defs {
    position: absolute;
  }
</style>
