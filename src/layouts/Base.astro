---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import type { Profile } from '../lib/schemas';

interface Props {
  title: string;
  description: string;
  /** Share image: absolute or site-relative URL. */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'profile';
  jsonLd?: Record<string, unknown>[];
  /** The 404 page has no sections to link to. */
  nav?: boolean;
  /** Only name and location are used here (header, footer, author). */
  profile: Pick<Profile, 'name' | 'location'>;
}

const { nav = true, profile, ...seo } = Astro.props;
---

<!doctype html>
<html lang="fr" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo {...seo} />
    <link rel="preload" href="/fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-64.png" sizes="64x64" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f2eee5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12110e" media="(prefers-color-scheme: dark)" />
    <meta name="author" content={profile.name} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <SiteHeader name={profile.name} nav={nav} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer name={profile.name} location={profile.location} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
