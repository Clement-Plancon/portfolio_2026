---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import type { Profile } from '../lib/schemas';
import type { ResolvedSection } from '../lib/site';
import { AMBIANCE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Share image: absolute or site-relative URL. */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'profile';
  jsonLd?: Record<string, unknown>[];
  /** The 404 page has no sections to link to. */
  nav?: boolean;
  /** Only name and location are used here (header, footer, author). */
  profile: Pick<Profile, 'name' | 'location'>;
  /** The sections of the page, for the navigation (none on the 404 page). */
  sections?: ResolvedSection[];
  /** Colours of the threads of the scene. */
  threads?: string[];
  ambiance?: keyof typeof AMBIANCE;
  /** "svg": never start the WebGL scene. */
  scene?: 'auto' | 'svg';
}

const { nav = true, profile, sections = [], threads = [], ambiance = 'braise', scene = 'auto', ...seo } = Astro.props;
const accent = AMBIANCE[ambiance].accent;
---

<!doctype html>
<html lang="fr" id="top" data-ambiance={ambiance} style={`--accent:${accent}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo {...seo} />
    <link rel="preload" href="/fonts/bricolage.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-64.png" sizes="64x64" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f0e0d" />
    <meta name="author" content={profile.name} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    {nav && scene !== 'svg' && <canvas class="scene" aria-hidden="true" data-scene-canvas data-threads={JSON.stringify(threads)}></canvas>}
    <SiteHeader name={profile.name} sections={nav ? sections : []} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer name={profile.name} location={profile.location} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
  body {
    padding-bottom: var(--bar-h);
  }
</style>
