---
// Project pictograms: 24-unit grid, 2px stroke, square caps — the same drawing rules as the
// navigation pictograms. They are graphic interpretations of each project's subject.
import type { PICTOGRAMS } from '../lib/schemas';

export type PictogramName = (typeof PICTOGRAMS)[number] | 'accueil' | 'projets' | 'parcours' | 'apropos' | 'contact' | 'articles';

interface Props {
  name: PictogramName;
  size?: number;
  class?: string;
}
const { name, size = 24, class: cls } = Astro.props;

const PATHS: Record<PictogramName, string> = {
  feuille: 'M5 19C5 9 11 4 20 4c0 9-5 15-15 15Zm0 0 9-9',
  jauge: 'M3 17a9 9 0 1 1 18 0M12 17l5-6M3 17h3m12 0h3M12 8V6',
  dossier: 'M3 6h6l2 2h10v11H3zM3 11h18',
  radar: 'M12 12 19 5M12 21a9 9 0 1 1 9-9M12 16a4 4 0 1 1 4-4',
  alerte: 'M12 4v9m0 4v1M5 9a8 8 0 0 0 0 7m14-7a8 8 0 0 1 0 7M8 11a4 4 0 0 0 0 3m8-3a4 4 0 0 1 0 3',
  graphique: 'M4 20V4m0 16h16M8 16v-4m4 4V7m4 9v-6',
  code: 'M8 7l-5 5 5 5m8-10 5 5-5 5M14 4l-4 16',
  mobile: 'M7 3h10v18H7zM11 18h2',
  equipe: 'M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2 20a6 6 0 0 1 12 0m-2-1a6 6 0 0 1 10 1',
  accueil: 'M3 11 12 4l9 7v9h-6v-6H9v6H3z',
  projets: 'M4 5h16M4 12h16M4 19h16M4 5v14',
  parcours: 'M6 3v18M6 7h11l2 2-2 2H6M6 15h8',
  apropos: 'M12 11v6m0-10v1M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z',
  contact: 'M3 6h18v12H3zM3 6l9 7 9-7',
  articles: 'M5 3h10l4 4v14H5zM9 11h6M9 15h6',
};
---

<svg class:list={['picto', cls]} viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false">
  <path d={PATHS[name]} />
</svg>

<style>
  .picto {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
</style>
