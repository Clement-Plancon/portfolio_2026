---
import type { Skills } from '../lib/schemas';

interface Props {
  skills: Skills;
}
const { skills } = Astro.props;
---

<section class="skills section" id="competences" aria-labelledby="skills-title">
  <div class="wrap">
    <header class="sec-head">
      <h2 id="skills-title">Compétences</h2>
      <p class="label">{skills.groups.length} domaines</p>
    </header>
    <ul role="list" class="sk">
      {
        skills.groups.map((g, i) => (
          <li class="sk__g" data-reveal style={`--d:${i % 3}`}>
            <h3 class="sk__name serif">{g.name}</h3>
            {g.description && <p class="sk__desc muted">{g.description}</p>}
            <ul role="list" class="sk__items">
              {g.items.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sk {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--gap);
  }
  .sk__g {
    padding-block: 1.5rem 2rem;
    border-bottom: 1px solid var(--rule);
  }
  .sk__name {
    font-weight: 300;
    font-size: clamp(1.5rem, 1.1rem + 1vw, 2.1rem);
    letter-spacing: -0.02em;
  }
  .sk__desc {
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    max-width: 26em;
  }
  .sk__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.1rem;
  }
  .sk__items li {
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--rule-strong);
    border-radius: 99px;
    font-size: 0.8125rem;
  }
  @media (max-width: 63.99rem) {
    .sk {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 47.99rem) {
    .sk {
      grid-template-columns: 1fr;
    }
  }
</style>
