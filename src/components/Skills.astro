---
// Act 3 — expertise, second half: the skills, as panels of frosted glass over the scene, each edged with
// the colour of a thread. Any number of groups: the panels wrap.
import type { Skills } from '../lib/schemas';
import type { ResolvedSection } from '../lib/site';
import ThreadSvg from './ThreadSvg.astro';

interface Props {
  section: ResolvedSection;
  skills: Skills;
  threads: string[];
  glow: string;
}
const { section, skills, threads: colors, glow } = Astro.props;
---

<section class="skills" id="competences" aria-labelledby="skills-title" data-scene="warp" data-glow={glow} data-act={`${section.act} — ${section.actName}`}>
  <div class="wrap">
    <div class="skills__head">
      <div class="skills__loom" data-stage>
        <ThreadSvg kind="warp" colors={colors} />
      </div>
      <h2 id="skills-title" class="skills__title display">{section.title}</h2>
      {section.intro && <p class="muted">{section.intro}</p>}
    </div>
    <ul role="list" class="sk">
      {
        skills.groups.map((g, i) => (
          <li class="sk__g" data-reveal style={`--d:${i % 3};--c:${colors[i % colors.length]}`}>
            <p class="sk__n label" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="sk__name display">{g.name}</h3>
            {g.description && <p class="sk__desc muted">{g.description}</p>}
            <ul role="list" class="sk__items">
              {g.items.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .skills {
    padding-top: clamp(5rem, 12vh, 9rem);
  }
  .skills__head {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
  }
  .skills__loom {
    position: absolute;
    left: calc(var(--g) * -1);
    right: calc(var(--g) * -1);
    top: 50%;
    height: 7rem;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .skills__title {
    position: relative;
    font-size: clamp(2.6rem, 1rem + 4.6vw, 5.5rem);
    font-stretch: 78%;
    font-weight: 600;
  }
  .skills__head p {
    position: relative;
    max-width: 26em;
  }
  .sk {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--gap);
    margin-top: 2.5rem;
  }
  .sk__g {
    position: relative;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    border-radius: 14px;
    background: rgb(26 24 21 / 0.62);
    border: 1px solid var(--rule);
    backdrop-filter: blur(14px) saturate(1.15);
    -webkit-backdrop-filter: blur(14px) saturate(1.15);
    overflow: hidden;
    transition:
      transform var(--dur-2) var(--ease),
      border-color var(--dur-2);
  }
  .sk__g::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, var(--c), transparent 80%);
  }
  .sk__g:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--c) 50%, transparent);
  }
  .sk__n {
    color: color-mix(in srgb, var(--c) 62%, #fff); /* text: the dye, lightened to AA contrast */
  }
  .sk__name {
    margin-top: 0.75rem;
    font-size: clamp(1.5rem, 1.1rem + 1vw, 2.1rem);
    font-weight: 600;
    font-stretch: 82%;
  }
  .sk__desc {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
  }
  .sk__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1.1rem;
  }
  .sk__items li {
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--rule-strong);
    border-radius: 99px;
    font-size: 0.8125rem;
  }

</style>
