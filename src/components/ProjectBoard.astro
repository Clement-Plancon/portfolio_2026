---
// The project board: an information display where each project is a line.
// Names are set on split-flap cells (animated by src/scripts/site.ts, static without JS).
// The real name is in the DOM as text for screen readers; the flap cells are decorative.
import type { ProjectEntry } from '../lib/content';
import { formatPeriod } from '../lib/format';
import { lineCode, lineStyle } from '../lib/lines';
import LineBadge from './LineBadge.astro';

interface Props {
  projects: ProjectEntry[];
  id?: string;
  label?: string;
  headingLevel?: 'h2' | 'h3';
}
const { projects, id = 'board', label = 'Projets', headingLevel = 'h3' } = Astro.props;
const H = headingLevel;

const words = (s: string) => s.toUpperCase().split(/\s+/);
const when = (p: ProjectEntry) =>
  p.period?.start ? formatPeriod(p.period.start, p.period.end).replace(' — ', '–') : '—';
const first = projects[0];
---

<div class="board" id={id} data-board>
  <div class="board__head" aria-hidden="true">
    <span>Année</span><span>Ligne</span><span>{label}</span><span>Technologies</span><span>Type</span>
  </div>
  <ol role="list" class="board__rows">
    {
      projects.map((p) => (
        <li>
          <a
            class="row"
            href={`/projets/${p.id}/`}
            data-row
            data-code={lineCode(p)}
            data-summary={p.summary}
            style={lineStyle(p.cover.color)}
          >
            <span class="row__year">{when(p)}</span>
            <LineBadge project={p} size="md" transition />
            <H class="row__dest">
              <span class="visually-hidden">{p.title}</span>
              <span class="flaps" aria-hidden="true">
                {words(p.title).map((w) => (
                  <span class="flaps__word">
                    {[...w].map((c) => (
                      <span class="f">{c}</span>
                    ))}
                  </span>
                ))}
              </span>
            </H>
            <span class="row__via">{p.technologies.slice(0, 3).join(' · ')}</span>
            <span class:list={['row__type', { 'is-live': p.status === 'en-cours' }]}>
              {p.status === 'en-cours' ? 'En cours' : p.category === 'pro' ? 'Pro' : 'Perso'}
            </span>
            <span class="row__summary">{p.summary}</span>
            <span class="row__go" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))
    }
  </ol>
  {
    first && (
      <p class="board__strip" aria-hidden="true" data-strip style={lineStyle(first.cover.color)}>
        <span class="strip__code" data-strip-code>
          {lineCode(first)}
        </span>
        <span class="strip__text" data-strip-text>
          {first.summary}
        </span>
      </p>
    )
  }
</div>

<style>
  .board {
    --cols: 5.5rem 3rem minmax(0, 1fr) minmax(0, 15rem) 5.5rem 2rem;
  }
  .board__head {
    display: grid;
    grid-template-columns: var(--cols);
    gap: 1.25rem;
    padding-bottom: 0.75rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-panel-2);
  }
  .board__rows {
    border-top: 2px solid var(--panel-line);
  }
  .board__rows li {
    border-bottom: 1px solid var(--panel-line);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: var(--cols);
    gap: 1.25rem;
    align-items: center;
    padding-block: 0.9rem;
    color: var(--on-panel);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .row::before {
    /* hover band, drawn in the line colour at the left edge */
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--pad));
    background: var(--panel-2);
    border-left: 6px solid var(--line);
    opacity: 0;
    transition: opacity var(--dur-1) ease;
    z-index: 0;
  }
  .row > * {
    position: relative;
    z-index: 1;
  }
  .row:hover::before,
  .row:focus-visible::before,
  .row.is-active::before {
    opacity: 1;
  }
  .row:focus-visible {
    outline-offset: -3px;
    box-shadow: none;
  }
  .row__year,
  .row__via,
  .row__type {
    font-family: var(--mono);
    font-size: 0.9375rem;
  }
  .row__via {
    color: var(--on-panel-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row__type {
    color: var(--on-panel-2);
  }
  .row__type.is-live {
    color: var(--signal);
  }
  .row__dest {
    font-family: var(--mono);
    font-weight: 600;
    font-size: clamp(1.05rem, 0.75rem + 1vw, 1.6rem);
    letter-spacing: 0;
    line-height: 1.25;
  }
  .flaps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em 0.55em;
  }
  .flaps__word {
    display: inline-flex;
    gap: 2px;
    white-space: nowrap;
  }
  /* A split-flap cell: dark tile with the hinge line across the middle. */
  .f {
    position: relative;
    display: inline-block;
    width: 0.78em;
    padding-block: 0.12em 0.06em;
    text-align: center;
    background: var(--panel-2);
    border-radius: 2px;
    transition: color var(--dur-1) ease;
  }
  .f::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: var(--panel);
  }
  .row:hover .f,
  .row:focus-visible .f,
  .row.is-active .f {
    color: var(--signal);
  }
  .row__go {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 3px;
    background: var(--panel-2);
    color: var(--signal);
    font-weight: 900;
    transition: transform var(--dur-2) var(--ease);
  }
  .row:hover .row__go,
  .row:focus-visible .row__go {
    transform: translateX(4px);
  }
  .row__summary {
    display: none;
  }

  .board__strip {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4rem;
    margin-top: 1.25rem;
    padding: 0.75rem 1rem;
    background: var(--panel-2);
    border-radius: var(--radius);
    color: var(--on-panel);
    font-size: var(--step-0);
    line-height: 1.4;
  }
  .strip__code {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    padding-top: 0.1em;
    border-radius: 4px;
    background: var(--line);
    color: var(--line-text);
    font-weight: 900;
    font-size: 0.875rem;
  }

  /* Touch screens and narrow windows: no hover, so each line carries its own summary. */
  @media (hover: none), (max-width: 63.99rem) {
    .board__strip {
      display: none;
    }
  }
  @media (max-width: 63.99rem) {
    .board__head {
      display: none;
    }
    .row {
      grid-template-columns: 3rem minmax(0, 1fr) 2rem;
      grid-template-areas:
        'badge dest go'
        'badge meta go'
        'badge sum go';
      gap: 0.3rem 1rem;
      align-items: start;
      padding-block: 1.1rem;
    }
    .row > :global(.badge) {
      grid-area: badge;
    }
    .row__dest {
      grid-area: dest;
    }
    .row__year {
      grid-area: meta;
      font-size: 0.8125rem;
      color: var(--on-panel-2);
    }
    .row__type {
      grid-area: meta;
      justify-self: end;
      font-size: 0.8125rem;
    }
    .row__via {
      display: none;
    }
    .row__summary {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      grid-area: sum;
      font-size: 0.9375rem;
      line-height: 1.45;
      color: var(--on-panel-2);
    }
    .row__go {
      grid-area: go;
      align-self: center;
    }
  }
  @media (max-width: 26rem) {
    .row {
      grid-template-columns: 2.6rem minmax(0, 1fr) 1.6rem;
      gap: 0.3rem 0.75rem;
    }
    .row > :global(.badge) {
      width: 2.6rem;
      height: 2.6rem;
      font-size: 1.05rem;
    }
    .row__dest {
      font-size: 1rem;
    }
    .f {
      width: 0.74em;
    }
    .row__go {
      width: 1.6rem;
      height: 1.6rem;
    }
  }
</style>
