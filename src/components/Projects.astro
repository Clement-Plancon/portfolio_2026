---
// Projects: a table of contents set in large serif, one line per project. A line opens the
// project's article over the page (a modal dialog), with its plate (the drawing of its stack), the
// real captures when there are some, and every detail from the content.
// Without JavaScript the articles are simply printed under their line; every address #projet-x works.
import Arrow from './Arrow.astro';
import Plate from './Plate.astro';
import type { ProjectEntry } from '../lib/content';
import { paragraphs } from '../lib/content';
import { formatPeriod } from '../lib/format';
import type { MediaResolver } from '../lib/media';
import { tintStyle } from '../lib/tints';

interface Props {
  projects: ProjectEntry[];
  media: MediaResolver;
}
const { projects, media } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const total = pad(projects.length);
const period = (p: ProjectEntry) => formatPeriod(p.period?.start, p.period?.end, p.status === 'en-cours') || (p.status === 'en-cours' ? 'En cours' : '');
const shortKind = (p: ProjectEntry) => p.kind?.split('·')[0]?.trim();
---

<section class="projects section" id="projets" aria-labelledby="projects-title">
  <div class="wrap">
    <header class="sec-head">
      <h2 id="projects-title">Projets</h2>
      <p class="label">{projects.length} réalisations — {projects.filter((p) => p.category === 'pro').length} professionnelles</p>
    </header>

    <ol role="list" class="toc" data-toc>
      {
        projects.map((p, i) => {
          const cover = p.cover.image ? media(p.cover.image.src) : undefined;
          const gallery = p.gallery.map((g) => ({ ...g, file: media(g.src) })).filter((g) => g.file);
          const prev = projects[(i - 1 + projects.length) % projects.length];
          const next = projects[(i + 1) % projects.length];
          const when = period(p);
          const sections = [
            { title: 'Contexte', body: paragraphs(p.context) },
            { title: 'Problème', body: paragraphs(p.problem) },
            { title: 'Mon rôle', body: paragraphs(p.role) },
            { title: 'Approche', body: paragraphs(p.approach) },
          ].filter((s) => s.body.length);
          return (
            <li class:list={['pj tinted', { 'pj--lead': p.featured }]} id={`projet-${p.id}`} style={tintStyle(p.cover.color)} data-project data-reveal>
              <div class="pj__row">
                <span class="pj__n label" aria-hidden="true">{pad(i + 1)}</span>
                <h3 class="pj__t display">
                  <a class="pj__open" href={`#projet-${p.id}`} aria-controls={`detail-${p.id}`} data-open>
                    {p.title}
                  </a>
                </h3>
                <p class="pj__meta">
                  {shortKind(p) && <span>{shortKind(p)}</span>}
                  <span class="muted">{[p.category === 'pro' ? p.organisation : 'Projet personnel', when].filter(Boolean).join(' · ')}</span>
                </p>
              </div>

              <dialog class="feat" id={`detail-${p.id}`} aria-labelledby={`detail-${p.id}-title`} data-detail>
                <div class="feat__bar">
                  <p class="label">
                    {pad(i + 1)} / {total}
                  </p>
                  <div class="feat__nav">
                    <a class="feat__btn" href={`#projet-${prev.id}`} data-go aria-label={`Projet précédent : ${prev.title}`}>
                      <Arrow dir="left" />
                      <span class="feat__btn-t">Précédent</span>
                    </a>
                    <a class="feat__btn" href={`#projet-${next.id}`} data-go aria-label={`Projet suivant : ${next.title}`}>
                      <span class="feat__btn-t">Suivant</span>
                      <Arrow />
                    </a>
                    <button class="feat__btn feat__close" type="button" data-close>
                      Fermer
                    </button>
                  </div>
                </div>

                <article class="feat__in wrap">
                  <header class="feat__head">
                    <p class="label">{p.kind ?? (p.category === 'pro' ? 'Projet professionnel' : 'Projet personnel')}</p>
                    <p class="feat__title display" id={`detail-${p.id}-title`}>
                      {p.title}
                    </p>
                  </header>
                  <p class:list={['feat__stand', { 'feat__stand--side': !cover }]}>{p.summary}</p>

                  {cover && p.cover.image ? (
                    <figure class="feat__shot">
                      <div class="feat__frame">
                        <img src={cover.src} alt={p.cover.image.alt} width={cover.width} height={cover.height} loading="lazy" decoding="async" />
                      </div>
                      <figcaption class="label">Capture réelle{p.cover.image.caption ? ` — ${p.cover.image.caption}` : ''}</figcaption>
                    </figure>
                  ) : (
                    <figure class="feat__plate">
                      <Plate project={p} />
                      <figcaption class="label">Planche — les technologies du projet, par couches</figcaption>
                    </figure>
                  )}

                  <div class="feat__body">
                    <div class="feat__text">
                      {sections.map((s) => (
                        <section class="feat__sec">
                          <h4 class="label">{s.title}</h4>
                          {s.body.map((t) => (
                            <p>{t}</p>
                          ))}
                        </section>
                      ))}
                      {p.contributions.length > 0 && (
                        <section class="feat__sec">
                          <h4 class="label">{p.category === 'pro' ? 'Contributions' : 'Fonctionnalités'}</h4>
                          <ol role="list" class="feat__list">
                            {p.contributions.map((c) => (
                              <li>{c}</li>
                            ))}
                          </ol>
                        </section>
                      )}
                      {p.results.length > 0 && (
                        <section class="feat__sec">
                          <h4 class="label">Résultats</h4>
                          <ul role="list" class="feat__list feat__list--plain">
                            {p.results.map((r) => (
                              <li>{r}</li>
                            ))}
                          </ul>
                        </section>
                      )}
                    </div>

                    <aside class="feat__facts" aria-label="Fiche du projet">
                      <dl>
                        {p.organisation && (
                          <div>
                            <dt class="label">Cadre</dt>
                            <dd>{p.organisation}</dd>
                          </div>
                        )}
                        {when && (
                          <div>
                            <dt class="label">Période</dt>
                            <dd>{when}</dd>
                          </div>
                        )}
                        {p.status && (
                          <div>
                            <dt class="label">État</dt>
                            <dd>{p.status === 'en-cours' ? 'En cours de développement' : 'Terminé'}</dd>
                          </div>
                        )}
                        {p.technologies.length > 0 && (
                          <div>
                            <dt class="label">Technologies</dt>
                            <dd>{p.technologies.join(', ')}</dd>
                          </div>
                        )}
                        {p.links.length > 0 && (
                          <div>
                            <dt class="label">Liens</dt>
                            <dd>
                              <ul role="list">
                                {p.links.map((l) => (
                                  <li>
                                    <a class="link feat__ext" href={l.url} rel="noopener">
                                      {l.label}
                                      <Arrow dir="out" />
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            </dd>
                          </div>
                        )}
                      </dl>
                      {cover && <Plate project={p} image={cover} class="feat__mini" />}
                    </aside>
                  </div>

                  {gallery.length > 0 && (
                    <div class="feat__gallery">
                      {gallery.map((g) => (
                        <figure>
                          <img src={g.file!.src} alt={g.alt} width={g.file!.width} height={g.file!.height} loading="lazy" decoding="async" />
                          {g.caption && <figcaption class="label">{g.caption}</figcaption>}
                        </figure>
                      ))}
                    </div>
                  )}

                  <a class="feat__next" href={`#projet-${next.id}`} data-go>
                    <span class="label">Projet suivant</span>
                    <span class="feat__next-t display">
                      {next.title} <Arrow />
                    </span>
                  </a>
                </article>
              </dialog>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  /* The index follows the introduction closely: its first lines show on the first screen. */
  .projects.section {
    padding-top: clamp(1.5rem, 4vh, 3rem);
  }

  /* ---------- The table of contents ---------- */
  .toc {
    counter-reset: pj;
  }
  .pj {
    border-bottom: 1px solid var(--rule);
  }
  .pj__row {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) minmax(12rem, 22rem);
    align-items: center;
    column-gap: var(--gap);
    padding-block: clamp(0.9rem, 0.5rem + 1.2vw, 1.75rem);
  }
  .pj__n {
    color: var(--tint);
  }
  .pj__t {
    font-size: clamp(2.1rem, 0.9rem + 3.6vw, 4.6rem);
    transition:
      color var(--dur-2) var(--ease),
      transform var(--dur-3) var(--ease);
  }
  .pj--lead .pj__t {
    font-size: clamp(2.5rem, 0.9rem + 5.4vw, 7.25rem);
  }
  .pj__open {
    text-decoration: none;
    outline: none;
  }
  /* The whole line is the link. */
  .pj__open::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .pj__open:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .pj__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  @media (hover: hover) and (pointer: fine) {
    .toc:has(.pj__row:hover) .pj__t {
      color: var(--dim);
    }
    .toc .pj__row:hover .pj__t {
      color: var(--fg);
      font-style: italic;
      transform: translateX(0.12em);
    }
  }

  /* ---------- The article (dialog) ---------- */
  .feat {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--fg);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  /* No veil: the article grows out of its line over the page, which stays visible until covered. */
  .feat::backdrop {
    background: transparent;
  }
  /* Without JavaScript the article is printed under its line. */
  :global(html:not(.js)) .feat {
    position: static;
    display: block;
    height: auto;
    overflow: visible;
    background: none;
    padding-bottom: 3rem;
  }
  :global(html:not(.js)) .feat__bar,
  :global(html:not(.js)) .feat__next,
  :global(html:not(.js)) .feat__title {
    display: none;
  }
  :global(html:not(.js)) .feat__in {
    padding: 0;
  }

  .feat__bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: var(--header-h);
    padding-inline: var(--g);
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--rule);
  }
  .feat__nav {
    display: flex;
    gap: 0.5rem;
  }
  .feat__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--rule-strong);
    border-radius: 99px;
    font-size: 0.875rem;
    text-decoration: none;
    transition:
      background var(--dur-1),
      color var(--dur-1),
      border-color var(--dur-1);
  }
  .feat__btn:hover {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .feat__in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    padding-top: clamp(2.5rem, 7vh, 6rem);
    padding-bottom: clamp(3rem, 8vh, 6rem);
  }
  .feat__head {
    grid-column: 1 / -1;
  }
  .feat__stand {
    grid-column: 1 / span 8;
  }
  .feat__title {
    margin-top: 1rem;
    font-size: clamp(3rem, 0.8rem + 8vw, 10rem);
    letter-spacing: -0.04em;
  }
  .feat__stand {
    max-width: 30em;
    margin-top: clamp(1.5rem, 3vh, 2.5rem);
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.3rem, 1rem + 1vw, 2rem);
    line-height: 1.28;
    letter-spacing: -0.01em;
  }
  .feat__shot,
  .feat__plate {
    grid-column: 1 / -1;
    margin-top: clamp(2.5rem, 6vh, 4.5rem);
  }
  .feat__plate :global(.plate) {
    aspect-ratio: 16 / 11;
    background: var(--bg-2);
  }
  /* Without a capture, the summary and the plate share the first screen. */
  .feat__stand--side {
    grid-column: 1 / span 5;
    align-self: start;
  }
  .feat__stand--side + .feat__plate {
    grid-column: 6 / -1;
    margin-top: clamp(1.5rem, 3vh, 2.5rem);
  }
  .feat__frame {
    background: var(--bg-2);
    padding: clamp(0.75rem, 3vw, 3.5rem);
    display: grid;
    place-items: center;
  }
  .feat__frame img {
    width: 100%;
    max-width: 72rem;
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.5);
  }
  figcaption.label {
    margin-top: 0.75rem;
  }
  .feat__body {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    margin-top: clamp(2.5rem, 6vh, 4.5rem);
    row-gap: 2.5rem;
  }
  .feat__text {
    grid-column: 1 / span 7;
  }
  .feat__sec + .feat__sec {
    margin-top: 2.5rem;
  }
  .feat__sec h4 {
    margin-bottom: 0.9rem;
  }
  .feat__sec p {
    max-width: 34em;
    font-family: var(--serif);
    font-size: clamp(1.1rem, 1rem + 0.3vw, 1.3rem);
    line-height: 1.55;
  }
  .feat__sec p + p {
    margin-top: 1em;
  }
  .feat__list {
    counter-reset: c;
    border-top: 1px solid var(--rule);
  }
  .feat__list li {
    counter-increment: c;
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--rule);
  }
  .feat__list li::before {
    content: counter(c, decimal-leading-zero);
    font-family: var(--serif);
    font-style: italic;
    color: var(--tint);
  }
  .feat__list--plain li::before {
    content: '—';
    font-style: normal;
  }
  .feat__facts {
    grid-column: 9 / span 4;
  }
  .feat__facts dl > div {
    padding-block: 0.8rem;
    border-top: 1px solid var(--rule);
  }
  .feat__facts dd {
    margin-top: 0.3rem;
  }
  .feat__ext {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .feat__facts :global(.feat__mini) {
    margin-top: 1.5rem;
    background: var(--bg-2);
  }
  .feat__gallery {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--gap);
    margin-top: 4rem;
  }
  .feat__gallery img {
    width: 100%;
    background: var(--bg-2);
  }
  .feat__next {
    grid-column: 1 / -1;
    display: block;
    margin-top: clamp(4rem, 10vh, 8rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule-strong);
    text-decoration: none;
  }
  .feat__next-t {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
    font-size: clamp(2.2rem, 1rem + 4.4vw, 5.5rem);
    transition: font-style 0s;
  }
  .feat__next:hover .feat__next-t {
    font-style: italic;
  }
  .feat__next .arrow {
    width: 0.5em;
    height: 0.5em;
  }

  /* Opening: the article rises into place (the clip from the line is set by the script). */
  :global(.motion) .feat[open] .feat__in > * {
    animation: feat-in 1s var(--ease) both;
    animation-delay: calc(180ms + var(--k, 0) * 70ms);
  }
  .feat__head {
    --k: 0;
  }
  .feat__stand {
    --k: 1;
  }
  .feat__shot,
  .feat__plate {
    --k: 2;
  }
  .feat__body {
    --k: 3;
  }
  @keyframes feat-in {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }
  }

  @media (max-width: 63.99rem) {
    .pj__row {
      grid-template-columns: 2.75rem minmax(0, 1fr);
    }
    .pj__meta {
      grid-column: 2;
      align-items: flex-start;
      text-align: left;
      margin-top: 0.4rem;
    }
    .feat__text,
    .feat__facts,
    .feat__stand,
    .feat__stand--side,
    .feat__stand--side + .feat__plate {
      grid-column: 1 / -1;
    }
    .feat__plate :global(.plate) {
      aspect-ratio: 16 / 10;
    }
    .feat__facts {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--gap);
      align-items: start;
    }
    .feat__facts :global(.feat__mini) {
      margin-top: 0;
    }
  }
  @media (max-width: 47.99rem) {
    .pj__row {
      grid-template-columns: 2rem minmax(0, 1fr);
      align-items: baseline;
    }
    .pj__t,
    .pj--lead .pj__t {
      font-size: clamp(2rem, 1rem + 5.6vw, 2.6rem);
      line-height: 1;
    }
    .pj--lead .pj__t {
      font-size: clamp(2.3rem, 1rem + 7.4vw, 3.1rem);
    }
    .pj__meta {
      font-size: 0.8125rem;
    }
    /* The article's controls sit at the bottom of the screen, under the thumb. */
    .feat__bar {
      position: fixed;
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      border-bottom: 0;
      border-top: 1px solid var(--rule);
      padding-bottom: env(safe-area-inset-bottom);
      min-height: 4rem;
    }
    .feat__btn {
      min-height: 2.75rem;
      min-width: 2.75rem;
      justify-content: center;
      padding: 0 0.9rem;
    }
    .feat__btn-t {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .feat__in {
      padding-top: 2rem;
      padding-bottom: 7rem;
    }
    .feat__plate :global(.plate) {
      aspect-ratio: 1 / 0.92;
    }
    .feat__facts {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pj__t {
      transition: none;
    }
  }
</style>
