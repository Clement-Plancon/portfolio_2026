---
// Act 2 — the projects. One scene per project: its thread, in its tint, drawn into its motif (an
// abstract sign of its domain, labelled as such), its real captures when there are some, and what it
// is. Each scene opens the project's article over the page (a modal dialog with every detail).
// Without JavaScript the articles are printed under their scene; every address #projet-x works.
import Arrow from './Arrow.astro';
import ThreadSvg from './ThreadSvg.astro';
import type { ProjectEntry } from '../lib/content';
import { paragraphs } from '../lib/content';
import { formatPeriod } from '../lib/format';
import type { MediaResolver } from '../lib/media';
import { MOTIF_LABELS, motifOf } from '../lib/threads';
import { TINTS, tintStyle } from '../lib/tints';

interface Props {
  projects: ProjectEntry[];
  media: MediaResolver;
}
const { projects, media } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const total = pad(projects.length);
const colors = projects.map((p) => TINTS[p.cover.color].thread);
const period = (p: ProjectEntry) => formatPeriod(p.period?.start, p.period?.end, p.status === 'en-cours') || (p.status === 'en-cours' ? 'En cours' : '');
// The light of a project's scene: its tint, deepened.
const glow = (hex: string) => {
  const n = Number.parseInt(hex.slice(1), 16);
  const c = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((v) => Math.round(v * 0.42));
  return `#${c.map((v) => v.toString(16).padStart(2, '0')).join('')}`;
};
---

<section class="projects" id="projets" aria-labelledby="projects-title">
  <header class="projects__head wrap">
    <p class="act label"><span><span class="act__n">02</span> Exploration</span></p>
    <div class="projects__intro">
      <h2 id="projects-title" class="projects__title display">Projets</h2>
      <p class="projects__lede">
        Six réalisations, du ministère à l'application personnelle. Chacune tire son fil : faites défiler pour les parcourir, ou ouvrez-en une directement.
      </p>
    </div>
    <ol role="list" class="projects__index">
      {
        projects.map((p, i) => (
          <li class="tinted" style={tintStyle(p.cover.color)}>
            <a href={`#projet-${p.id}`} data-jump={p.id}>
              <span class="label">{pad(i + 1)}</span>
              {p.title}
            </a>
          </li>
        ))
      }
    </ol>
  </header>

  <nav class="rail" aria-label="Projets" data-rail>
    <ol role="list">
      {
        projects.map((p, i) => (
          <li class="tinted" style={tintStyle(p.cover.color)}>
            <a href={`#projet-${p.id}`} data-jump={p.id}>
              <span class="rail__dot" aria-hidden="true" />
              <span class="rail__name">{p.title}</span>
              <span class="visually-hidden">, projet {i + 1} sur {projects.length}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  {
    projects.map((p, i) => {
      const cover = p.cover.image ? media(p.cover.image.src) : undefined;
      const gallery = p.gallery.map((g) => ({ ...g, file: media(g.src) })).filter((g) => g.file);
      const prev = projects[(i - 1 + projects.length) % projects.length];
      const next = projects[(i + 1) % projects.length];
      const when = period(p);
      const m = motifOf(p.id, p.cover.motif);
      const tint = TINTS[p.cover.color].thread;
      const sections = [
        { title: 'Contexte', body: paragraphs(p.context) },
        { title: 'Problème', body: paragraphs(p.problem) },
        { title: 'Mon rôle', body: paragraphs(p.role) },
        { title: 'Approche', body: paragraphs(p.approach) },
      ].filter((s) => s.body.length);
      return (
        <article
          class:list={['slide tinted', i % 2 ? 'slide--right' : 'slide--left', { 'slide--media': cover }]}
          id={`projet-${p.id}`}
          style={tintStyle(p.cover.color)}
          aria-labelledby={`slide-${p.id}`}
          data-project
          data-scene="project"
          data-strand={i}
          data-motif={m}
          data-thread={tint}
          data-glow={glow(tint)}
        >
          <div class="slide__in wrap">
            <div class="slide__text" data-origin>
              <p class="slide__no label">
                <span class="slide__n">{pad(i + 1)}</span> / {total}
                <span class="slide__cat">{p.category === 'pro' ? 'Professionnel' : 'Personnel'}</span>
              </p>
              <h3 class="slide__title display" id={`slide-${p.id}`}>
                <a href={`#projet-${p.id}`} aria-controls={`detail-${p.id}`} data-open>
                  {p.title}
                </a>
              </h3>
              {p.kind && <p class="slide__kind">{p.kind}</p>}
              <p class="slide__sum">{p.summary}</p>
              <p class="slide__meta label">{[p.category === 'pro' ? p.organisation : 'Projet personnel', when].filter(Boolean).join(' — ')}</p>
              {p.technologies.length > 0 && (
                <ul role="list" class="chips" aria-label="Technologies">
                  {p.technologies.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              )}
              <div class="slide__cta">
                <a class="btn btn--fill" href={`#projet-${p.id}`} aria-controls={`detail-${p.id}`} data-open>
                  Ouvrir le projet<span class="visually-hidden"> {p.title}</span> <Arrow />
                </a>
                {p.links[0] && (
                  <a class="btn" href={p.links[0].url} rel="noopener">
                    {p.links[0].label} <Arrow dir="out" />
                  </a>
                )}
              </div>
            </div>

            <div class="slide__stage" data-stage>
              <ThreadSvg kind="project" colors={colors} strand={i} motif={m} id={`motif-${p.id}`} />
              {cover && p.cover.image && (
                <figure class="slide__shot">
                  <img src={cover.src} alt={p.cover.image.alt} width={cover.width} height={cover.height} loading="lazy" decoding="async" />
                  <figcaption class="label">Capture réelle</figcaption>
                </figure>
              )}
              <p class="slide__motif label" aria-hidden="true">
                Motif — {MOTIF_LABELS[m].split(' — ')[1]}
              </p>
            </div>
          </div>

          <dialog class="feat" id={`detail-${p.id}`} aria-labelledby={`detail-${p.id}-title`} data-detail>
            <div class="feat__bar">
              <p class="label">
                <span class="slide__n">{pad(i + 1)}</span> / {total}
              </p>
              <div class="feat__nav">
                <a class="feat__btn" href={`#projet-${prev.id}`} data-go aria-label={`Projet précédent : ${prev.title}`}>
                  <Arrow dir="left" />
                  <span class="feat__btn-t">Précédent</span>
                </a>
                <a class="feat__btn" href={`#projet-${next.id}`} data-go aria-label={`Projet suivant : ${next.title}`}>
                  <span class="feat__btn-t">Suivant</span>
                  <Arrow />
                </a>
                <button class="feat__btn feat__close" type="button" data-close>
                  Fermer
                </button>
              </div>
            </div>

            <article class="feat__in wrap">
              <header class="feat__head">
                <div class="feat__headtext">
                  <p class="label">{p.kind ?? (p.category === 'pro' ? 'Projet professionnel' : 'Projet personnel')}</p>
                  <p class="feat__title display" id={`detail-${p.id}-title`}>
                    {p.title}
                  </p>
                  <p class="feat__stand">{p.summary}</p>
                </div>
                <figure class="feat__motif" aria-hidden="true">
                  <svg class="feat__svg" viewBox="-1 -1 2 2" fill="none" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                    <use href={`#motif-${p.id}`} />
                  </svg>
                </figure>
              </header>

              {cover && p.cover.image && (
                <figure class="feat__shot">
                  <div class="feat__frame">
                    <img src={cover.src} alt={p.cover.image.alt} width={cover.width} height={cover.height} loading="lazy" decoding="async" />
                  </div>
                  <figcaption class="label">Capture réelle{p.cover.image.caption ? ` — ${p.cover.image.caption}` : ''}</figcaption>
                </figure>
              )}

              <div class="feat__body">
                <div class="feat__text">
                  {sections.map((s) => (
                    <section class="feat__sec">
                      <h4 class="label">{s.title}</h4>
                      {s.body.map((t) => (
                        <p>{t}</p>
                      ))}
                    </section>
                  ))}
                  {p.contributions.length > 0 && (
                    <section class="feat__sec">
                      <h4 class="label">{p.category === 'pro' ? 'Contributions' : 'Fonctionnalités'}</h4>
                      <ol role="list" class="feat__list">
                        {p.contributions.map((c) => (
                          <li>{c}</li>
                        ))}
                      </ol>
                    </section>
                  )}
                  {p.results.length > 0 && (
                    <section class="feat__sec">
                      <h4 class="label">Résultats</h4>
                      <ul role="list" class="feat__list feat__list--plain">
                        {p.results.map((r) => (
                          <li>{r}</li>
                        ))}
                      </ul>
                    </section>
                  )}
                </div>

                <aside class="feat__facts" aria-label="Fiche du projet">
                  <dl>
                    {p.organisation && (
                      <div>
                        <dt class="label">Cadre</dt>
                        <dd>{p.organisation}</dd>
                      </div>
                    )}
                    {when && (
                      <div>
                        <dt class="label">Période</dt>
                        <dd>{when}</dd>
                      </div>
                    )}
                    {p.status && (
                      <div>
                        <dt class="label">État</dt>
                        <dd>{p.status === 'en-cours' ? 'En cours de développement' : 'Terminé'}</dd>
                      </div>
                    )}
                    {p.technologies.length > 0 && (
                      <div>
                        <dt class="label">Technologies</dt>
                        <dd>
                          <ul role="list" class="chips">
                            {p.technologies.map((t) => (
                              <li>{t}</li>
                            ))}
                          </ul>
                        </dd>
                      </div>
                    )}
                    {p.links.length > 0 && (
                      <div>
                        <dt class="label">Liens</dt>
                        <dd>
                          <ul role="list">
                            {p.links.map((l) => (
                              <li>
                                <a class="link feat__ext" href={l.url} rel="noopener">
                                  {l.label}
                                  <Arrow dir="out" />
                                </a>
                              </li>
                            ))}
                          </ul>
                        </dd>
                      </div>
                    )}
                  </dl>
                  <p class="feat__note label">Le motif est une illustration du domaine du projet, pas une capture.</p>
                </aside>
              </div>

              {gallery.length > 0 && (
                <div class="feat__gallery">
                  {gallery.map((g) => (
                    <figure>
                      <img src={g.file!.src} alt={g.alt} width={g.file!.width} height={g.file!.height} loading="lazy" decoding="async" />
                      {g.caption && <figcaption class="label">{g.caption}</figcaption>}
                    </figure>
                  ))}
                </div>
              )}

              <a class="feat__next tinted" href={`#projet-${next.id}`} data-go style={tintStyle(next.cover.color)}>
                <span class="label">Projet suivant</span>
                <span class="feat__next-t display">
                  {next.title} <Arrow />
                </span>
              </a>
            </article>
          </dialog>
        </article>
      );
    })
  }
</section>

<style>
  /* ---------- Opening of the act ---------- */
  .projects__head {
    padding-top: clamp(6rem, 14vh, 10rem);
    padding-bottom: clamp(2rem, 6vh, 4rem);
  }
  .projects__intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: end;
    margin-top: 2rem;
  }
  .projects__title {
    grid-column: 1 / span 6;
    font-size: clamp(4rem, 1rem + 11vw, 13rem);
    font-stretch: 75%;
    font-weight: 650;
    line-height: 0.8;
  }
  .projects__lede {
    grid-column: 8 / -1;
    color: var(--fg-2);
    max-width: 30em;
    font-size: 1.0625rem;
  }
  .projects__index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }
  .projects__index a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0 1rem 0 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 99px;
    font-size: 0.9rem;
    text-decoration: none;
    background: rgb(15 14 13 / 0.55);
    backdrop-filter: blur(8px);
    transition:
      border-color var(--dur-1),
      color var(--dur-1);
  }
  .projects__index a:hover {
    border-color: var(--tint);
  }
  .projects__index .label {
    color: var(--tint);
  }

  /* ---------- One scene per project ---------- */
  .slide {
    position: relative;
  }
  .slide__in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: center;
    min-height: 100svh;
    padding-block: clamp(4rem, 10vh, 7rem);
  }
  .slide__text {
    grid-column: 1 / span 5;
    grid-row: 1;
    position: relative;
    z-index: 1;
  }
  .slide__stage {
    position: relative;
    grid-column: 6 / -1;
    grid-row: 1;
    aspect-ratio: 1;
    width: min(100%, 78svh);
    justify-self: center;
  }
  .slide--right .slide__text {
    grid-column: 8 / -1;
  }
  .slide--right .slide__stage {
    grid-column: 1 / span 7;
  }
  .slide__no {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .slide__n {
    color: var(--tint);
  }
  .slide__cat {
    margin-left: 0.75rem;
    padding-left: 0.75rem;
    border-left: 1px solid var(--rule-strong);
  }
  .slide__title {
    margin-top: 1.25rem;
    font-size: clamp(3rem, 0.8rem + 5.6vw, 7.5rem);
    font-stretch: 76%;
    font-weight: 650;
    line-height: 0.86;
    letter-spacing: -0.035em;
  }
  .slide__title a {
    text-decoration: none;
    background: linear-gradient(var(--tint), var(--tint)) 0 100% / 0 0.06em no-repeat;
    transition: background-size var(--dur-3) var(--ease);
  }
  .slide__title a:hover {
    background-size: 100% 0.06em;
  }
  .slide__kind {
    margin-top: 1.1rem;
    color: var(--tint);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .slide__sum {
    margin-top: 0.9rem;
    max-width: 32em;
    font-size: clamp(1.02rem, 0.95rem + 0.25vw, 1.2rem);
    line-height: 1.5;
  }
  .slide__meta {
    margin-top: 1.25rem;
  }
  .slide__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .slide__motif {
    position: absolute;
    right: 0;
    bottom: -0.5rem;
    color: var(--fg-3);
  }
  /* A real capture: a large framed screen in front of the thread. */
  .slide__shot {
    position: absolute;
    left: -6%;
    right: 30%;
    top: 4%;
    transform: perspective(1400px) rotateY(-8deg) rotateX(3deg);
    transform-origin: 30% 50%;
    transition: transform 1.2s var(--ease);
  }
  .slide--right .slide__shot {
    left: -6%;
    right: 30%;
    transform: perspective(1400px) rotateY(8deg) rotateX(3deg);
  }
  .slide__shot img {
    width: 100%;
    border-radius: 6px;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 40px 90px -30px rgb(0 0 0 / 0.85),
      0 0 120px -40px var(--tint);
  }
  .slide__shot figcaption {
    margin-top: 0.75rem;
  }
  .slide__stage:hover .slide__shot {
    transform: perspective(1400px) rotateY(-3deg) rotateX(1deg) translateY(-0.5rem);
  }

  /* ---------- Rail: where am I among the projects (desktop) ---------- */
  .rail {
    position: fixed;
    right: max(1rem, calc(var(--g) * 0.5));
    top: 50%;
    z-index: 20;
    transform: translateY(-50%);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-2),
      visibility 0s var(--dur-2);
  }
  :global(.in-gallery) .rail {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--dur-2);
  }
  .rail ol {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .rail a {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    min-height: 2rem;
    text-decoration: none;
    font-size: 0.8rem;
    color: var(--fg-2);
  }
  .rail__name {
    opacity: 0;
    transform: translateX(0.5rem);
    transition:
      opacity var(--dur-2) var(--ease),
      transform var(--dur-2) var(--ease);
    white-space: nowrap;
  }
  .rail:hover .rail__name,
  .rail a:focus-visible .rail__name {
    opacity: 1;
    transform: none;
  }
  .rail a[aria-current='true'] {
    color: var(--fg);
  }
  .rail__dot {
    order: 2;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: 1px solid var(--tint);
    transition:
      transform var(--dur-2) var(--ease),
      background var(--dur-2);
  }
  .rail a[aria-current='true'] .rail__dot {
    background: var(--tint);
    transform: scale(1.5);
  }

  /* ---------- The article (dialog) ---------- */
  .feat {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--fg);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .feat::backdrop {
    background: transparent;
  }
  :global(html:not(.js)) .feat {
    position: static;
    display: block;
    height: auto;
    overflow: visible;
    background: none;
    padding-bottom: 4rem;
  }
  :global(html:not(.js)) .feat__bar,
  :global(html:not(.js)) .feat__next,
  :global(html:not(.js)) .feat__head {
    display: none;
  }
  .feat__bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: var(--header-h);
    padding-inline: var(--g);
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--rule);
  }
  .feat__nav {
    display: flex;
    gap: 0.5rem;
  }
  .feat__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border: 1px solid var(--rule-strong);
    border-radius: 99px;
    font-size: 0.875rem;
    text-decoration: none;
    transition:
      background var(--dur-1),
      color var(--dur-1),
      border-color var(--dur-1);
  }
  .feat__btn:hover {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .feat__in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    padding-top: clamp(2rem, 6vh, 5rem);
    padding-bottom: clamp(3rem, 8vh, 6rem);
  }
  .feat__head {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: center;
    background:
      radial-gradient(60% 80% at 75% 50%, color-mix(in srgb, var(--tint) 16%, transparent), transparent 70%),
      var(--bg-2);
    border-radius: 8px;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    overflow: hidden;
  }
  .feat__headtext {
    grid-column: 1 / span 7;
  }
  .feat__title {
    margin-top: 1rem;
    font-size: clamp(3rem, 0.8rem + 6.5vw, 8.5rem);
    font-stretch: 76%;
    font-weight: 650;
    line-height: 0.86;
  }
  .feat__stand {
    max-width: 30em;
    margin-top: 1.5rem;
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.45rem);
    line-height: 1.4;
  }
  .feat__motif {
    position: relative;
    grid-column: 8 / -1;
    aspect-ratio: 1;
  }
  .feat__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .feat__shot {
    grid-column: 1 / -1;
    margin-top: var(--gap);
  }
  .feat__frame {
    display: grid;
    place-items: center;
    padding: clamp(0.75rem, 3vw, 3.5rem);
    background: var(--bg-2);
    border-radius: 8px;
  }
  .feat__frame img {
    width: 100%;
    max-width: 72rem;
    border-radius: 4px;
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.7);
  }
  figcaption.label {
    margin-top: 0.75rem;
  }
  .feat__body {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    margin-top: clamp(2.5rem, 6vh, 4.5rem);
    row-gap: 2.5rem;
  }
  .feat__text {
    grid-column: 1 / span 7;
  }
  .feat__sec + .feat__sec {
    margin-top: 2.5rem;
  }
  .feat__sec h4 {
    margin-bottom: 0.9rem;
  }
  .feat__sec p {
    max-width: 36em;
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.2rem);
    line-height: 1.6;
  }
  .feat__sec p + p {
    margin-top: 1em;
  }
  .feat__list {
    counter-reset: c;
    border-top: 1px solid var(--rule);
  }
  .feat__list li {
    counter-increment: c;
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }
  .feat__list li::before {
    content: counter(c, decimal-leading-zero);
    font-family: var(--display);
    font-weight: 600;
    color: var(--tint);
  }
  .feat__list--plain li::before {
    content: '—';
  }
  .feat__facts {
    grid-column: 9 / span 4;
  }
  .feat__facts dl > div {
    padding-block: 0.85rem;
    border-top: 1px solid var(--rule);
