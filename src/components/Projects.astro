---
import { Image } from 'astro:assets';
import { type ProjectEntry, paragraphs } from '../lib/content';
import { formatPeriod } from '../lib/format';
import { getMedia } from '../lib/media';
import { STOCKS } from '../lib/stocks';

interface Props {
  projects: ProjectEntry[];
}
const { projects } = Astro.props;

const period = (p: ProjectEntry) => formatPeriod(p.period?.start, p.period?.end, p.status === 'en-cours') || (p.status === 'en-cours' ? 'En cours' : '');
const blocks = (p: ProjectEntry) =>
  [
    { title: 'Contexte', text: p.context },
    { title: 'Problème', text: p.problem },
    { title: 'Mon rôle', text: p.role },
    { title: 'Approche', text: p.approach },
  ].filter((b) => b.text);
const count = ['zéro', 'un', 'deux', 'trois', 'quatre', 'cinq', 'six', 'sept', 'huit', 'neuf', 'dix'][projects.length] ?? String(projects.length);
---

<section class="projects section" id="projets" aria-labelledby="projects-title">
  <div class="wrap">
    <header class="sec-head" data-fold>
      <h2 id="projects-title" class="display">Projets</h2>
      <p>
        {count.charAt(0).toUpperCase() + count.slice(1)} volets : des logiciels pour l'administration, une recherche de terrain, une application
        mobile, un observatoire de données. Choisissez-en un pour le déplier.
      </p>
    </header>

    <div class="map" data-map>
      {
        projects.map((p, i) => {
          const stock = STOCKS[p.cover.color];
          const cover = p.cover.image ? getMedia(p.cover.image.src) : undefined;
          const paint = `--paper:${stock.paper};--paper-ink:${stock.ink}`;
          return (
            <>
              <article class="panel" id={`projet-${p.id}`} style={paint} data-panel data-fold>
                <p class="panel__meta label">
                  <span>{p.category === 'pro' ? 'Professionnel' : 'Personnel'}</span>
                  <span>{period(p)}</span>
                </p>
                {cover && p.cover.image && (
                  <div class="panel__shot">
                    <Image src={cover} alt={p.cover.image.alt} widths={[480, 960]} sizes="(max-width: 48rem) 100vw, 33vw" loading="lazy" />
                  </div>
                )}
                <h3 class="panel__title display">
                  <button class="panel__toggle" type="button" id={`toggle-${p.id}`} aria-expanded="true" aria-controls={`detail-${p.id}`}>
                    {p.title}
                  </button>
                </h3>
                <p class="panel__kind">{[p.kind, p.organisation].filter(Boolean).join(' — ')}</p>
                <span class="panel__cue label" aria-hidden="true">
                  <i>↓</i>
                  <span class="panel__cue-open">Déplier</span>
                  <span class="panel__cue-close">Replier</span>
                </span>
              </article>

              <section class="flap" id={`detail-${p.id}`} aria-labelledby={`toggle-${p.id}`} style={paint} data-flap>
                <div class="flap__in">
                  <div class="flap__sheet">
                    <p class="flap__lead">{p.summary}</p>
                    <dl class="flap__facts">
                      {p.organisation && (
                        <div>
                          <dt class="label">Cadre</dt>
                          <dd>{p.organisation}</dd>
                        </div>
                      )}
                      {period(p) && (
                        <div>
                          <dt class="label">Période</dt>
                          <dd>{period(p)}</dd>
                        </div>
                      )}
                      {p.kind && (
                        <div>
                          <dt class="label">Nature</dt>
                          <dd>{p.kind}</dd>
                        </div>
                      )}
                    </dl>
                    <div class="flap__text">
                      {blocks(p).map((b) => (
                        <div class="flap__block">
                          <h4 class="label">{b.title}</h4>
                          {paragraphs(b.text).map((t) => (
                            <p>{t}</p>
                          ))}
                        </div>
                      ))}
                    </div>
                    <div class="flap__lists">
                      {p.contributions.length > 0 && (
                        <div class="flap__block">
                          <h4 class="label">{p.category === 'pro' ? 'Contributions' : 'Fonctionnalités'}</h4>
                          <ul role="list">
                            {p.contributions.map((c) => (
                              <li>{c}</li>
                            ))}
                          </ul>
                        </div>
                      )}
                      {p.results.length > 0 && (
                        <div class="flap__block">
                          <h4 class="label">Résultats</h4>
                          <ul role="list">
                            {p.results.map((c) => (
                              <li>{c}</li>
                            ))}
                          </ul>
                        </div>
                      )}
                      {p.technologies.length > 0 && (
                        <div class="flap__block">
                          <h4 class="label">Technologies</h4>
                          <p class="flap__techs">
                            {p.technologies.map((t) => (
                              <span>{t}</span>
                            ))}
                          </p>
                        </div>
                      )}
                      {p.links.length > 0 && (
                        <p class="flap__links">
                          {p.links.map((l) => (
                            <a class="link" href={l.url} rel="noopener">
                              {l.label} ↗
                            </a>
                          ))}
                        </p>
                      )}
                    </div>
                    {(cover || p.gallery.length > 0) && (
                      <div class="flap__images">
                        {cover && p.cover.image && (
                          <figure>
                            <Image src={cover} alt={p.cover.image.alt} widths={[640, 1280]} sizes="(max-width: 48rem) 100vw, 50vw" loading="lazy" />
                            <figcaption>{p.cover.image.caption ?? 'Capture réelle du projet.'}</figcaption>
                          </figure>
                        )}
                        {p.gallery.map((g) => (
                          <figure>
                            <Image src={getMedia(g.src)!} alt={g.alt} widths={[640, 1280]} sizes="(max-width: 48rem) 100vw, 50vw" loading="lazy" />
                            {g.caption && <figcaption>{g.caption}</figcaption>}
                          </figure>
                        ))}
                      </div>
                    )}
                    <p class="flap__actions">
                      <button class="flap__close label" type="button" data-close>
                        ↑ Replier
                      </button>
                      {i + 1 < projects.length && (
                        <button class="flap__next label" type="button" data-next={projects[i + 1].id}>
                          Volet suivant : {projects[i + 1].title} →
                        </button>
                      )}
                    </p>
                  </div>
                </div>
              </section>
            </>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .map {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    perspective: 2000px;
  }
  :global(html:not(.js)) .map {
    grid-template-columns: minmax(0, 1fr);
  }

  /* A panel of the folded map: the project's own paper. */
  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: clamp(19rem, 16rem + 12vw, 27rem);
    padding: clamp(1.1rem, 1.6vw, 1.5rem);
    background: var(--paper);
    color: var(--paper-ink);
    box-shadow:
      inset 1px 0 0 rgb(0 0 0 / 0.14),
      inset 0 1px 0 rgb(0 0 0 / 0.14);
    backface-visibility: hidden;
    transform-origin: 0 50%;
  }
  /* The corner that lifts on hover, and stays turned while the panel is open. */
  .panel::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: 0;
    height: 0;
    background: linear-gradient(225deg, var(--paper) 50%, rgb(0 0 0 / 0.28) 50%, rgb(0 0 0 / 0.08));
    box-shadow: -4px -4px 10px -6px rgb(0 0 0 / 0.4);
    transition:
      width var(--dur-2) var(--ease),
      height var(--dur-2) var(--ease);
  }
  .panel:hover::after,
  .panel:focus-within::after,
  .panel.is-open::after {
    width: 2.75rem;
    height: 2.75rem;
  }
  .panel__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .panel__shot {
    margin: 1rem calc(-1 * clamp(1.1rem, 1.6vw, 1.5rem)) 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    box-shadow:
      0 1px 0 rgb(0 0 0 / 0.12),
      0 -1px 0 rgb(0 0 0 / 0.12);
  }
  .panel__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0 0;
    transition: transform var(--dur-3) var(--ease);
  }
  .panel:hover .panel__shot :global(img) {
    transform: scale(1.03);
  }
  .panel__title {
    margin-top: auto;
    padding-top: 1.5rem;
    font-size: clamp(2.1rem, 1.2rem + 2.6vw, 3.6rem);
    line-height: 0.88;
  }
  .panel__toggle {
    font: inherit;
    letter-spacing: inherit;
    text-align: left;
    color: inherit;
  }
  /* The whole panel answers the click, not only the title. */
  .panel__toggle::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .panel__toggle:focus-visible {
    outline: none;
  }
  .panel:has(.panel__toggle:focus-visible) {
    outline: 3px solid var(--paper-ink);
    outline-offset: -7px;
  }
  .panel__kind {
    margin-top: 0.75rem;
    max-width: 26rem;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .panel__cue {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.1rem;
  }
  .panel__cue i {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1.5px solid currentColor;
    font-style: normal;
    transition: transform var(--dur-2) var(--ease);
  }
  .panel.is-open .panel__cue i {
    transform: rotate(180deg);
  }
  .panel__cue-close,
  .panel.is-open .panel__cue-open {
    display: none;
  }
  .panel.is-open .panel__cue-close {
    display: inline;
  }
  :global(html:not(.js)) .panel__cue {
    display: none;
  }

  /* The detail: a flap of the same paper, hinged on the crease under its row. */
  .flap {
    grid-column: 1 / -1;
    display: grid;
    grid-template-rows: 1fr;
    perspective: 1800px;
  }
  :global(.motion) .flap {
    transition: grid-template-rows var(--dur-3) var(--ease-fold);
  }
  .flap.is-closed {
    grid-template-rows: 0fr;
  }
  .flap__in {
    min-height: 0;
    overflow: hidden;
  }
  .flap__sheet {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.5rem;
    row-gap: 1.75rem;
    padding: clamp(1.75rem, 4vw, 3.5rem) clamp(1.1rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);
    background: var(--paper);
    color: var(--paper-ink);
    box-shadow: inset 0 1px 0 rgb(0 0 0 / 0.22);
    transform-origin: 50% 0;
  }
  .flap__sheet::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 45%;
    pointer-events: none;
    background: linear-gradient(rgb(0 0 0 / 0.24), rgb(0 0 0 / 0));
    opacity: 0.25;
  }
  :global(.motion) .flap__sheet {
    transition: transform var(--dur-3) var(--ease-fold);
  }
  :global(.motion) .flap__sheet::before {
    transition: opacity var(--dur-3) var(--ease-fold);
  }
  :global(.motion) .flap.is-closed .flap__sheet {
    transform: rotateX(-86deg);
  }
  :global(.motion) .flap.is-closed .flap__sheet::before {
    opacity: 1;
  }
  .flap__lead {
    grid-column: 1 / span 7;
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.7rem);
    font-weight: 480;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .flap__facts {
    grid-column: 9 / -1;
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .flap__facts dd {
    margin: 0.15rem 0 0;
    font-size: 0.9375rem;
  }
  .flap__text {
    grid-column: 1 / span 6;
  }
  .flap__lists {
    grid-column: 8 / -1;
  }
  .flap__block + .flap__block {
    margin-top: 1.75rem;
  }
  .flap__block h4 {
    margin-bottom: 0.6rem;
  }
  .flap__block p + p {
    margin-top: 0.8em;
  }
  .flap__block li {
    padding: 0.6rem 0;
    border-top: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    font-size: 0.9688rem;
    line-height: 1.5;
  }
  .flap__techs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    font-weight: 600;
    font-stretch: 110%;
  }
  .flap__links {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    font-weight: 620;
  }
  .flap__images {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .flap__images figure {
    margin: 0;
  }
  .flap__images :global(img) {
    width: 100%;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.14);
  }
  .flap__images figcaption {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
  }
  .flap__actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, currentColor 22%, transparent);
  }
  .flap__actions button {
    min-height: 2.75rem;
  }
  .flap__actions button:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  :global(html:not(.js)) .flap__actions {
    display: none;
  }

  /* The map unfolds as it comes into view: each column is hinged on the previous one. */
  :global(.motion) .panel[data-fold] {
    transition:
      transform var(--dur-3) var(--ease-fold),
      filter var(--dur-3) var(--ease-fold);
    transition-delay: var(--fold-delay, 0ms);
  }
  :global(.motion) .panel[data-fold]:not(.is-flat) {
    filter: brightness(0.7);
  }
  :global(.motion) .panel[data-col='1']:not(.is-flat) {
    transform-origin: 50% 0;
    transform: rotateX(-38deg);
  }
  :global(.motion) .panel[data-col='2']:not(.is-flat),
  :global(.motion) .panel[data-col='3']:not(.is-flat) {
    transform: rotateY(-88deg);
  }
  :global(.motion) .panel[data-col='2'] {
    --fold-delay: 140ms;
  }
  :global(.motion) .panel[data-col='3'] {
    --fold-delay: 280ms;
  }

  @media (max-width: 64rem) {
    .map {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .flap__lead,
    .flap__text,
    .flap__lists {
      grid-column: 1 / -1;
    }
    .flap__facts {
      grid-column: 1 / -1;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 47.99rem) {
    .map {
      grid-template-columns: minmax(0, 1fr);
    }
    .panel {
      min-height: 0;
    }
    .panel__title {
      padding-top: 2.75rem;
    }
    .flap__facts {
      grid-template-columns: 1fr;
    }
    .flap__images {
      grid-template-columns: 1fr;
    }
    :global(.motion) .panel[data-col]:not(.is-flat) {
      transform-origin: 50% 0;
      transform: rotateX(-72deg);
    }
  }
</style>
