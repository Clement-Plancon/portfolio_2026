---
// The projects. Those shown in large (Site → Projets: the projects marked « mis en avant », up to a
// maximum) each get a screen: their poster, tilted, and their title in wide capitals that stretch as
// they come in. The other visible projects are a strip of small posters under « Autres réalisations »,
// so twelve projects make the page no longer than four. Every project opens the same article
// (ProjectArticle) over the page. Nothing here counts on a number of projects.
import Arrow from './Arrow.astro';
import Poster from './Poster.astro';
import ProjectArticle from './ProjectArticle.astro';
import type { ProjectEntry } from '../lib/content';
import { formatPeriod } from '../lib/format';
import type { MediaResolver } from '../lib/media';
import { displaySize, lineSize, tilt } from '../lib/poster';
import type { ResolvedSection } from '../lib/site';
import { tintStyle } from '../lib/tints';

interface Props {
  section: ResolvedSection;
  featured: ProjectEntry[];
  others: ProjectEntry[];
  othersTitle: string;
  media: MediaResolver;
}
const { section, featured, others, othersTitle, media } = Astro.props;
const all = [...featured, ...others];
const pad = (n: number) => String(n).padStart(2, '0');
const period = (p: ProjectEntry) => formatPeriod(p.period?.start, p.period?.end, p.status === 'en-cours') || (p.status === 'en-cours' ? 'En cours' : '');
const side = (p: ProjectEntry, i: number) =>
  p.cover.variant === 'empile' ? 'stack' : p.cover.variant === 'texte-gauche' ? 'right' : p.cover.variant === 'texte-droite' ? 'left' : i % 2 ? 'right' : 'left';
const longestWord = (t: string) => t.split(/\s+/).reduce((a, b) => ([...b].length > [...a].length ? b : a), '');
const article = (p: ProjectEntry) => {
  const k = all.indexOf(p);
  return { project: p, i: k, total: all.length, prev: all[(k - 1 + all.length) % all.length], next: all[(k + 1) % all.length], media };
};
const kindOf = (p: ProjectEntry) => p.kind ?? (p.category === 'pro' ? 'Projet professionnel' : 'Projet personnel');
---

<section class="projects part tone-paper" id="projets" aria-labelledby="projects-title" data-tone="paper" data-part>
  <header class="projects__head wrap">
    <h2 id="projects-title" class="projects__title display" style={`--size:${displaySize(section.title, 15, 80)}`}>
      {section.title}<sup class="projects__count" aria-hidden="true">{pad(all.length)}</sup>
    </h2>
    {section.intro && <p class="projects__lede lede">{section.intro}</p>}
  </header>

  {
    featured.map((p, i) => (
      <article class:list={['case', `case--${side(p, i)}`, { 'case--dsfr': p.cover.poster === 'dsfr' }]} id={`projet-${p.id}`} style={`${tintStyle(p.cover.color)};--tilt:${tilt(p.id, 4)}deg`} aria-labelledby={`case-${p.id}`} data-project>
        <div class="case__in wrap">
          <a class="case__poster" href={`#projet-${p.id}`} aria-controls={`detail-${p.id}`} tabindex="-1" aria-hidden="true" data-open data-origin data-tilt>
            <Poster project={p} index={all.indexOf(p)} media={media} />
          </a>
          <div class="case__text">
            <p class="case__no label">
              <span class="case__n">{pad(all.indexOf(p) + 1)}</span>
              <span>{kindOf(p)}</span>
            </p>
            <h3 class="case__title display" id={`case-${p.id}`} style={`--s:${lineSize(longestWord(p.title), 17, 96)}`} data-kinetic>
              <a href={`#projet-${p.id}`} aria-controls={`detail-${p.id}`} data-open>
                {p.title}
              </a>
            </h3>
            <p class="case__sum">{p.summary}</p>
            {(p.organisation || period(p)) && <p class="case__meta label">{[p.category === 'pro' ? p.organisation : 'Projet personnel', period(p)].filter(Boolean).join(' — ')}</p>}
            <div class="case__cta">
              <a class="btn btn--fill" href={`#projet-${p.id}`} aria-controls={`detail-${p.id}`} data-open>
                Voir le projet<span class="visually-hidden"> {p.title}</span> <Arrow />
              </a>
              {
                p.links[0] && (
                  <a class="btn" href={p.links[0].url} rel="noopener">
                    {p.links[0].label} <Arrow dir="out" />
                  </a>
                )
              }
            </div>
          </div>
        </div>
        <ProjectArticle {...article(p)} />
      </article>
    ))
  }

  {
    others.length > 0 && (
      <div class="others">
        <div class="others__head wrap">
          <h3 class="others__title">
            {othersTitle} <span class="others__n">{pad(others.length)}</span>
          </h3>
          {others.length > 2 && (
            <p class="others__nav" data-strip-nav hidden>
              <button type="button" class="others__btn" data-strip="-1" aria-label="Affiches précédentes">
                <Arrow dir="left" />
              </button>
              <button type="button" class="others__btn" data-strip="1" aria-label="Affiches suivantes">
                <Arrow />
              </button>
            </p>
          )}
        </div>
        <ul role="list" class="others__strip" data-strip-list>
          {others.map((p) => (
            <li class="mini" id={`projet-${p.id}`} style={`--tilt:${tilt(p.id, 3)}deg`} data-project>
              <a class="mini__link" href={`#projet-${p.id}`} aria-controls={`detail-${p.id}`} data-open data-origin>
                <Poster project={p} index={all.indexOf(p)} media={media} still />
                <span class="mini__title">{p.title}</span>
              </a>
              <p class="mini__meta label">{[kindOf(p).split('·')[0].trim(), period(p)].filter(Boolean).join(' — ')}</p>
              <ProjectArticle {...article(p)} />
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<style>
  .projects {
    padding-block: clamp(4rem, 9vw, 9rem) clamp(4rem, 8vw, 8rem);
  }
  .projects__head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(3.5rem, 7vw, 7rem);
  }
  .projects__title {
    font-size: min(13rem, calc(var(--size) * 1vw));
    line-height: 0.8;
    letter-spacing: -0.045em;
    overflow-wrap: anywhere;
  }
  .projects__count {
    font-size: 0.22em;
    vertical-align: top;
    margin-left: 0.15em;
    letter-spacing: 0;
    color: var(--accent);
  }
  .projects__lede {
    max-width: 36rem;
  }

  /* ---------- A project in large: the poster and the text side by side ---------- */
  .case + .case {
    margin-top: clamp(4rem, 10vw, 10rem);
  }
  .case__in {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 6rem);
  }
  .case--right .case__poster {
    order: 2;
  }
  .case__poster {
    display: block;
    width: min(100%, 32rem);
    justify-self: center;
    rotate: var(--tilt);
    box-shadow: 0 2.5rem 4rem -2rem rgb(17 17 17 / 0.45);
    transition:
      rotate var(--dur-3) var(--ease),
      scale var(--dur-2) var(--spring);
  }
  .case__poster:hover {
    rotate: 0deg;
    scale: 1.02;
  }
  :global(.motion) .case__poster {
    translate: 0 calc((0.5 - var(--k, 0.5)) * 18%);
    rotate: calc(var(--tilt) + (0.5 - var(--k, 0.5)) * 10deg);
  }
  .case__text {
    container-type: inline-size;
    min-width: 0;
  }
  .case__no {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    color: var(--fg-2);
  }
  .case__n {
    font-size: 1rem;
    font-weight: 800;
    color: var(--fg);
    background: var(--p-bg);
    color: var(--p-ink);
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius);
  }
  .case__title {
    margin-top: 1rem;
    font-size: calc(var(--s) * 1cqi);
    line-height: 0.86;
    letter-spacing: -0.03em;
  }
  :global(.motion) .case__title {
    font-stretch: calc(80% + var(--k, 1) * 45%);
  }
  .case__title a {
    text-decoration: none;
    background: linear-gradient(var(--p-bg), var(--p-bg)) 0 92% / 0 0.18em no-repeat;
    transition: background-size var(--dur-2) var(--ease);
  }
  .case__title a:hover {
    background-size: 100% 0.18em;
  }
  .case__sum {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.375rem);
    line-height: 1.4;
  }
  .case__meta {
    margin-top: 1rem;
    color: var(--fg-2);
  }
  .case__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  /* Stacked: the poster centred and wide, the text under it. */
  .case--stack .case__in {
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }
  .case--stack .case__poster {
    width: min(100%, 36rem);
  }
  .case--stack .case__text {
    /* a size container gets no width from its content: give it the column */
    width: 100%;
    max-width: 52rem;
  }
  .case--stack .case__no,
  .case--stack .case__cta {
    justify-content: center;
  }
  .case--stack .case__sum {
    margin-inline: auto;
  }

  /* DSFR: the project text as a card of the French State's design system (grey surface, blue title,
     red line, square buttons). Its logo and Marianne font are not used: they are reserved to the State. */
  .case--dsfr .case__text {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: #f6f6f6;
    color: #161616;
    border-bottom: 4px solid #000091;
    font-family: Marianne, Arial, Helvetica, sans-serif;
  }
  .case--dsfr .case__no {
    color: #3a3a3a;
  }
  .case--dsfr .case__n {
    background: #000091;
    color: #ffffff;
    border-radius: 0;
  }
  .case--dsfr .case__title {
    font-family: inherit;
    font-stretch: 100%;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
    color: #000091;
    text-transform: none;
  }
  :global(.motion) .case--dsfr .case__title {
    font-stretch: 100%;
  }
  .case--dsfr .case__title::after {
    content: '';
    display: block;
    width: 3rem;
    height: 4px;
    margin-top: 1rem;
    background: #e1000f;
  }
  .case--stack.case--dsfr .case__title::after {
    margin-inline: auto;
  }
  .case--dsfr .case__title a {
    background-image: linear-gradient(#000091, #000091);
  }
  .case--dsfr .case__meta {
    color: #3a3a3a;
  }
  .case--dsfr .case__cta :global(.btn) {
    border-radius: 0;
    border: 1px solid #000091;
    color: #000091;
    background: #ffffff;
  }
  .case--dsfr .case__cta :global(.btn--fill) {
    background: #000091;
    color: #ffffff;
  }
  .case--dsfr .case__cta :global(.btn:hover) {
    background: #e3e3fd;
    color: #000091;
  }
  .case--dsfr .case__cta :global(.btn--fill:hover) {
    background: #1212ff;
    color: #ffffff;
  }

  /* ---------- The other projects: a strip of small posters ---------- */
  .others {
    margin-top: clamp(5rem, 11vw, 11rem);
  }
  .others__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    border-top: 3px solid var(--fg);
    padding-top: 1rem;
  }
  .others__title {
    font-size: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    font-weight: 800;
    font-stretch: 110%;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .others__n {
    font-size: 0.5em;
    vertical-align: top;
    color: var(--accent);
  }
  .others__nav {
    display: flex;
    gap: 0.5rem;
  }
  .others__btn {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 2px solid currentColor;
    transition:
      background var(--dur-1),
      color var(--dur-1);
  }
  .others__btn:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .others__btn:disabled {
    opacity: 0.3;
    pointer-events: none;
  }
  .others__strip {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--g);
    padding: 2rem var(--g) 2.5rem;
    scrollbar-width: thin;
    scrollbar-color: var(--fg) transparent;
  }
  .mini {
    flex: none;
    width: clamp(11rem, 8rem + 9vw, 17rem);
    scroll-snap-align: start;
  }
  .mini__link {
    display: grid;
    gap: 0.6rem;
    text-decoration: none;
  }
  .mini__link :global(.poster) {
    rotate: var(--tilt);
    box-shadow: 0 1.5rem 2.5rem -1.5rem rgb(17 17 17 / 0.45);
    transition:
      rotate var(--dur-2) var(--ease),
      translate var(--dur-2) var(--spring);
  }
  .mini__link:hover :global(.poster),
  .mini__link:focus-visible :global(.poster) {
    rotate: 0deg;
    translate: 0 -0.5rem;
  }
  .mini__title {
    margin-top: 0.6rem;
    font-weight: 800;
    font-size: 1.0625rem;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }
  .mini__meta {
    margin-top: 0.35rem;
    color: var(--fg-2);
  }

  @media (max-width: 61.99rem) {
    .case__in {
      grid-template-columns: minmax(0, 1fr);
    }
    .case--right .case__poster {
      order: 0;
    }
    .case__poster {
      width: min(78%, 26rem);
    }
    .case--right .case__poster {
      justify-self: end;
    }
    .case--left .case__poster {
      justify-self: start;
    }
  }
  @media (max-width: 47.99rem) {
    .case__poster {
      width: 84%;
    }
  }
</style>
