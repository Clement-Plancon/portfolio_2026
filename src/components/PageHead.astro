---
// Title panel of inner pages: a black sign with a mono label, the title and an optional lead.
interface Props {
  title: string;
  lead?: string;
  label?: string;
}
const { title, lead, label } = Astro.props;
---

<header class="wrap page-head">
  <div class="panel page-head__panel">
    {label && <p class="label">{label}</p>}
    <h1>{title}</h1>
    {lead && <p class="page-head__lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-head {
    padding-top: var(--joint);
  }
  .page-head__panel {
    padding-block: clamp(1.75rem, 1rem + 3vw, 3.5rem);
  }
  h1 {
    margin-top: 0.6rem;
    font-size: var(--step-4);
    letter-spacing: -0.035em;
  }
  .page-head__lead {
    margin-top: 1rem;
    max-width: 44rem;
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--on-panel-2);
  }
</style>
