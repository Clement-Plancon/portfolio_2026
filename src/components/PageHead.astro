---
// Page title block shared by inner pages.
interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
}
const { title, lead, eyebrow } = Astro.props;
---

<header class="page-head wrap">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {lead && <p class="page-head__lead">{lead}</p>}
  <slot />
</header>

<style>
  .page-head {
    padding-top: clamp(2rem, 1rem + 4vw, 5rem);
  }
  h1 {
    margin-top: var(--space-2);
    font-size: var(--step-4);
    font-weight: 650;
    letter-spacing: -0.035em;
    max-width: 18ch;
  }
  .page-head__lead {
    margin-top: var(--space-5);
    max-width: 40rem;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-2);
  }
</style>
