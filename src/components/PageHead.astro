---
// Title block of inner pages. `title` accepts *word* for an italic, developing word.
import { emphasis } from '../lib/format';

interface Props {
  title: string;
  lead?: string;
  label?: string;
}
const { title, lead, label } = Astro.props;
---

<header class="wrap page-head">
  {label && <p class="eyebrow">{label}</p>}
  <h1 set:html={emphasis(title)} />
  {lead && <p class="lede">{lead}</p>}
  <slot />
</header>

<style>
  .page-head {
    padding-block: clamp(3rem, 2rem + 5vw, 7rem) clamp(2rem, 1.5rem + 3vw, 4rem);
  }
  .page-head h1 {
    margin-top: 1rem;
    font-size: var(--step-4);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.035em;
    max-width: 16ch;
  }
  .page-head .lede {
    margin-top: 1.5rem;
  }
</style>
