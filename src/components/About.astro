---
// Act 4 — the approach: who Clément is and how he works, in his own words from the content (intro,
// biography, the sentence he keeps, his four principles). Nothing added.
import { paragraphs } from '../lib/content';
import type { MediaResolver } from '../lib/media';
import type { Profile } from '../lib/schemas';
import ThreadSvg from './ThreadSvg.astro';

interface Props {
  profile: Profile;
  media: MediaResolver;
  colors: string[];
}
const { profile, media, colors } = Astro.props;
const bio = paragraphs(profile.bio);
// The last paragraph of the biography is set apart.
const motto = bio.length > 1 ? bio.at(-1) : undefined;
const body = motto ? bio.slice(0, -1) : bio;
const photo = profile.photo ? media(profile.photo.src) : undefined;
---

<section class="about" id="a-propos" aria-labelledby="about-title" data-scene="warp" data-glow="#3a2614">
  <div class="wrap">
    <p class="act label"><span><span class="act__n">04</span> Approche</span></p>
    <h2 id="about-title" class="about__title display">À propos</h2>

    <div class="about__grid">
      <p class="about__intro lede" data-reveal>{profile.intro}</p>
      {
        photo && profile.photo && (
          <figure class="about__photo" data-reveal>
            <img src={photo.src} alt={profile.photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
          </figure>
        )
      }
      <div class="about__bio" data-reveal>
        {body.map((p) => <p>{p}</p>)}
      </div>
    </div>

    {
      motto && (
        <figure class="about__motto" data-reveal>
          <div class="about__motto-stage" data-stage>
            <ThreadSvg kind="warp" colors={colors} />
          </div>
          <blockquote>
            <p class="display">{motto}</p>
          </blockquote>
        </figure>
      )
    }

    {
      profile.principles.length > 0 && (
        <div class="about__principles">
          <h3 class="label">Ma façon de travailler</h3>
          <ol role="list" class="princ">
            {profile.principles.map((p, i) => (
              <li data-reveal style={`--d:${i};--c:${colors[i % colors.length]}`}>
                <span class="princ__n display" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h4 class="princ__t display">{p.title}</h4>
                <p class="muted">{p.text}</p>
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </div>
</section>

<style>
  .about {
    padding-top: clamp(7rem, 16vh, 12rem);
  }
  .about__title {
    margin-top: 2rem;
    font-size: clamp(4rem, 1rem + 11vw, 13rem);
    font-stretch: 75%;
    font-weight: 650;
    line-height: 0.8;
  }
  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }
  .about__intro {
    grid-column: 1 / span 8;
  }
  .about__photo {
    grid-column: 10 / span 3;
    grid-row: 1 / span 2;
  }
  .about__photo img {
    width: 100%;
    border-radius: 10px;
    filter: grayscale(0.4) contrast(1.05);
  }
  .about__bio {
    grid-column: 4 / span 6;
    columns: 2 17rem;
    column-gap: var(--gap);
    color: var(--fg-2);
  }
  .about__bio p {
    break-inside: avoid;
    margin-bottom: 1em;
  }
  /* The sentence he keeps, across the threads. */
  .about__motto {
    position: relative;
    margin-top: clamp(4rem, 10vh, 7rem);
    padding-block: clamp(3rem, 8vh, 5rem);
  }
  .about__motto-stage {
    position: absolute;
    inset: 0 calc(var(--g) * -1);
    pointer-events: none;
  }
  .about__motto blockquote {
    position: relative;
    text-align: center;
  }
  .about__motto p {
    max-width: 18ch;
    margin-inline: auto;
    font-size: clamp(2rem, 1rem + 3.6vw, 4.6rem);
    font-weight: 500;
    font-stretch: 82%;
    line-height: 1;
    text-shadow: 0 2px 30px rgb(15 14 13 / 0.9);
  }
  .about__motto p::before {
    content: '« ';
    color: var(--accent);
  }
  .about__motto p::after {
    content: ' »';
    color: var(--accent);
  }
  .about__principles {
    margin-top: clamp(4rem, 10vh, 7rem);
  }
  .princ {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
    margin-top: 1.25rem;
  }
  .princ li {
    position: relative;
    padding: 1.5rem 0 0;
  }
  .princ li::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--rule-strong);
  }
  .princ li::after {
    content: '';
    position: absolute;
    left: 0;
    top: -0.5px;
    height: 2px;
    width: 2.5rem;
    background: var(--c);
    transition: width var(--dur-3) var(--ease);
  }
  .princ li:hover::after {
    width: 100%;
  }
  .princ__n {
    font-size: 2.6rem;
    font-weight: 600;
    font-stretch: 75%;
    color: color-mix(in srgb, var(--c) 62%, #fff); /* text: the dye, lightened to AA contrast */
  }
  .princ__t {
    margin: 0.6rem 0 0.7rem;
    font-size: clamp(1.4rem, 1.1rem + 0.8vw, 1.9rem);
    font-weight: 600;
    font-stretch: 82%;
    line-height: 1;
  }
  .princ p {
    font-size: 0.9375rem;
  }
  @media (max-width: 63.99rem) {
    .about__intro,
    .about__bio {
      grid-column: 1 / -1;
    }
    .about__photo {
      grid-column: 1 / span 5;
      grid-row: auto;
    }
    .princ {
      grid-template-columns: 1fr 1fr;
      row-gap: 2.5rem;
    }
  }
  @media (max-width: 47.99rem) {
    .about__photo {
      grid-column: 1 / span 9;
    }
    .princ {
      grid-template-columns: 1fr;
    }
  }
</style>
