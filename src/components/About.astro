---
// Act 4 — the approach: who you are and how you work, in your own words from the content (introduction,
// biography, the sentence set apart, the principles), with the current position and the CV. Every part
// is optional: an empty one leaves no gap.
import { paragraphs } from '../lib/content';
import type { ExperienceEntry } from '../lib/content';
import type { MediaResolver } from '../lib/media';
import type { Profile, Site } from '../lib/schemas';
import type { ResolvedSection } from '../lib/site';
import Arrow from './Arrow.astro';
import Media from './Media.astro';
import ThreadSvg from './ThreadSvg.astro';

interface Props {
  section: ResolvedSection;
  profile: Profile;
  experiences: ExperienceEntry[];
  site: Site;
  cvUrl?: string;
  threads: string[];
  media: MediaResolver;
  glow: string;
}
const { section, profile, experiences, site, cvUrl, threads: colors, media, glow } = Astro.props;
const bio = paragraphs(profile.bio);
// The last paragraph of the biography is set apart.
const motto = bio.length > 1 ? bio.at(-1) : undefined;
const body = motto ? bio.slice(0, -1) : bio;
const current = experiences.find((e) => !e.end);
const principles = site.about.showPrinciples ? profile.principles : [];
---

<section class="about" id="a-propos" aria-labelledby="about-title" data-scene="warp" data-glow={glow} data-act={`${section.act} — ${section.actName}`}>
  <div class="wrap">
    <p class="act label"><span><span class="act__n">{section.act}</span> {section.actName}</span></p>
    <h2 id="about-title" class="about__title display">{section.title}</h2>

    <div class:list={['about__grid', { 'about__grid--photo': profile.photo }]}>
      {profile.intro && <p class="about__intro lede" data-reveal>{profile.intro}</p>}
      {
        profile.photo && (
          <div class="about__photo" data-reveal>
            <Media src={profile.photo.src} alt={profile.photo.alt} media={media} />
          </div>
        )
      }
      <div class="about__bio" data-reveal>
        {section.intro && <p class="about__lead">{section.intro}</p>}
        {body.map((p) => <p>{p}</p>)}
        {
          (current || cvUrl) && (
            <div class="about__facts">
              {current && (
                <p>
                  <span class="label">Aujourd'hui</span>
                  <span>
                    {current.role} — {current.organisation}
                  </span>
                </p>
              )}
              {cvUrl && (
                <a class="btn" href={cvUrl}>
                  Télécharger le CV <Arrow dir="down" />
                </a>
              )}
            </div>
          )
        }
      </div>
    </div>

    {
      motto && (
        <figure class="about__motto" data-reveal>
          <div class="about__motto-stage" data-stage>
            <ThreadSvg kind="warp" colors={colors} />
          </div>
          <blockquote>
            <p class="display">{motto}</p>
          </blockquote>
        </figure>
      )
    }

    {
      principles.length > 0 && (
        <div class="about__principles">
          <h3 class="label">{site.about.principlesTitle ?? 'Ma façon de travailler'}</h3>
          <ol role="list" class="princ" style={`--n:${principles.length}`}>
            {principles.map((p, i) => (
              <li data-reveal style={`--d:${i};--c:${colors[i % colors.length]}`}>
                <span class="princ__n display" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h4 class="princ__t display">{p.title}</h4>
                <p class="muted">{p.text}</p>
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </div>
</section>

<style>
  .about {
    padding-top: clamp(7rem, 16vh, 12rem);
  }
  .about__title {
    margin-top: 2rem;
    font-size: clamp(4rem, 1rem + 11vw, 13rem);
    font-stretch: 75%;
    font-weight: 650;
    line-height: 0.8;
  }
  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }
  .about__intro {
    grid-column: 1 / span 8;
  }
  .about__photo {
    grid-column: 10 / span 3;
    grid-row: 1 / span 2;
  }
  .about__grid--photo .about__intro {
    grid-column: 1 / span 8;
  }
  .about__lead {
    color: var(--fg);
  }
  .about__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
    break-inside: avoid;
    color: var(--fg);
  }
  .about__facts p {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 0;
  }
  .about__bio {
    grid-column: 4 / span 6;
    columns: 2 17rem;
    column-gap: var(--gap);
    color: var(--fg-2);
  }
  .about__bio p {
    break-inside: avoid;
    margin-bottom: 1em;
  }
  /* The sentence he keeps, across the threads. */
  .about__motto {
    position: relative;
    margin-top: clamp(4rem, 10vh, 7rem);
    padding-block: clamp(3rem, 8vh, 5rem);
  }
  .about__motto-stage {
    position: absolute;
    inset: 0 calc(var(--g) * -1);
    pointer-events: none;
  }
  .about__motto blockquote {
    position: relative;
    text-align: center;
  }
  .about__motto p {
    max-width: 18ch;
    margin-inline: auto;
    font-size: clamp(2rem, 1rem + 3.6vw, 4.6rem);
    font-weight: 500;
    font-stretch: 82%;
    line-height: 1;
    text-shadow: 0 2px 30px rgb(15 14 13 / 0.9);
  }
  .about__motto p::before {
    content: '« ';
    color: var(--accent);
  }
  .about__motto p::after {
    content: ' »';
    color: var(--accent);
  }
  .about__principles {
    margin-top: clamp(4rem, 10vh, 7rem);
  }
  .princ {
    display: grid;
    /* one to eight principles: as many columns as fit, never fewer than 15rem wide */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--gap);
    margin-top: 1.25rem;
  }
  .princ li {
    position: relative;
    padding: 1.5rem 0 0;
  }
  .princ li::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--rule-strong);
  }
  .princ li::after {
    content: '';
    position: absolute;
    left: 0;
    top: -0.5px;
    height: 2px;
    width: 2.5rem;
    background: var(--c);
    transition: width var(--dur-3) var(--ease);
  }
  .princ li:hover::after {
    width: 100%;
  }
  .princ__n {
    font-size: 2.6rem;
    font-weight: 600;
    font-stretch: 75%;
    color: color-mix(in srgb, var(--c) 62%, #fff); /* text: the dye, lightened to AA contrast */
  }
  .princ__t {
    margin: 0.6rem 0 0.7rem;
    font-size: clamp(1.4rem, 1.1rem + 0.8vw, 1.9rem);
    font-weight: 600;
    font-stretch: 82%;
    line-height: 1;
  }
  .princ p {
    font-size: 0.9375rem;
  }
  @media (max-width: 63.99rem) {
    .about__intro,
    .about__bio {
      grid-column: 1 / -1;
    }
    .about__photo {
      grid-column: 1 / span 5;
      grid-row: auto;
    }
    .princ {
      row-gap: 2.5rem;
    }
  }
  @media (max-width: 47.99rem) {
    .about__photo {
      grid-column: 1 / span 9;
    }
  }
</style>
