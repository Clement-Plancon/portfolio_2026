---
import { paragraphs } from '../lib/content';
import type { MediaResolver } from '../lib/media';
import type { Profile } from '../lib/schemas';

interface Props {
  profile: Profile;
  media: MediaResolver;
}
const { profile, media } = Astro.props;
const bio = paragraphs(profile.bio);
// The last paragraph of the biography is set apart, as a motto.
const motto = bio.length > 1 ? bio.at(-1) : undefined;
const body = motto ? bio.slice(0, -1) : bio;
const photo = profile.photo ? media(profile.photo.src) : undefined;
const ROMAN = ['i', 'ii', 'iii', 'iv', 'v', 'vi', 'vii', 'viii'];
---

<section class="about section" id="a-propos" aria-labelledby="about-title">
  <div class="wrap">
    <header class="sec-head">
      <h2 id="about-title">À propos</h2>
      <p class="label">{profile.location}</p>
    </header>

    <div class="about__grid grid">
      <p class="about__intro lede" data-reveal>{profile.intro}</p>
      {
        photo && profile.photo && (
          <figure class="about__photo" data-reveal>
            <img src={photo.src} alt={profile.photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
          </figure>
        )
      }
      <div class="about__bio" data-reveal>
        {body.map((p) => <p>{p}</p>)}
      </div>
      {
        motto && (
          <blockquote class="about__motto" data-reveal>
            <p class="serif">{motto}</p>
          </blockquote>
        )
      }
    </div>

    {
      profile.principles.length > 0 && (
        <div class="about__principles">
          <h3 class="label">Ma façon de travailler</h3>
          <ol role="list" class="princ">
            {profile.principles.map((p, i) => (
              <li data-reveal style={`--d:${i}`}>
                <span class="princ__n serif" aria-hidden="true">
                  {ROMAN[i]}.
                </span>
                <h4 class="princ__t serif">{p.title}</h4>
                <p class="muted">{p.text}</p>
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </div>
</section>

<style>
  .about__grid {
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    row-gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  .about__intro {
    grid-column: 1 / span 9;
  }
  .about__photo {
    grid-column: 10 / span 3;
    grid-row: 1;
  }
  .about__photo img {
    width: 100%;
    filter: grayscale(1) contrast(1.05);
  }
  .about__bio {
    grid-column: 5 / span 8;
    grid-row: 2;
    columns: 2 16rem;
    column-gap: var(--gap);
    color: var(--fg-2);
  }
  .about__bio p {
    break-inside: avoid;
    margin-bottom: 1em;
  }
  /* The motto stands in the left margin, beside the biography, as a pull quote. */
  .about__motto {
    grid-column: 1 / span 3;
    grid-row: 2;
    padding-top: 0.9rem;
    border-top: 1px solid var(--accent);
  }
  .about__motto p {
    font-style: italic;
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
    line-height: 1.3;
  }
  .about__principles {
    margin-top: clamp(4rem, 8vw, 7rem);
  }
  .princ {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
    margin-top: 1rem;
  }
  .princ li {
    padding-top: 1rem;
    border-top: 1px solid var(--rule-strong);
  }
  .princ__n {
    font-style: italic;
    font-size: 1.35rem;
    color: var(--accent);
  }
  .princ__t {
    margin: 0.75rem 0 0.6rem;
    font-weight: 400;
    font-size: clamp(1.3rem, 1.1rem + 0.5vw, 1.6rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .princ p {
    font-size: 0.9375rem;
  }
  @media (max-width: 63.99rem) {
    .about__intro {
      grid-column: 1 / -1;
    }
    .about__photo {
      grid-column: 1 / span 4;
      grid-row: auto;
    }
    .about__bio {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .about__motto {
      grid-column: 1 / span 8;
      grid-row: auto;
    }
    .princ {
      grid-template-columns: 1fr 1fr;
      row-gap: 2rem;
    }
  }
  @media (max-width: 47.99rem) {
    .about__photo {
      grid-column: 1 / span 8;
    }
    .princ {
      grid-template-columns: 1fr;
    }
  }
</style>
