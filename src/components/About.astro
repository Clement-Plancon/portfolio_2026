---
// « À propos », on ink: who you are in a few lines (the introduction from the profile), the current
// position, two or three domains of expertise (the first skill groups), the path in a compact list and
// the CV. The biography and the principles are there too, folded. The path and the skills are told here;
// when « à propos » is hidden, the same component tells the path alone (with the skills), under its
// own title. Every part is optional: an empty one leaves no gap.
import Arrow from './Arrow.astro';
import Media from './Media.astro';
import { paragraphs } from '../lib/content';
import type { ExperienceEntry } from '../lib/content';
import { formatPeriod } from '../lib/format';
import type { MediaResolver } from '../lib/media';
import type { Profile, Skills } from '../lib/schemas';
import type { Resolved, ResolvedSection } from '../lib/site';
import { displaySize } from '../lib/poster';

interface Props {
  section: ResolvedSection;
  profile: Profile;
  skills: Skills;
  site: Resolved;
  cvUrl?: string;
  media: MediaResolver;
}
const { section, profile, skills, site, cvUrl, media } = Astro.props;
const isAbout = section.id === 'a-propos';
const showPath = section.id === 'parcours' || section.holds.includes('parcours');
const showSkills = section.id === 'competences' || section.holds.includes('competences');
const bio = isAbout ? paragraphs(profile.bio) : [];
const principles = isAbout && site.site.about.showPrinciples ? profile.principles : [];
const domains = showSkills ? skills.groups.slice(0, 3) : [];
const moreSkills = showSkills ? skills.groups.slice(3) : [];
const pathSettings = site.settings('parcours');
const skillSettings = site.settings('competences');
const years = (e: ExperienceEntry) => formatPeriod(e.start.slice(0, 4), e.end?.slice(0, 4), !e.end);
const pad = (n: number) => String(n).padStart(2, '0');
const current = isAbout ? site.current : undefined;
---

<section class="about part tone-ink" id={section.id} aria-labelledby={`${section.id}-title`} data-tone="ink" data-part>
  <div class="wrap">
    <header class:list={['about__head', { 'about__head--photo': isAbout && profile.photo }]}>
      <h2 id={`${section.id}-title`} class="about__title display" style={`--size:${displaySize(section.title, 13, isAbout && profile.photo ? 64 : 84)}`}>{section.title}</h2>
      {section.intro && <p class="about__sub">{section.intro}</p>}
      {
        isAbout && profile.photo && (
          <div class="about__photo" data-reveal>
            <Media src={profile.photo.src} alt={profile.photo.alt} media={media} />
          </div>
        )
      }
    </header>

    {isAbout && profile.intro && <p class="about__intro" data-reveal>{profile.intro}</p>}

    {
      (current || cvUrl) && isAbout && (
        <div class="about__now" data-reveal>
          {current && (
            <p class="about__current">
              <span class="label">Aujourd'hui</span>
              <span class="about__role">{current.role}</span>
              <span class="about__org">
                {current.organisation}
                {current.parentOrganisation && ` — ${current.parentOrganisation}`}
              </span>
            </p>
          )}
          {cvUrl && (
            <a class="btn btn--fill about__cv" href={cvUrl}>
              Télécharger le CV <Arrow dir="down" />
            </a>
          )}
        </div>
      )
    }

    {
      domains.length > 0 && (
        <div class="about__block" id={section.id === 'competences' ? undefined : 'competences'}>
          <h3 class="about__h label">{skillSettings.title}</h3>
          {section.id !== 'competences' && skillSettings.intro && <p class="about__blocklead">{skillSettings.intro}</p>}
          <ol role="list" class="domains" style={`--n:${domains.length}`}>
            {domains.map((g, i) => (
              <li class="domain" data-reveal style={`--d:${i}`}>
                <span class="domain__n" aria-hidden="true">
                  {pad(i + 1)}
                </span>
                <h4 class="domain__name">{g.name}</h4>
                {g.description && <p class="domain__text">{g.description}</p>}
                {g.items.length > 0 && <p class="domain__items">{g.items.slice(0, 8).join(' · ')}</p>}
              </li>
            ))}
          </ol>
          {moreSkills.length > 0 && (
            <details class="fold">
              <summary class="fold__sum">Toutes les compétences ({skills.groups.length} domaines)</summary>
              <dl class="fold__skills">
                {moreSkills.map((g) => (
                  <div>
                    <dt>{g.name}</dt>
                    <dd class="muted">{g.items.join(' · ')}</dd>
                  </div>
                ))}
              </dl>
            </details>
          )}
        </div>
      )
    }

    {
      showPath && (site.chapters.length > 0 || site.rest.length > 0) && (
        <div class="about__block" id={section.id === 'parcours' ? undefined : 'parcours'}>
          <h3 class="about__h label">{section.id === 'parcours' ? 'Postes' : pathSettings.title}</h3>
          {section.id !== 'parcours' && pathSettings.intro && <p class="about__blocklead">{pathSettings.intro}</p>}
          <ol role="list" class="path">
            {site.chapters.map((e) => (
              <li class:list={['path__row', { 'path__row--now': !e.end }]}>
                <span class="path__years">{years(e)}</span>
                <span class="path__role">{e.role}</span>
                <span class="path__org">{e.organisation}</span>
              </li>
            ))}
          </ol>
          {site.rest.length > 0 && (
            <details class="fold">
              <summary class="fold__sum">
                Tout le parcours (+{site.rest.length} poste{site.rest.length > 1 ? 's' : ''})
              </summary>
              <ol role="list" class="path path--rest">
                {site.rest.map((e) => (
                  <li class="path__row">
                    <span class="path__years">{years(e)}</span>
                    <span class="path__role">{e.role}</span>
                    <span class="path__org">{e.organisation}</span>
                  </li>
                ))}
              </ol>
            </details>
          )}
        </div>
      )
    }

    {
      (bio.length > 0 || principles.length > 0) && (
        <details class="fold fold--bio">
          <summary class="fold__sum">En savoir plus</summary>
          <div class="fold__bio">
            {bio.map((p) => <p>{p}</p>)}
            {principles.length > 0 && (
              <>
                <h3 class="about__h label">{site.site.about.principlesTitle ?? 'Ma façon de travailler'}</h3>
                <ol role="list" class="princ">
                  {principles.map((p) => (
                    <li>
                      <h4>{p.title}</h4>
                      <p class="muted">{p.text}</p>
                    </li>
                  ))}
                </ol>
              </>
            )}
          </div>
        </details>
      )
    }
  </div>
</section>

<style>
  .about {
    padding-block: clamp(4rem, 9vw, 9rem);
  }
  .about__head {
    display: grid;
    gap: 1rem;
    align-items: end;
  }
  .about__head--photo {
    grid-template-columns: minmax(0, 1fr) clamp(7rem, 16vw, 14rem);
  }
  .about__title {
    font-size: min(11rem, calc(var(--size) * 1vw));
    line-height: 0.8;
    letter-spacing: -0.045em;
    overflow-wrap: anywhere;
  }
  .about__sub {
    max-width: 36rem;
    color: var(--fg-2);
    grid-column: 1;
  }
  .about__photo {
    grid-row: 1 / span 2;
    grid-column: 2;
    rotate: -4deg;
    background: var(--paper);
    padding: 5%;
  }
  .about__photo :global(img) {
    border-radius: 0;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  /* The introduction: large, in the reader's voice. */
  .about__intro {
    margin-top: clamp(2rem, 5vw, 4.5rem);
    max-width: 22em;
    font-size: clamp(1.6rem, 1rem + 2.6vw, 3.75rem);
    font-weight: 600;
    font-stretch: 88%;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .about__now {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-block: 1.5rem;
    border-block: 2px solid var(--fg);
  }
  .about__current {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }
  .about__current .label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
  }
  .about__current .label::before {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: currentColor;
  }
  :global(.motion) .about__current .label::before {
    animation: beat 2.4s ease-in-out infinite;
  }
  @keyframes beat {
    50% {
      transform: scale(0.5);
    }
  }
  .about__role {
    font-size: clamp(1.25rem, 1rem + 1vw, 2rem);
    font-weight: 800;
    line-height: 1.1;
  }
  .about__org {
    color: var(--fg-2);
  }

  .about__block {
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }
  .about__h {
    color: var(--fg-2);
    margin-bottom: 1.25rem;
  }
  .about__blocklead {
    max-width: 36rem;
    margin: -0.5rem 0 1.5rem;
    color: var(--fg-2);
  }

  /* Domains: three columns, the number in vermilion. */
  .domains {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: var(--gap) clamp(1rem, 3vw, 3rem);
  }
  .domain {
    border-top: 2px solid var(--fg);
    padding-top: 1rem;
    min-width: 0;
  }
  .domain__n {
    display: block;
    font-size: clamp(3rem, 1.5rem + 4vw, 6rem);
    font-weight: 900;
    font-stretch: 62%;
    line-height: 0.85;
    color: var(--accent);
  }
  .domain__name {
    margin-top: 0.75rem;
    font-size: clamp(1.375rem, 1rem + 1vw, 2rem);
    font-weight: 800;
    font-stretch: 110%;
    text-transform: uppercase;
    line-height: 0.95;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .domain__text {
    margin-top: 0.75rem;
    color: var(--fg-2);
  }
  .domain__items {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    font-stretch: 85%;
  }

  /* The path: one line per position. */
  .path__row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding-block: 1rem;
    border-top: 1px solid var(--rule);
  }
  .path__row:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .path__years {
    font-size: 0.875rem;
    font-weight: 700;
    font-stretch: 80%;
    letter-spacing: 0.04em;
    color: var(--fg-2);
  }
  .path__row--now .path__years {
    color: var(--accent);
  }
  .path__role {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.375rem);
    font-weight: 700;
    line-height: 1.2;
  }
  .path__org {
    color: var(--fg-2);
  }

  /* Folded parts. */
  .fold {
    margin-top: 1.5rem;
  }
  .fold--bio {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .fold__sum {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0.6rem 1.3rem;
    border: 2px solid currentColor;
    border-radius: var(--radius);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    transition:
      background var(--dur-1),
      color var(--dur-1);
  }
  .fold__sum::-webkit-details-marker {
    display: none;
  }
  .fold__sum::after {
    content: '+';
    font-size: 1.4em;
    line-height: 0.7;
    transition: rotate var(--dur-2) var(--spring);
  }
  .fold[open] > .fold__sum::after {
    rotate: 45deg;
  }
  .fold__sum:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .fold__bio {
    max-width: 44rem;
    margin-top: 2rem;
    display: grid;
    gap: 1rem;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
  }
  .fold__bio .about__h {
    margin: 1.5rem 0 0;
  }
  .princ {
    display: grid;
    gap: 1.25rem;
  }
  .princ h4 {
    font-weight: 800;
    font-size: 1.125rem;
  }
  .fold__skills {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .fold__skills dt {
    font-weight: 800;
  }
  .path--rest {
    margin-top: 1rem;
  }

  @media (max-width: 61.99rem) {
    .domains {
      grid-template-columns: minmax(0, 1fr);
    }
    .domain {
      display: grid;
      grid-template-columns: 4.5rem minmax(0, 1fr);
      column-gap: 1rem;
    }
    .domain__n {
      grid-row: span 3;
      font-size: 3.5rem;
    }
    .domain__name {
      margin-top: 0;
    }
  }
  @media (max-width: 47.99rem) {
    .path__row {
      grid-template-columns: minmax(0, 1fr);
    }
    .about__head--photo {
      grid-template-columns: minmax(0, 1fr) 6.5rem;
    }
  }
</style>
