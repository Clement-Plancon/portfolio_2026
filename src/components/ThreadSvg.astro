---
// The threads drawn by the server, as SVG: the first image of every stage (before WebGL starts) and
// the image that stays when WebGL is unavailable, too slow, or when motion is reduced.
// Same shapes as the WebGL scene (src/lib/threads.ts), seen from the front.
import { gather, motif, type Motif, svgPath, tangle, warp } from '../lib/threads';

interface Props {
  kind: 'hero' | 'project' | 'warp' | 'gather';
  /** Thread colours, one per project, in page order. */
  colors: string[];
  /** project: the thread that draws the motif, and the motif. */
  strand?: number;
  motif?: Motif;
  class?: string;
  /** id of the motif's path, to be reused elsewhere (<use>). */
  id?: string;
}
const { kind, colors, strand = 0, motif: m = 'noeud', class: cls, id } = Astro.props;
// Points per thread: enough for a smooth curve at full size, no more (the HTML carries them).
const n = kind === 'hero' ? 260 : kind === 'project' ? 150 : 70;
const S = colors.length || 1;
type Line = { d: string; color: string; width: number; opacity: number; id?: string };
const lines: Line[] = [];
let viewBox = '-1 -1 2 2';
if (kind === 'hero') {
  // Same scale as the WebGL scene: the stage's half width is 1.45 units of the tangle; the loose ends run past the stage.
  viewBox = '-1 -0.62 2 1.24';
  colors.forEach((c, s) => lines.push({ d: svgPath(tangle(s, S, n), 1 / 1.45), color: c, width: 0.01, opacity: 0.95 }));
} else if (kind === 'project') {
  colors.forEach((c, s) => {
    if (s !== strand) lines.push({ d: svgPath(warp(s, S, 36, 0, 0.1).map(([x, y, z]) => [x * 1.4, y - 1.05, z]), 1), color: c, width: 0.006, opacity: 0.35 });
  });
  lines.push({ d: svgPath(motif(m, n), 0.8), color: colors[strand] ?? '#f1ebe2', width: 0.03, opacity: 1, id });
} else if (kind === 'warp') {
  viewBox = '-1.6 -0.6 3.2 1.2';
  colors.forEach((c, s) => lines.push({ d: svgPath(warp(s, S, n, 0, 0.22), 1), color: c, width: 0.008, opacity: 0.6 }));
} else {
  // Seen in a mirror, as in the scene: the single thread under the address (x 0 → 1.4 from its right
  // end), the fan opening to the right.
  viewBox = '-1.4 -0.6 3.4 1.2';
  colors.forEach((c, s) => lines.push({ d: svgPath(gather(s, S, n).map(([x, y, z]) => [-x, y, z]), 1), color: c, width: 0.012, opacity: 0.9 }));
}
---

<svg class:list={['stage-svg', cls]} viewBox={viewBox} preserveAspectRatio="xMidYMid meet" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {lines.map((l, k) => <path id={l.id} d={l.d} stroke={l.color} stroke-width={l.width} opacity={l.opacity} pathLength="1" style={`--k:${k}`} />)}
</svg>
