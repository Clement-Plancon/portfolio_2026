---
// The last act — contact. The threads come in from the right, gather, and go on as one under the
// address. Title, sentence and button from the admin (Site → Contact); address and links from the profile.
import type { Profile, Site } from '../lib/schemas';
import type { ResolvedSection } from '../lib/site';
import Arrow from './Arrow.astro';
import ThreadSvg from './ThreadSvg.astro';

interface Props {
  section: ResolvedSection;
  profile: Profile;
  site: Site;
  cvUrl?: string;
  threads: string[];
  glow: string;
}
const { section, profile, site, cvUrl: cv, threads: colors, glow } = Astro.props;
const lead = site.contact.lead ?? `Un projet, une équipe à renforcer, une question technique : écrivez-moi, je réponds par e-mail. ${profile.location}.`;
const [user, domain] = profile.email.split('@');
const github = profile.socials.find((s) => /github/i.test(s.label));
const linkedin = profile.socials.find((s) => /linkedin/i.test(s.label));
const others = profile.socials.filter((s) => s !== github && s !== linkedin);
---

<section class="contact" id="contact" aria-labelledby="contact-title" data-scene="gather" data-glow={glow} data-act={`${section.act} — ${section.actName}`}>
  <div class="contact__in wrap">
    <p class="act label"><span><span class="act__n">{section.act}</span> {section.actName}</span></p>
    <h2 id="contact-title" class:list={['contact__title display', { 'contact__title--long': section.title.length > 30 }]}>{section.title}</h2>
    {lead && <p class="contact__lead">{lead}</p>}

    <div class="contact__mailbox">
      <a class="contact__mail display" href={`mailto:${profile.email}`}>
        <span>{user}</span><wbr /><span>@{domain}</span>
      </a>
      <div class="contact__stage" data-stage>
        <ThreadSvg kind="gather" colors={colors} class="contact__svg" />
      </div>
    </div>

    <div class="contact__row">
      <div class="contact__copy">
        <button class="btn btn--fill" type="button" data-copy={profile.email} hidden>{site.contact.copyLabel ?? "Copier l'adresse"}</button>
        <span class="contact__status label" role="status" data-copy-status></span>
      </div>
      <ul role="list" class="contact__links">
        {
          github && (
            <li>
              <a class="btn" href={github.url} rel="me noopener">
                {github.label} <Arrow dir="out" />
              </a>
            </li>
          )
        }
        {
          linkedin && (
            <li>
              <a class="btn" href={linkedin.url} rel="me noopener">
                {linkedin.label} <Arrow dir="out" />
              </a>
            </li>
          )
        }
        {
          others.map((s) => (
            <li>
              <a class="btn" href={s.url} rel="me noopener">
                {s.label} <Arrow dir="out" />
              </a>
            </li>
          ))
        }
        {
          cv && (
            <li>
              <a class="btn" href={cv}>
                CV (PDF)
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* the fan of threads runs past the screen: clipped, never scrolled */
  .contact {
    overflow-x: clip;
  }
  .contact__in {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: max(36rem, 100svh);
    padding-top: clamp(6rem, 14vh, 10rem);
    padding-bottom: 4rem;
  }
  .contact__title {
    margin-top: 2rem;
    max-width: 12ch;
    font-size: clamp(3rem, 1rem + 6.4vw, 8.5rem);
    font-stretch: 76%;
    font-weight: 650;
    line-height: 0.86;
  }
  .contact__title {
    overflow-wrap: break-word;
    hyphens: manual;
  }
  .contact__title--long {
    font-size: clamp(2.4rem, 1rem + 4.2vw, 6rem);
  }
  .contact__lead {
    max-width: 34em;
    margin-top: 1.5rem;
    color: var(--fg-2);
    font-size: 1.0625rem;
  }
  .contact__mailbox {
    position: relative;
    margin-top: clamp(2.5rem, 6vh, 4rem);
    align-self: flex-start;
    max-width: 100%;
  }
  .contact__mail {
    position: relative;
    z-index: 1;
    display: inline-block;
    font-size: clamp(1.9rem, 0.6rem + 5.4vw, 6.4rem);
    font-weight: 500;
    font-stretch: 82%;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--dur-2);
  }
  .contact__mail:hover {
    color: var(--accent);
  }
  .contact__mail span {
    white-space: nowrap;
  }
  /* the single thread runs under the address; the six come from the left of it */
  .contact__stage {
    position: relative;
    height: 2px;
    margin-top: 0.6rem;
    pointer-events: none;
  }
  .contact__stage :global(.contact__svg) {
    width: 242.86%;
    height: auto;
    aspect-ratio: 3.4 / 1.2;
    inset: 50% auto auto 0;
    transform: translateY(-50%);
  }
  .contact__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: clamp(2.5rem, 6vh, 4rem);
  }
  .contact__copy {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .contact__links .arrow {
    width: 0.75em;
  }
  @media (max-width: 47.99rem) {
    .contact__in {
      min-height: max(34rem, calc(100svh - var(--bar-h)));
    }
    .contact__links,
    .contact__links li,
    .contact__copy {
      width: 100%;
    }
    .contact__links .btn,
    .contact__copy .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
