---
// The contact, on vermilion: a title, a sentence, the e-mail address in giant capitals (a link; a button
// copies it), then GitHub, LinkedIn and the other links of the profile. Title, sentence and button from
// the admin (Site → Contact); address and links from the profile.
import Arrow from './Arrow.astro';
import type { Profile, Site } from '../lib/schemas';
import type { ResolvedSection } from '../lib/site';
import { displaySize } from '../lib/poster';

interface Props {
  section: ResolvedSection;
  profile: Profile;
  site: Site;
  cvUrl?: string;
}
const { section, profile, site, cvUrl: cv } = Astro.props;
const lead = site.contact.lead ?? `Un projet, une équipe à renforcer, une question technique : écrivez-moi, je réponds par e-mail.`;
const [user, domain] = profile.email.split('@');
// one size for the address, so that its longer half fills the width (capitals at 100 % ≈ 0.68 em)
const longest = Math.max(user.length, domain.length + 1);
const mailSize = Math.min(13, 92 / (longest * 0.68));
const github = profile.socials.find((s) => /github/i.test(s.label));
const linkedin = profile.socials.find((s) => /linkedin/i.test(s.label));
const links = [github, linkedin, ...profile.socials.filter((s) => s !== github && s !== linkedin)].filter((s): s is NonNullable<typeof s> => !!s);
---

<section class="contact part tone-vermilion" id="contact" aria-labelledby="contact-title" data-tone="vermilion" data-part>
  <div class="contact__in wrap">
    <h2 id="contact-title" class="contact__title display" style={`--size:${displaySize(section.title, 12, 86)}`}>{section.title}</h2>
    {lead && <p class="contact__lead lede">{lead}</p>}

    <a class="contact__mail" href={`mailto:${profile.email}`} style={`--size:${mailSize.toFixed(2)}`}>
      <span>{user}</span><wbr /><span>@{domain}</span>
    </a>

    <div class="contact__row">
      <p class="contact__copy">
        <button class="btn btn--fill" type="button" data-copy={profile.email} hidden>{site.contact.copyLabel ?? "Copier l'adresse"}</button>
        <span class="contact__status label" role="status" data-copy-status></span>
      </p>
      {
        (links.length > 0 || cv) && (
          <ul role="list" class="contact__links">
            {links.map((s) => (
              <li>
                <a class="contact__link" href={s.url} rel="me noopener">
                  <span>{s.label}</span> <Arrow dir="out" />
                </a>
              </li>
            ))}
            {cv && (
              <li>
                <a class="contact__link" href={cv}>
                  <span>CV</span> <Arrow dir="down" />
                </a>
              </li>
            )}
          </ul>
        )
      }
    </div>
  </div>
</section>

<style>
  .contact {
    overflow: clip;
  }
  .contact__in {
    padding-block: clamp(4rem, 9vw, 9rem) clamp(3rem, 6vw, 6rem);
  }
  .contact__title {
    font-size: min(10rem, calc(var(--size) * 1vw));
    line-height: 0.82;
    letter-spacing: -0.045em;
  }
  .contact__lead {
    margin-top: 1.5rem;
    max-width: 30rem;
  }
  /* The address: as wide as the page. */
  .contact__mail {
    display: block;
    margin-top: clamp(2.5rem, 6vw, 5rem);
    font-size: calc(var(--size) * 1vw);
    font-weight: 800;
    font-stretch: 100%;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .contact__mail span {
    display: inline-block;
    transition: translate var(--dur-2) var(--spring);
  }
  .contact__mail span + span {
    color: var(--paper);
  }
  .contact__mail:hover span:first-child {
    translate: 0.15em 0;
  }
  .contact__mail:hover span + span {
    translate: -0.1em 0;
  }
  .contact__mail:focus-visible {
    outline-offset: 8px;
  }
  .contact__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 3px solid var(--ink);
  }
  .contact__copy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.25rem;
  }
  .contact__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 3rem;
    font-size: clamp(1.375rem, 1rem + 1.2vw, 2.25rem);
    font-weight: 800;
    font-stretch: 110%;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .contact__link span {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 0.12em no-repeat;
    transition: background-size var(--dur-2) var(--ease);
  }
  .contact__link:hover span {
    background-size: 100% 0.12em;
  }
  @media (max-width: 47.99rem) {
    .contact__row {
      flex-direction: column;
      align-items: stretch;
    }
    .contact__copy .btn {
      width: 100%;
    }
  }
</style>
