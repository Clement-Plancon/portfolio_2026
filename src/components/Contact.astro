---
import type { Profile } from '../lib/schemas';
import Arrow from './Arrow.astro';

interface Props {
  profile: Profile;
  cvUrl?: string;
}
const { profile } = Astro.props;
// A CV from the media library is resolved by the page (published file, or private file in the preview).
const cv = profile.cv ? (profile.cv.startsWith('files/') ? Astro.props.cvUrl : profile.cv) : undefined;
const [user, domain] = profile.email.split('@');
---

<section class="contact section" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <header class="sec-head">
      <h2 id="contact-title">Contact</h2>
      <p class="label">{profile.location} · réponse par e-mail</p>
    </header>

    <p class="contact__lead lede" data-reveal>Un projet, une opportunité, une question technique&#8239;? <em>Écrivez-moi.</em></p>

    <a class="contact__mail display" href={`mailto:${profile.email}`} data-reveal>
      <span>{user}</span><wbr /><span>@{domain}</span>
    </a>

    <div class="contact__row">
      <div class="contact__copy">
        <button class="contact__btn" type="button" data-copy={profile.email} hidden>Copier l'adresse</button>
        <span class="contact__status label" role="status"></span>
      </div>
      <ul role="list" class="contact__links">
        {
          profile.socials.map((s) => (
            <li>
              <a class="link" href={s.url} rel="me noopener">
                {s.label} <Arrow dir="out" />
              </a>
            </li>
          ))
        }
        {
          cv && (
            <li>
              <a class="link" href={cv}>
                CV (PDF)
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .contact__lead {
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    max-width: 18em;
  }
  .contact__mail {
    display: inline-block;
    margin-top: clamp(2rem, 5vw, 4rem);
    font-size: clamp(2.4rem, 0.4rem + 7.4vw, 9.5rem);
    font-style: italic;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--accent);
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    padding-bottom: 0.08em;
    transition: background-size var(--dur-3) var(--ease);
  }
  .contact__mail:hover {
    background-size: 100% 1px;
  }
  .contact__mail span {
    white-space: nowrap;
  }
  .contact__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .contact__copy {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .contact__btn {
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border: 1px solid var(--rule-strong);
    border-radius: 99px;
    font-size: 0.9rem;
    transition:
      background var(--dur-1),
      color var(--dur-1);
  }
  .contact__btn:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }
  .contact__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
  }
  .contact__links .arrow {
    width: 0.7em;
  }
</style>
