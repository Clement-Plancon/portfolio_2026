---
import type { Profile } from '../lib/schemas';

interface Props {
  profile: Profile;
  cvUrl?: string;
}
const { profile } = Astro.props;
const [first, ...rest] = profile.name.split(' ');
// A CV from the media library is resolved by the page (published file, or private file in the preview).
const cv = profile.cv ? (profile.cv.startsWith('files/') ? Astro.props.cvUrl : profile.cv) : undefined;
---

<section class="contact section" id="contact" aria-labelledby="contact-title">
  <div class="wrap contact__grid">
    <div class="contact__text" data-fold>
      <h2 id="contact-title" class="display">Contact</h2>
      <p class="lead">Le dépliant se referme ici. Pour un projet, une opportunité ou un sujet technique, écrivez-moi.</p>
      <p class="contact__where label">{profile.location} · réponse par e-mail</p>
    </div>

    <div class="card" data-card>
      <div class="card__front">
        <p class="label">Carte de visite</p>
        <p class="card__name display" aria-hidden="true"><span>{first}</span> <span>{rest.join(' ')}</span></p>
        <p class="card__role">{profile.jobTitle}</p>
      </div>
      <div class="card__back">
        <a class="card__mail" href={`mailto:${profile.email}`}>{profile.email}</a>
        <div class="card__actions">
          <button class="card__copy label" type="button" data-copy={profile.email} hidden>Copier l'adresse</button>
          <span class="card__status" role="status"></span>
        </div>
        <ul role="list" class="card__links">
          {
            profile.socials.map((s) => (
              <li>
                <a class="link" href={s.url} rel="me noopener">
                  {s.label} ↗
                </a>
              </li>
            ))
          }
          {
            cv && (
              <li>
                <a class="link" href={cv}>
                  CV (PDF)
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: clamp(4rem, 8vw, 8rem);
  }
  .contact__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.5rem;
    row-gap: 2.5rem;
    align-items: end;
  }
  .contact__grid::before {
    content: '';
    grid-column: 1 / -1;
    height: 1px;
    margin-bottom: clamp(0rem, 1vw, 0.5rem);
    background: var(--crease);
  }
  .contact__text {
    grid-column: 1 / span 5;
    transform-origin: 50% 100%;
  }
  .contact__text h2 {
    font-size: clamp(3.4rem, 1.6rem + 7.4vw, 8.5rem);
  }
  .contact__text .lead {
    margin-top: 1.5rem;
    max-width: 24ch;
  }
  .contact__where {
    margin-top: 1.5rem;
    color: var(--ink-2);
  }
  :global(.motion) .contact__text[data-fold]:not(.is-flat) {
    transform: perspective(1200px) rotateX(-62deg);
    opacity: 0;
  }

  /* A business card folded in two: it opens when it comes into view. */
  .card {
    grid-column: 7 / -1;
    perspective: 1600px;
  }
  .card__front,
  .card__back {
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .card__front {
    position: relative;
    background: var(--signal);
    color: var(--on-signal);
    transform-origin: 50% 100%;
    backface-visibility: hidden;
  }
  .card__front::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(rgb(0 0 0 / 0.35), rgb(0 0 0 / 0));
    opacity: 0;
  }
  .card__name {
    margin-top: 1rem;
    font-size: clamp(3rem, 1.6rem + 4.6vw, 6rem);
    line-height: 0.82;
  }
  .card__name span {
    display: block;
  }
  .card__role {
    margin-top: 1rem;
    font-weight: 560;
  }
  .card__back {
    background: var(--ink);
    color: var(--paper);
  }
  .card__mail {
    display: inline-block;
    font-size: clamp(1.3rem, 0.8rem + 2.2vw, 2.5rem);
    font-weight: 700;
    font-stretch: 90%;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0% 2px;
    padding-bottom: 0.15em;
    transition: background-size var(--dur-2) var(--ease);
  }
  .card__mail:hover,
  .card__mail:focus-visible {
    background-size: 100% 2px;
  }
  .card__back :focus-visible {
    outline-color: var(--paper);
  }
  .card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 1.25rem;
  }
  .card__copy {
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1.5px solid currentColor;
    transition:
      background-color var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease);
  }
  .card__copy:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .card__status {
    font-size: 0.875rem;
  }
  .card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin-top: 1.5rem;
    font-weight: 620;
  }
  .card__links a {
    display: inline-block;
    padding-block: 0.35rem;
  }

  :global(.motion) .card__front {
    transition: transform 1.2s var(--ease-fold);
  }
  :global(.motion) .card__front::after {
    transition: opacity 1.2s var(--ease-fold);
  }
  :global(.motion) .card:not(.is-flat) .card__front {
    transform: rotateX(-178deg);
  }
  :global(.motion) .card:not(.is-flat) .card__front::after {
    opacity: 1;
  }

  @media (max-width: 56.24rem) {
    .contact__text,
    .card {
      grid-column: 1 / -1;
    }
  }
</style>
