---
// Main navigation as a row of sign panels. The current page's panel turns signal yellow:
// "you are here". On phones this row is reduced to the name; the tab bar takes over.
import Name from './Name.astro';
import Pictogram, { type PictogramName } from './Pictogram.astro';

interface Props {
  name: string;
  status?: string;
  showArticles: boolean;
}
const { name, status, showArticles } = Astro.props;
const path = Astro.url.pathname;

const links: { href: string; label: string; icon: PictogramName }[] = [
  { href: '/projets/', label: 'Projets', icon: 'projets' },
  { href: '/parcours/', label: 'Parcours', icon: 'parcours' },
  { href: '/a-propos/', label: 'À propos', icon: 'apropos' },
  ...(showArticles ? [{ href: '/articles/', label: 'Articles', icon: 'articles' as const }] : []),
];
const here = (href: string) => path.startsWith(href);
---

<header class="nav-wrap">
  <nav class="wrap nav" aria-label="Navigation principale">
    <a class="nav__name" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <span><Name text={name} /></span>
    </a>
    {
      links.map((l) => (
        <a class="nav__item" href={l.href} aria-current={here(l.href) ? 'page' : undefined}>
          <span class="plate">
            <Pictogram name={l.icon} size={18} />
          </span>
          {l.label}
        </a>
      ))
    }
    <span class="nav__status" aria-hidden="true">{status}</span>
    <a class="nav__item nav__item--exit" href="/contact/" aria-current={here('/contact/') ? 'page' : undefined}>
      Contact
      <span class="plate plate--arrow">→</span>
    </a>
  </nav>
</header>

<style>
  .nav-wrap {
    padding-top: var(--joint);
    view-transition-name: site-nav;
  }
  .nav {
    display: flex;
    gap: var(--joint);
  }
  .nav > * {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--nav-h);
    padding: 0 1rem;
    background: var(--panel);
    color: var(--on-panel);
    border-radius: var(--radius);
    font-weight: 800;
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__name {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }
  .nav__status {
    flex: 1;
    justify-content: flex-end;
    min-width: 0;
    overflow: hidden;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.8125rem;
    color: var(--on-panel-2);
  }
  .nav__status::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal);
    flex: none;
  }
  .plate {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 3px;
    background: var(--on-panel);
    color: var(--panel);
    transition: transform var(--dur-2) var(--ease);
  }
  .plate--arrow {
    background: var(--panel-2);
    color: var(--signal);
    font-weight: 900;
  }
  .nav > a:hover .plate {
    transform: translateY(-2px);
  }
  .nav > a:hover .plate--arrow {
    transform: translateX(3px);
  }
  /* You are here */
  .nav > a[aria-current='page'] {
    background: var(--signal);
    color: var(--on-signal);
  }
  .nav > a[aria-current='page'] .plate {
    background: var(--panel);
    color: var(--signal);
  }
  .nav > a:focus-visible {
    box-shadow: 0 0 0 5px var(--ground);
  }
  @media (max-width: 74.99rem) {
    .nav > .nav__status {
      font-size: 0;
      flex: 1;
    }
  }
  @media (max-width: 47.99rem) {
    .nav > .nav__item,
    .nav > .nav__status {
      display: none;
    }
    .nav__name {
      flex: 1;
    }
  }
</style>
