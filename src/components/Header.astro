---
// Desktop header: the name, the sections, and a dot marking where you are. On phones the
// sections move to the tab bar at the bottom of the screen (TabBar.astro).
interface Props {
  name: string;
  showArticles: boolean;
}
const { name, showArticles } = Astro.props;
const path = Astro.url.pathname;
const [first, ...rest] = name.split(' ');

const links = [
  { href: '/projets/', label: 'Projets' },
  { href: '/parcours/', label: 'Parcours' },
  { href: '/a-propos/', label: 'À propos' },
  ...(showArticles ? [{ href: '/articles/', label: 'Articles' }] : []),
  { href: '/contact/', label: 'Contact' },
];
const here = (href: string) => path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="mark" href="/" aria-current={path === '/' ? 'page' : undefined}>
      {first} <em>{rest.join(' ')}</em>
    </a>
    <nav class="nav" aria-label="Navigation principale">
      <ul role="list">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={here(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: var(--header-h);
  }
  .mark {
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  .mark em {
    font-style: italic;
    color: var(--blue);
  }
  .nav ul {
    display: flex;
    gap: clamp(1rem, 0.5rem + 1.5vw, 2.25rem);
  }
  .nav a {
    position: relative;
    display: inline-block;
    padding-block: 0.75rem;
    font-family: var(--sans);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.45rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-2) var(--ease);
  }
  .nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  /* You are here: a blue exposure dot */
  .nav a[aria-current='page'] {
    color: var(--blue);
  }
  .nav a[aria-current='page']::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.1rem;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: currentColor;
  }
  @media (max-width: 47.99rem) {
    .site-header {
      position: relative;
      background: none;
    }
    .nav {
      display: none;
    }
  }
</style>
