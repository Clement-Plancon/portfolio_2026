---
// Skills as a typographic index: one column per field.
import type { Skills } from '../lib/schemas';

interface Props {
  skills: Skills;
}
const { skills } = Astro.props;
---

<div class="skills">
  {
    skills.groups.map((g) => (
      <section class="skills__group" aria-label={g.name}>
        <h3>{g.name}</h3>
        {g.description && <p class="skills__desc">{g.description}</p>}
        <ul role="list">
          {g.items.map((it) => (
            <li>{it}</li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 3rem clamp(2rem, 1rem + 3vw, 4rem);
  }
  .skills__group {
    border-top: 1px solid var(--rule);
    padding-top: 1.25rem;
  }
  .skills__group h3 {
    font-size: var(--step-1);
    font-style: italic;
  }
  .skills__desc {
    margin-top: 0.4rem;
    font-family: var(--sans);
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .skills__group ul {
    margin-top: 1rem;
    display: grid;
    gap: 0.25rem;
    font-size: 1.0625rem;
  }
</style>
