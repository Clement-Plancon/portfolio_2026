---
// Skills as a sign directory: one cell per field, assembled in a grid of panels.
import type { Skills } from '../lib/schemas';

interface Props {
  skills: Skills;
}
const { skills } = Astro.props;
---

<div class="skills">
  {
    skills.groups.map((g) => (
      <section class="panel skills__group" aria-label={g.name}>
        <h3>{g.name}</h3>
        {g.description && <p>{g.description}</p>}
        <ul class="slash-list">
          {g.items.map((it) => (
            <li>{it}</li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .skills {
    display: grid;
    gap: var(--joint);
  }
  @media (min-width: 40rem) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .skills {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .skills__group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  h3 {
    font-size: var(--step-1);
  }
  p {
    font-size: 0.9375rem;
    color: var(--on-panel-2);
  }
  .slash-list {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--panel-line);
    color: var(--signal);
    font-size: 0.875rem;
  }
</style>
