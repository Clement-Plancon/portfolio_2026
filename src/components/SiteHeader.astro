---
// Navigation, always within reach: at the top on larger screens, in a pill at the bottom on phones
// (under the thumb). Its entries are the parts of the page, in the order and with the names set in the
// admin. It takes the colours of the part it is over (src/scripts/site.ts).
import type { ResolvedSection } from '../lib/site';

interface Props {
  name: string;
  sections: ResolvedSection[];
}
const { name, sections } = Astro.props;
---

<header class="top" data-top>
  <div class="top__bar wrap">
    <a class="top__name" href="/#top">{name}</a>
    {
      sections.length > 0 && (
        <nav class="top__nav" id="sommaire" aria-label="Sommaire" style={`--n:${sections.length}`}>
          <ol role="list">
            {sections.map((s) => (
              <li>
                <a href={`/#${s.id}`} data-nav={s.id}>
                  <span class="top__num" aria-hidden="true">
                    {s.n}
                  </span>
                  <span class="top__label">{s.label}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </div>
</header>

<style>
  .top {
    --head-bg: transparent;
    --head-fg: var(--hero-ink);
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--head-fg);
    transition:
      background var(--dur-2) var(--ease),
      color var(--dur-2) var(--ease);
  }
  :global(.is-scrolled) .top {
    background: var(--head-bg);
  }
  .top__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: var(--header-h);
  }
  .top__name {
    font-weight: 800;
    font-stretch: 110%;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .top__nav ol {
    display: flex;
    gap: 0.25rem;
  }
  .top__nav a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    min-height: 2.75rem;
    padding: 0.65rem 0.9rem;
    border-radius: var(--radius);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    transition:
      background var(--dur-1),
      color var(--dur-1);
  }
  .top__num {
    font-size: 0.625rem;
    font-weight: 700;
  }
  .top__nav a:hover {
    background: color-mix(in srgb, currentColor 14%, transparent);
  }
  .top__nav a[aria-current='true'] {
    background: var(--head-fg);
    color: var(--head-solid, var(--hero));
  }
  .top__label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 14ch;
  }

  /* Phones: the parts in a pill at the bottom of the screen. */
  @media (max-width: 47.99rem) {
    .top__nav {
      position: fixed;
      left: 0.75rem;
      right: 0.75rem;
      bottom: max(0.75rem, env(safe-area-inset-bottom));
      z-index: 50;
      padding: 0.3rem;
      border-radius: var(--radius);
      background: var(--ink);
      color: var(--paper);
      box-shadow: 0 0.75rem 2rem -0.5rem rgb(0 0 0 / 0.45);
    }
    .top__nav ol {
      justify-content: space-between;
      gap: 0.2rem;
    }
    .top__nav li {
      flex: 1;
      min-width: 0;
    }
    .top__nav a {
      justify-content: center;
      width: 100%;
      min-width: 0;
      min-height: 3rem;
      padding: 0.5rem 0.4rem;
      font-size: 0.875rem;
    }
    .top__nav a[aria-current='true'] {
      background: var(--paper);
      color: var(--ink);
    }
    .top__num {
      display: none;
    }
    .top__label {
      max-width: 100%;
    }
  }
</style>
