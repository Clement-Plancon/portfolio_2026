---
interface Props {
  name: string;
  nav: boolean;
}
const { name, nav } = Astro.props;

// Projects come first: they are what most visitors came for.
const SECTIONS = [
  { id: 'projets', label: 'Projets' },
  { id: 'a-propos', label: 'À propos' },
  { id: 'parcours', label: 'Parcours' },
  { id: 'competences', label: 'Compétences' },
  { id: 'contact', label: 'Contact' },
];
---

<header class="top" data-top>
  <div class="top__bar wrap">
    <a class="top__name" href="/#top">{name}</a>
    {
      nav && (
        <>
          <button class="top__menu" type="button" aria-expanded="false" aria-controls="sommaire" hidden>
            <span>Sommaire</span>
            <span class="top__burger" aria-hidden="true" />
          </button>
          <nav class="top__nav" id="sommaire" aria-label="Sommaire">
            <ol role="list">
              {SECTIONS.map((s, i) => (
                <li style={`--d:${i}`}>
                  <a href={`/#${s.id}`} data-nav={s.id}>
                    <span class="top__num" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {s.label}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </>
      )
    }
  </div>
</header>

<style>
  .top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition:
      transform var(--dur-2) var(--ease),
      box-shadow var(--dur-2);
  }
  /* The frosted background is a layer of its own: a filter on the header itself would trap the
     phone sheet (position: fixed) inside the header's box. */
  .top::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
  }
  :global(.is-scrolled) .top {
    box-shadow: 0 1px 0 var(--rule);
  }
  :global(.header-hidden) .top {
    transform: translateY(-100%);
  }
  .top__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: var(--header-h);
  }
  .top__name {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    position: relative;
    z-index: 2;
  }
  .top__nav ol {
    display: flex;
    gap: clamp(1rem, 0.2rem + 1.6vw, 2.25rem);
  }
  .top__nav a {
    display: inline-flex;
    padding-block: 0.5rem;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--fg-2);
    transition: color var(--dur-1);
    position: relative;
  }
  .top__nav a:hover,
  .top__nav a[aria-current='true'] {
    color: var(--fg);
  }
  .top__nav a[aria-current='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.25rem;
    height: 1px;
    background: currentColor;
  }
  .top__num,
  .top__menu {
    display: none;
  }

  /* Phones: a « Sommaire » button opens the table of contents as a sheet; the entries sit low,
     within reach of the thumb. */
  @media (max-width: 47.99rem) {
    .top__menu:not([hidden]) {
      position: relative;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 2.75rem;
      padding-inline: 0.25rem;
      font-size: 0.9rem;
    }
    .top__burger {
      position: relative;
      width: 1.1rem;
      height: 0.6rem;
      border-block: 1px solid currentColor;
      transition: transform var(--dur-2) var(--ease);
    }
    .top__menu[aria-expanded='true'] .top__burger {
      border-color: transparent;
    }
    .top__menu[aria-expanded='true'] .top__burger::before,
    .top__menu[aria-expanded='true'] .top__burger::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      border-top: 1px solid currentColor;
      transform: rotate(45deg);
    }
    .top__menu[aria-expanded='true'] .top__burger::after {
      transform: rotate(-45deg);
    }
    /* Without JavaScript the button stays hidden and the list is a plain row of links under the name. */
    :global(.js) .top__nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      height: 100dvh;
      padding: calc(var(--header-h) + 2rem) var(--g) max(2.5rem, env(safe-area-inset-bottom));
      background: var(--bg);
      visibility: hidden;
      opacity: 0;
      transition:
        opacity var(--dur-2) var(--ease),
        visibility 0s var(--dur-2);
    }
    :global(.js) .top__nav.is-open {
      visibility: visible;
      opacity: 1;
      transition: opacity var(--dur-2) var(--ease);
    }
    :global(.js) .top__nav ol {
      flex-direction: column;
      gap: 0;
      border-top: 1px solid var(--rule);
    }
    :global(.js) .top__nav li {
      border-bottom: 1px solid var(--rule);
    }
    :global(.js) .top__nav a {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      padding-block: 0.85rem;
      font-family: var(--serif);
      font-weight: 300;
      font-size: clamp(2rem, 1rem + 6vw, 2.75rem);
      letter-spacing: -0.02em;
      line-height: 1.1;
      color: var(--fg);
    }
    :global(.js) .top__nav a::after {
      display: none;
    }
    :global(.js) .top__num {
      display: inline;
      font-family: var(--sans);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      color: var(--fg-2);
      min-width: 1.6rem;
    }
    :global(.motion) .top__nav li {
      transform: translateY(1rem);
      opacity: 0;
      transition:
        transform var(--dur-3) var(--ease),
        opacity var(--dur-2);
    }
    :global(.motion) .top__nav.is-open li {
      transform: none;
      opacity: 1;
      transition-delay: calc(80ms + var(--d) * 45ms);
    }
    :global(html:not(.js)) .top__bar {
      flex-wrap: wrap;
      row-gap: 0;
    }
    :global(html:not(.js)) .top__nav ol {
      flex-wrap: wrap;
      column-gap: 1rem;
    }
  }
</style>
