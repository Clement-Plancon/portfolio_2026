---
// The plate of a project: an exploded drawing of its stack. Each sheet is one layer of the
// technologies listed in the content (src/lib/plate.ts); the top sheet is the real capture when there
// is one, otherwise the project's name. Purely a drawing: the same facts are written out next to it.
import { plateLayers } from '../lib/plate';
import type { ProjectEntry } from '../lib/content';
import type { ResolvedMedia } from '../lib/media';

interface Props {
  project: ProjectEntry;
  image?: ResolvedMedia;
  class?: string;
}
const { project: p, image, class: cls } = Astro.props;
const layers = plateLayers(p.technologies).reverse();
const n = layers.length + 1;
const kind = p.kind?.split('·')[0]?.trim();
---

<div class:list={['plate', cls]} style={`--n:${n}`} aria-hidden="true" data-plate>
  <div class="plate__iso">
    <span class="plate__axis plate__axis--a"></span>
    <span class="plate__axis plate__axis--b"></span>
    {
      layers.map((l, j) => (
        <div class="slab" style={`--i:${j}`}>
          <span class="slab__n">{String(layers.length - j).padStart(2, '0')}</span>
          <span class="slab__name">{l.name}</span>
          <span class="slab__items">{l.items.join(' · ')}</span>
        </div>
      ))
    }
    {
      image ? (
        <div class="slab slab--img" style={`--i:${n - 1}`}>
          <img src={image.src} alt="" width={image.width} height={image.height} loading="lazy" decoding="async" />
        </div>
      ) : (
        <div class="slab slab--top" style={`--i:${n - 1}`}>
          {kind && <span class="slab__name">{kind}</span>}
          <span class="slab__title">{p.title}</span>
        </div>
      )
    }
  </div>
</div>

<style>
  .plate {
    --spread: 0;
    position: relative;
    container-type: size;
    aspect-ratio: 1 / 0.86;
    overflow: hidden;
    color: var(--fg);
  }
  .plate__iso {
    --gap: calc(0.9cqmin + var(--spread) * min(12cqmin, 58cqmin / var(--n)));
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64cqmin;
    aspect-ratio: 16 / 10;
    transform-style: preserve-3d;
    transform: translate(-50%, calc(-50% + (var(--n) - 1) * var(--gap) * 0.36)) rotateX(56deg) rotateZ(-38deg);
    transition: transform 1.2s var(--ease);
  }
  .slab {
    position: absolute;
    inset: 0;
    /* Everything sits on the front edge: the only part of a lower sheet left visible. */
    display: flex;
    align-items: baseline;
    align-content: flex-end;
    flex-wrap: wrap;
    column-gap: 1.6cqmin;
    padding: 2.2cqmin 3cqmin;
    background: var(--bg-2);
    border: 1px solid var(--rule-strong);
    transform: translateZ(calc(var(--i) * var(--gap)));
    transition: transform 1.2s var(--ease);
    transition-delay: calc(var(--i) * 40ms);
  }
  .slab__n {
    font: 500 1.9cqmin/1 var(--sans);
    letter-spacing: 0.08em;
    color: var(--tint, var(--accent));
  }
  .slab__name {
    font: 500 1.9cqmin/1 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-2);
  }
  .slab__items {
    margin-left: 1cqmin;
    font: 400 3.1cqmin/1.15 var(--serif);
    letter-spacing: -0.01em;
  }
  .slab--top {
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: flex-start;
    justify-content: space-between;
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .slab--top .slab__name {
    color: inherit;
    opacity: 0.66;
  }
  .slab__title {
    font: 300 6.2cqmin/0.95 var(--serif);
    letter-spacing: -0.03em;
  }
  .slab--img {
    display: block;
    padding: 0;
    overflow: hidden;
    background: #fff;
  }
  .slab--img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  /* Construction lines: two edges of the stack, drawn along its height. */
  .plate__axis {
    position: absolute;
    width: 0;
    height: calc((var(--n) - 1) * var(--gap));
    border-left: 1px dashed var(--rule-strong);
    transform-origin: 0 0;
    transform: rotateX(-90deg);
    opacity: var(--spread);
    transition:
      height 1.2s var(--ease),
      opacity 0.6s;
  }
  .plate__axis--a {
    left: 0;
    bottom: 0;
    transform-origin: 0 100%;
    transform: rotateX(90deg);
    top: auto;
  }
  .plate__axis--b {
    right: 0;
    bottom: 0;
    transform-origin: 0 100%;
    transform: rotateX(90deg);
  }
  :global(.is-open) > .plate,
  .plate.is-open {
    --spread: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .plate {
      --spread: 1;
    }
    .plate__iso,
    .slab,
    .plate__axis {
      transition: none;
    }
  }
</style>
