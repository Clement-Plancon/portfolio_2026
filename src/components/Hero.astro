---
// Act 1 — the introduction: who you are, beside the tangle of the threads (one per project shown).
// Every text, both buttons and the optional image or video come from the admin (Site → Accueil), with
// the profile as fallback. The tangle is drawn as SVG by the server, then by WebGL when it can.
import Arrow from './Arrow.astro';
import Media from './Media.astro';
import ThreadSvg from './ThreadSvg.astro';
import type { MediaResolver } from '../lib/media';
import type { Resolved } from '../lib/site';

interface Props {
  site: Resolved;
  media: MediaResolver;
}
const { site, media } = Astro.props;
const { hero, threads } = site;
const [first, ...rest] = hero.title.trim().split(/\s+/);
const long = hero.title.length > 20;
const internal = (href: string) => href.startsWith('#');
---

<section class:list={['hero', { 'hero--media': hero.media }]} aria-labelledby="hero-title" data-scene="hero" data-glow={site.ambiance.glow}>
  <div class="hero__in wrap">
    <div class="hero__stage" data-stage>
      <ThreadSvg kind="hero" colors={threads} />
      {hero.media && <Media src={hero.media.src} alt={hero.media.alt} media={media} class="hero__media" eager />}
    </div>

    <div class="hero__text">
      {
        hero.kicker && (
          <p class="hero__kicker label">
            {hero.kicker.split(' — ').map((part) => (
              <span>{part}</span>
            ))}
          </p>
        )
      }
      <h1 id="hero-title" class:list={['hero__name', { 'hero__name--long': long }]}>
        <span class="hero__first display">{first}</span>
        {rest.length > 0 && <span class="hero__last display">{rest.join(' ')}</span>}
        <span class="hero__role">{hero.role}</span>
      </h1>
      {hero.lead && <p class="hero__lead">{hero.lead}</p>}
      {
        (hero.primary || hero.secondary) && (
          <div class="hero__cta">
            {hero.primary && (
              <a class="btn btn--fill" href={hero.primary.href} rel={internal(hero.primary.href) ? undefined : 'noopener'}>
                {hero.primary.label} <Arrow dir={internal(hero.primary.href) ? 'down' : 'out'} />
              </a>
            )}
            {hero.secondary && (
              <a class="btn" href={hero.secondary.href} rel={internal(hero.secondary.href) ? undefined : 'noopener'}>
                {hero.secondary.label}
              </a>
            )}
          </div>
        )
      }
    </div>

    <p class="hero__foot label" aria-hidden="true">
      <span><span class="act__n">01</span> Découverte</span>
      <span class="hero__hint">
        {
          hero.hint ?? (
            <>
              <span class="hero__hint-gesture">
                <span class="hero__hint-fine">Passez sur les fils pour les démêler</span>
                <span class="hero__hint-touch">Touchez les fils pour les démêler</span> —{' '}
              </span>
              faites défiler
            </>
          )
        }
      </span>
    </p>
  </div>
</section>

<style>
  .hero__in {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: center;
    min-height: max(38rem, 100svh);
    padding-top: calc(var(--header-h) + 1rem);
    padding-bottom: 4.5rem;
  }
  .hero__stage {
    position: relative;
    grid-column: 5 / -1;
    grid-row: 1;
    aspect-ratio: 2 / 1.24;
    width: 100%;
  }
  /* Without WebGL, the loose ends of the tangle fade before the text, as they do in the scene. */
  .hero__stage :global(.stage-svg) {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 30%);
    mask-image: linear-gradient(90deg, transparent, #000 30%);
  }
  .hero__text {
    position: relative;
    grid-column: 1 / span 6;
    grid-row: 1;
    z-index: 1;
  }
  .hero__kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
  }
  .hero__kicker span + span::before {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 1px;
    margin-right: 1rem;
    vertical-align: middle;
    background: var(--rule-strong);
  }
  .hero__name {
    margin-top: 1.5rem;
  }
  .hero__first,
  .hero__last {
    display: block;
    font-size: clamp(3.6rem, 1rem + 9vw, 11.5rem);
    font-weight: 650;
    font-stretch: 76%;
    letter-spacing: -0.035em;
    line-height: 0.84;
  }
  .hero__last {
    padding-left: 0.42em;
  }
  /* long names: smaller, and allowed to break between words only */
  .hero__name--long .hero__first,
  .hero__name--long .hero__last {
    font-size: clamp(3rem, 0.8rem + 6.4vw, 8rem);
  }
  .hero__name .display {
    overflow-wrap: break-word;
  }
  /* an image or a video in the introduction: framed in the stage, the threads around it */
  .hero__stage :global(.hero__media) {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(62%, 30rem);
    transform: translate(-50%, -50%);
    z-index: 1;
  }
  .hero__stage :global(.hero__media.media--portrait) {
    width: min(38%, 20rem);
  }
  .hero__stage :global(.hero__media img),
  .hero__stage :global(.hero__media video) {
    border-radius: 10px;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 40px 80px -30px rgb(0 0 0 / 0.85);
  }
  .hero__role {
    display: block;
    margin-top: 1.4rem;
    font-family: var(--display);
    font-size: clamp(1.25rem, 0.9rem + 1vw, 1.9rem);
    font-weight: 400;
    font-stretch: 92%;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--fg);
  }
  .hero__lead {
    max-width: 30em;
    margin-top: 1rem;
    color: var(--fg-2);
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero__foot {
    position: absolute;
    left: max(var(--g), env(safe-area-inset-left));
    right: var(--g);
    bottom: 1.5rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .hero__hint-touch {
    display: none;
  }
  /* the gesture exists only with the scene */
  :global(html:not(.gl-on)) .hero__hint-gesture {
    display: none;
  }
  @media (hover: none) {
    .hero__hint-fine {
      display: none;
    }
    .hero__hint-touch {
      display: inline;
    }
  }
  /* Arrival: the name rises, the rest follows. Only transforms and opacity, after the first paint. */
  :global(.motion) .hero__first,
  :global(.motion) .hero__last {
    animation: hero-rise 1.2s var(--ease) both;
  }
  :global(.motion) .hero__last {
    animation-delay: 0.08s;
  }
  :global(.motion) .hero__kicker,
  :global(.motion) .hero__role,
  :global(.motion) .hero__lead,
  :global(.motion) .hero__cta,
  :global(.motion) .hero__foot {
    animation: hero-fade 1s var(--ease) both 0.45s;
  }
  @keyframes hero-rise {
    from {
      transform: translateY(0.35em);
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  @media (max-width: 63.99rem) {
    .hero__in {
      align-content: center;
      row-gap: 1rem;
    }
    .hero__stage {
      grid-column: 1 / -1;
      grid-row: 1;
      margin-inline: calc(var(--g) * -1);
      width: auto;
      aspect-ratio: 2 / 1.15;
    }
    .hero__text {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .hero__stage :global(.stage-svg) {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
  @media (max-width: 47.99rem) {
    .hero__in {
      min-height: max(34rem, calc(100svh - var(--bar-h)));
      padding-bottom: 2rem;
      align-content: start;
      padding-top: calc(var(--header-h) + 0.5rem);
    }
    .hero__stage {
      aspect-ratio: 2 / 1.35;
    }
    .hero__name {
      margin-top: 1rem;
    }
    .hero__first,
    .hero__last {
      font-size: clamp(3.4rem, 0.5rem + 15vw, 5.6rem);
    }
    .hero__cta {
      margin-top: 1.5rem;
    }
    .hero__cta .btn {
      flex: 1;
      justify-content: center;
      min-height: 2.9rem;
      padding-inline: 1rem;
    }
    .hero__foot {
      display: none;
    }
  }
</style>
