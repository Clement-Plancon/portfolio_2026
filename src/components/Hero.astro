---
// The introduction: the name in giant wide capitals on a flat field of colour, and over it a pile of
// posters, one per project shown in large. The posters can be moved by hand (mouse or pen), shuffled
// (button, any device), and open their project (click or tap). Without projects, one poster made of the
// role stands in the pile. Every word comes from the content (Site → Accueil, then the profile).
import Media from './Media.astro';
import Poster from './Poster.astro';
import Arrow from './Arrow.astro';
import type { MediaResolver } from '../lib/media';
import { displaySize, seed, tilt } from '../lib/poster';
import type { Resolved } from '../lib/site';
import type { ProjectEntry } from '../lib/snapshot';

interface Props {
  site: Resolved;
  media: MediaResolver;
  /** All visible projects (for the numbers on the posters). */
  projects: ProjectEntry[];
}
const { site, media, projects } = Astro.props;
const { hero } = site;
const words = hero.title.split(/\s+/).filter(Boolean);
// one size, so that the longest word fills the width
const nameSize = displaySize(hero.title, 21, 90, 1, 4);
const pile = site.featured.slice(0, 5);
const initials = words.map((w) => w[0]).join('').slice(0, 3).toUpperCase();
const identity = {
  id: 'identite',
  title: hero.role,
  kind: hero.kicker,
  category: 'pro',
  cover: { color: 'vermillon' },
  technologies: [],
} as unknown as ProjectEntry;
const cards = pile.length ? pile : [identity];
const n = cards.length + (hero.media ? 1 : 0);
// positions in the pile: fanned around its centre, each with its own tilt
const place = (id: string, i: number) => {
  const k = n > 1 ? i / (n - 1) - 0.5 : 0;
  const x = Math.round((k * 70 + (seed(id) - 0.5) * 12) * 10) / 10;
  const y = Math.round((Math.abs(k) * 14 + (seed(`${id}y`) - 0.5) * 14) * 10) / 10;
  return `--x:${x};--y:${y};--rot:${tilt(id, 9)}deg;--z:${i + 1};--i:${i}`;
};
---

<section class="hero part tone-hero" aria-labelledby="hero-title" data-tone="hero" data-hero>
  <div class="hero__in wrap">
    {hero.kicker && <p class="hero__kicker label">{hero.kicker}</p>}
    <h1 class="hero__name display" id="hero-title" style={`--size:${nameSize.toFixed(2)}`}>
      {
        words.map((w, i) => (
          <>
            <span class="hero__word" style={`--w:${i}`}>
              {w}
            </span>
            {i < words.length - 1 && ' '}
          </>
        ))
      }
    </h1>

    <div class="hero__pile" data-pile style={`--n:${n}`}>
      {
        hero.media && (
          <figure class="pile__card pile__card--media" style={place('media', 0)} data-pile-card>
            <Media src={hero.media.src} alt={hero.media.alt} media={media} eager />
          </figure>
        )
      }
      {
        pile.length
          ? pile.map((p, i) => (
              <a class="pile__card" href={`#projet-${p.id}`} style={place(p.id, i + (hero.media ? 1 : 0))} data-pile-card draggable="false">
                <Poster project={p} index={projects.indexOf(p)} media={media} eager={i === pile.length - 1} still />
                <span class="visually-hidden">Ouvrir le projet {p.title}</span>
              </a>
            ))
          : cards.map((c, i) => (
              <div class="pile__card" style={place(c.id, i + (hero.media ? 1 : 0))} data-pile-card>
                <Poster project={c} index={0} media={media} mark={initials} still />
              </div>
            ))
      }
      {
        n > 1 && (
          <button class="pile__shuffle" type="button" data-shuffle hidden>
            Mélanger les affiches
          </button>
        )
      }
    </div>

    <div class="hero__text">
      <p class="hero__role">{hero.role}</p>
      {hero.lead && <p class="hero__lead">{hero.lead}</p>}
      {
        (hero.primary || hero.secondary) && (
          <p class="hero__actions">
            {hero.primary && (
              <a class="btn btn--fill" href={hero.primary.href}>
                {hero.primary.label} <Arrow dir={hero.primary.href.startsWith('#') ? 'down' : 'out'} />
              </a>
            )}
            {hero.secondary && (
              <a class="btn" href={hero.secondary.href}>
                {hero.secondary.label}
              </a>
            )}
          </p>
        )
      }
      {hero.hint && <p class="hero__hint label">{hero.hint}</p>}
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: clip;
  }
  .hero__in {
    position: relative;
    min-height: max(100svh, 40rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      'kicker kicker'
      'name name'
      'text pile';
    padding-top: calc(var(--header-h) + 1rem);
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
    column-gap: var(--gap);
  }
  .hero__kicker {
    grid-area: kicker;
    color: var(--fg-2);
  }
  /* The name: as wide as the screen, one word per line. */
  .hero__name {
    grid-area: name;
    align-self: center;
    display: flex;
    flex-direction: column;
    font-size: calc(var(--size) * 1vw);
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: -0.035em;
    margin-inline: -0.04em;
    position: relative;
    z-index: 1;
  }
  .hero__word {
    display: block;
    white-space: nowrap;
  }
  .hero__word:nth-child(2n) {
    align-self: flex-end;
  }
  :global(.motion) .hero__word {
    animation: word-in 1.1s var(--ease) both;
    animation-delay: calc(var(--w) * 90ms + 80ms);
  }
  @keyframes word-in {
    from {
      transform: translateY(0.4em);
      font-stretch: 62%;
      opacity: 0;
    }
  }

  .hero__text {
    grid-area: text;
    align-self: end;
    position: relative;
    z-index: 3;
    max-width: 34rem;
  }
  .hero__role {
    font-size: clamp(1.25rem, 0.9rem + 1.3vw, 2.25rem);
    font-weight: 800;
    font-stretch: 100%;
    line-height: 1.05;
    letter-spacing: -0.015em;
  }
  .hero__lead {
    margin-top: 0.75rem;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.25rem);
    color: var(--fg-2);
    max-width: 30rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .hero__hint {
    margin-top: 1rem;
    color: var(--fg-2);
  }

  /* The pile: over the name, on the right. */
  .hero__pile {
    grid-area: 2 / 2 / 4 / 3;
    position: relative;
    z-index: 2;
    align-self: center;
    justify-self: center;
    width: clamp(11rem, 21vw, 22rem);
    aspect-ratio: 5 / 7;
    margin-top: 4vh;
  }
  .pile__card {
    position: absolute;
    inset: 0;
    z-index: var(--z);
    display: block;
    margin: 0;
    color: inherit;
    text-decoration: none;
    translate: calc(var(--x) * 1% + var(--dx, 0px)) calc(var(--y) * 1% + var(--dy, 0px));
    rotate: var(--rot);
    box-shadow: 0 1.2rem 2.5rem -1.2rem rgb(0 0 0 / 0.45);
    touch-action: pan-y;
    transition:
      translate var(--dur-3) var(--ease),
      rotate var(--dur-3) var(--ease),
      scale var(--dur-2) var(--spring);
    cursor: pointer;
  }
  /* the pile leans towards the pointer, and drifts apart as the introduction scrolls away */
  :global(.motion) .hero__pile {
    transform: translate(calc(var(--mx, 0) * 2.5rem), calc(var(--my, 0) * 1.5rem));
    transition: transform 1.2s var(--ease);
  }
  :global(.motion) .pile__card {
    transform: translate(calc(var(--out, 0) * (var(--i) - 1.5) * 40%), calc(var(--out, 0) * -25%)) rotate(calc(var(--out, 0) * var(--rot) * 2));
  }
  .pile__card.is-dragging {
    transition: scale var(--dur-2) var(--spring);
    scale: 1.04;
    cursor: grabbing;
  }
  .pile__card:hover {
    scale: 1.03;
  }
  .pile__card:focus-visible {
    outline: 4px solid var(--fg);
    outline-offset: 6px;
  }
  .pile__card--media {
    background: var(--paper);
    padding: 4%;
  }
  .pile__card--media :global(img),
  .pile__card--media :global(video) {
    height: 100%;
    aspect-ratio: auto;
    border-radius: 0;
    object-fit: cover;
  }
  .pile__card--media :global(.media) {
    height: 100%;
  }
  :global(.motion) .pile__card {
    animation: card-in 1.2s var(--ease) both;
    animation-delay: calc(var(--i) * 110ms + 350ms);
  }
  @keyframes card-in {
    from {
      translate: 0 60vh;
      rotate: calc(var(--rot) * -3);
    }
  }
  .pile__shuffle {
    position: absolute;
    left: 50%;
    top: 100%;
    z-index: 20;
    translate: -50% 1.75rem;
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius);
    background: var(--fg);
    color: var(--bg);
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .pile__shuffle:hover {
    background: var(--accent);
    color: var(--hero);
  }

  /* Tablets (portrait) and phones: the name at the top, the pile under it, the text last. */
  @media (max-width: 61.99rem), (max-aspect-ratio: 4/5) {
    .hero__in {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto 1fr auto;
      grid-template-areas: 'kicker' 'name' 'pile' 'text';
      row-gap: 1rem;
    }
    .hero__name {
      margin-top: 0.75rem;
      align-self: start;
    }
    .hero__pile {
      grid-area: pile;
      width: clamp(9rem, 38vw, 19rem);
      margin: 0 0 4.75rem;
      align-self: center;
    }
    .hero__text {
      max-width: 40rem;
    }
  }
  @media (max-width: 47.99rem) {
    .hero__in {
      min-height: calc(100svh - var(--bar-h));
      min-height: max(calc(100svh - var(--bar-h)), 36rem);
      padding-bottom: 1.25rem;
    }
    .hero__pile {
      width: clamp(8rem, 42vw, 13rem);
      margin-bottom: 4.75rem;
    }
    .hero__actions .btn {
      flex: 1;
    }
  }
</style>
