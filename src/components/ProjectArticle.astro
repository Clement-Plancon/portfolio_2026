---
// A project's article: every detail of the project, over the page (a modal dialog opened by
// src/scripts/site.ts; printed in place without JavaScript). The head is the project's poster colour,
// with its title in wide capitals; then its real image or video, its story, its facts. Used for the
// projects in large and for the others alike.
import Arrow from './Arrow.astro';
import Media from './Media.astro';
import Poster from './Poster.astro';
import type { ProjectEntry } from '../lib/content';
import { paragraphs } from '../lib/content';
import { formatPeriod } from '../lib/format';
import type { MediaResolver } from '../lib/media';
import { lineSize } from '../lib/poster';
import { tintStyle } from '../lib/tints';

interface Props {
  project: ProjectEntry;
  /** Position among all visible projects, and their number. */
  i: number;
  total: number;
  prev: ProjectEntry;
  next: ProjectEntry;
  media: MediaResolver;
}
const { project: p, i, total, prev, next, media } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const when = formatPeriod(p.period?.start, p.period?.end, p.status === 'en-cours') || (p.status === 'en-cours' ? 'En cours' : '');
const mainMedia = p.cover.video
  ? { src: p.cover.video.src, alt: p.cover.video.alt, poster: p.cover.image?.src, video: true }
  : p.cover.image
    ? { src: p.cover.image.src, alt: p.cover.image.alt, poster: undefined, video: false }
    : undefined;
const sections = [
  { title: 'Contexte', body: paragraphs(p.context) },
  { title: 'Problème', body: paragraphs(p.problem) },
  { title: 'Mon rôle', body: paragraphs(p.role) },
  { title: 'Approche', body: paragraphs(p.approach) },
].filter((s) => s.body.length);
const longest = p.title.split(/\s+/).reduce((a, b) => ([...b].length > [...a].length ? b : a), '');
const single = total < 2;
---

<dialog class="feat" id={`detail-${p.id}`} aria-labelledby={`detail-${p.id}-title`} style={tintStyle(p.cover.color)} data-detail>
  <div class="feat__bar">
    <p class="feat__count label">
      <span class="feat__n">{pad(i + 1)}</span> / {pad(total)}
    </p>
    <div class="feat__nav">
      {
        !single && (
          <a class="feat__btn feat__btn--icon" href={`#projet-${prev.id}`} data-go aria-label={`Projet précédent : ${prev.title}`}>
            <Arrow dir="left" />
          </a>
        )
      }
      {
        !single && (
          <a class="feat__btn feat__btn--icon" href={`#projet-${next.id}`} data-go aria-label={`Projet suivant : ${next.title}`}>
            <Arrow />
          </a>
        )
      }
      <button class="feat__btn feat__close" type="button" data-close>Fermer</button>
    </div>
  </div>

  <article class="feat__in">
    <header class="feat__head">
      <div class="feat__headin wrap">
        <div class="feat__headtext">
          <p class="label">{p.kind ?? (p.category === 'pro' ? 'Projet professionnel' : 'Projet personnel')}</p>
          <p class="feat__title display" id={`detail-${p.id}-title`} style={`--s:${lineSize(longest, 15, 96)}`}>
            {p.title}
          </p>
          <p class="feat__stand">{p.summary}</p>
        </div>
        <div class="feat__poster">
          <Poster project={p} index={i} media={media} still />
        </div>
      </div>
    </header>

    <div class="feat__page wrap">
      {
        mainMedia && (
          <div class="feat__shot">
            <Media src={mainMedia.src} alt={mainMedia.alt} poster={mainMedia.poster} media={media} class="feat__frame" />
            {p.cover.image?.caption && <p class="label feat__caption">{p.cover.image.caption}</p>}
          </div>
        )
      }

      <div class="feat__body">
        <aside class="feat__facts" aria-label="Fiche du projet">
          <dl>
            {p.organisation && (
              <div>
                <dt class="label">Cadre</dt>
                <dd>{p.organisation}</dd>
              </div>
            )}
            {when && (
              <div>
                <dt class="label">Période</dt>
                <dd>{when}</dd>
              </div>
            )}
            {p.status && (
              <div>
                <dt class="label">État</dt>
                <dd>{p.status === 'en-cours' ? 'En cours de développement' : 'Terminé'}</dd>
              </div>
            )}
            {p.technologies.length > 0 && (
              <div>
                <dt class="label">Technologies</dt>
                <dd>
                  <ul role="list" class="chips">
                    {p.technologies.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
            {p.links.length > 0 && (
              <div>
                <dt class="label">Liens</dt>
                <dd>
                  <ul role="list" class="feat__links">
                    {p.links.map((l) => (
                      <li>
                        <a class="link feat__ext" href={l.url} rel="noopener">
                          {l.label}
                          <Arrow dir="out" />
                        </a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
          </dl>
        </aside>

        <div class="feat__text">
          {sections.map((s) => (
            <section class="feat__sec">
              <h4 class="feat__h">{s.title}</h4>
              {s.body.map((t) => (
                <p>{t}</p>
              ))}
            </section>
          ))}
          {p.contributions.length > 0 && (
            <section class="feat__sec">
              <h4 class="feat__h">{p.category === 'pro' ? 'Contributions' : 'Fonctionnalités'}</h4>
              <ol role="list" class="feat__list">
                {p.contributions.map((c) => (
                  <li>{c}</li>
                ))}
              </ol>
            </section>
          )}
          {p.results.length > 0 && (
            <section class="feat__sec">
              <h4 class="feat__h">Résultats</h4>
              <ul role="list" class="feat__list feat__list--plain">
                {p.results.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>
            </section>
          )}
        </div>
      </div>

      {
        p.gallery.length > 0 && (
          <div class="feat__gallery">
            {p.gallery.map((g) => (
              <Media src={g.src} alt={g.alt} media={media} class="feat__gimg">
                {g.caption && <figcaption class="label">{g.caption}</figcaption>}
              </Media>
            ))}
          </div>
        )
      }
    </div>

    {
      !single && (
        <a class="feat__next" href={`#projet-${next.id}`} data-go style={tintStyle(next.cover.color)}>
          <span class="wrap feat__nextin">
            <span class="label">Projet suivant</span>
            <span class="feat__next-t display">
              {next.title} <Arrow />
            </span>
          </span>
        </a>
      )
    }
  </article>
</dialog>

<style>
  .feat {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .feat::backdrop {
    background: rgb(17 17 17 / 0.6);
  }
  /* Without JavaScript the articles are printed in place, under their project. */
  :global(html:not(.js)) .feat {
    position: static;
    display: block;
    height: auto;
    overflow: visible;
    margin-top: 3rem;
  }
  :global(html:not(.js)) .feat__bar,
  :global(html:not(.js)) .feat__next {
    display: none;
  }

  .feat__bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem var(--g);
    background: var(--p-bg);
    color: var(--p-ink);
  }
  .feat__n {
    font-size: 1rem;
    font-weight: 800;
  }
  .feat__nav {
    display: flex;
    gap: 0.5rem;
  }
  .feat__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius);
    border: 2px solid currentColor;
    font-weight: 700;
    text-decoration: none;
    transition:
      background var(--dur-1),
      color var(--dur-1);
  }
  .feat__btn--icon {
    padding: 0;
    width: 2.75rem;
  }
  .feat__btn:hover {
    background: var(--p-ink);
    color: var(--p-bg);
  }
  .feat__close {
    background: var(--p-ink);
    color: var(--p-bg);
    border-color: var(--p-ink);
  }
  .feat__close:hover {
    background: transparent;
    color: var(--p-ink);
  }

  .feat__head {
    background: var(--p-bg);
    color: var(--p-ink);
    padding-block: clamp(1.5rem, 5vw, 4rem) clamp(2.5rem, 6vw, 5rem);
  }
  .feat__headin {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(10rem, 22vw, 20rem);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
  }
  .feat__headtext {
    container-type: inline-size;
    min-width: 0;
  }
  .feat__title {
    margin-top: 1rem;
    font-size: calc(var(--s) * 1cqi);
    letter-spacing: -0.03em;
  }
  .feat__stand {
    margin-top: 1.5rem;
    max-width: 38rem;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem);
    font-weight: 500;
    line-height: 1.35;
  }
  .feat__poster {
    rotate: 3deg;
    box-shadow: 0 2rem 3rem -1.5rem rgb(0 0 0 / 0.5);
    outline: 2px solid color-mix(in srgb, var(--p-ink) 25%, transparent);
  }

  .feat__page {
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .feat__shot {
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }
  .feat__shot :global(.feat__frame) {
    max-width: 64rem;
    margin-inline: auto;
  }
  .feat__shot :global(.media--portrait) {
    max-width: min(26rem, 100%);
  }
  .feat__shot :global(img),
  .feat__shot :global(video) {
    border-radius: 0;
    box-shadow: 0 0 0 2px var(--ink);
  }
  .feat__caption {
    margin-top: 0.75rem;
    text-align: center;
    color: var(--ink-2);
  }
  .feat__body {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 44rem);
    gap: clamp(2rem, 6vw, 7rem);
  }
  .feat__facts dl {
    display: grid;
    gap: 1.25rem;
    position: sticky;
    top: 5rem;
  }
  .feat__facts dt {
    color: var(--ink-2);
    margin-bottom: 0.35rem;
  }
  .feat__facts dd {
    font-weight: 600;
  }
  .feat__links {
    display: grid;
    gap: 0.4rem;
  }
  .feat__ext {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
  }
  .feat__sec + .feat__sec {
    margin-top: 2.5rem;
  }
  .feat__h {
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem);
    font-weight: 800;
    font-stretch: 115%;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin-bottom: 0.9rem;
  }
  .feat__sec p + p {
    margin-top: 0.9rem;
  }
  .feat__list {
    display: grid;
    gap: 0.6rem;
    counter-reset: c;
  }
  .feat__list li {
    position: relative;
    padding-left: 2.5rem;
    counter-increment: c;
  }
  .feat__list li::before {
    content: counter(c, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.1rem;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--ink-2);
  }
  .feat__list--plain li::before {
    content: '';
    top: 0.55em;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--p-bg);
    box-shadow: 0 0 0 2px var(--ink);
  }
  .feat__gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--gap);
    margin-top: clamp(3rem, 6vw, 5rem);
    align-items: start;
  }
  .feat__gallery :global(img) {
    border-radius: 0;
  }
  .feat__gallery :global(figcaption) {
    margin-top: 0.5rem;
    color: var(--ink-2);
  }

  .feat__next {
    display: block;
    background: var(--p-bg);
    color: var(--p-ink);
    text-decoration: none;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .feat__nextin {
    display: grid;
    gap: 0.75rem;
  }
  .feat__next-t {
    font-size: clamp(2rem, 1rem + 5vw, 6rem);
    overflow-wrap: anywhere;
  }
  .feat__next-t :global(.arrow) {
    transition: transform var(--dur-2) var(--spring);
  }
  .feat__next:hover .feat__next-t :global(.arrow) {
    transform: translateX(0.2em);
  }

  @media (max-width: 47.99rem) {
    .feat__headin {
      grid-template-columns: minmax(0, 1fr);
    }
    .feat__poster {
      display: none;
    }
    .feat__body {
      grid-template-columns: minmax(0, 1fr);
    }
    .feat__facts dl {
      position: static;
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    }
    .feat__count {
      font-size: 0.7rem;
    }
  }
</style>
