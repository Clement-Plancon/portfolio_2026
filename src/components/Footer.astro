---
interface Props {
  name: string;
}
const { name } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="wrap footer">
  <p>© {year} {name}, Paris</p>
  <p class="footer__colophon">Composé en Newsreader et Instrument Sans. Cyanotypes calculés à la construction du site.</p>
  <a href="#top">Haut de page ↑</a>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 2rem calc(2rem + env(safe-area-inset-bottom));
    font-family: var(--sans);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .footer a {
    text-decoration: none;
  }
</style>
