---
interface Props {
  name: string;
  location: string;
}
const { name, location } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="foot wrap">
  <p>© {year} {name} — {location}</p>
  <p><a class="link" href="/#top">Revenir à la couverture ↑</a></p>
</footer>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 2rem 2.5rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }
</style>
