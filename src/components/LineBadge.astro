---
// The project's line badge: a coloured square with its code. On the board and on the
// project page it shares a view-transition name, so it travels from one to the other.
import type { ProjectEntry } from '../lib/content';
import { lineCode, lineStyle } from '../lib/lines';

interface Props {
  project: ProjectEntry;
  size?: 'sm' | 'md' | 'xl';
  transition?: boolean;
}
const { project, size = 'md', transition = false } = Astro.props;
const vt = transition ? `view-transition-name: line-${project.id};` : '';
---

<span class:list={['badge', `badge--${size}`]} style={`${lineStyle(project.cover.color)}${vt}`} aria-hidden="true">
  {lineCode(project)}
</span>

<style>
  .badge {
    display: inline-grid;
    place-items: center;
    flex: none;
    background: var(--line);
    color: var(--line-text);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1;
    border-radius: 6px;
  }
  .badge--sm {
    width: 2.25rem;
    height: 2.25rem;
    font-size: 0.95rem;
    border-radius: 4px;
  }
  .badge--md {
    width: 3rem;
    height: 3rem;
    font-size: 1.25rem;
  }
  .badge--xl {
    width: clamp(5.5rem, 4rem + 7vw, 11rem);
    height: clamp(5.5rem, 4rem + 7vw, 11rem);
    font-size: clamp(2.4rem, 1.6rem + 3.4vw, 5rem);
    border-radius: 10px;
    padding-top: 0.08em; /* Overpass caps sit high: optical centring */
  }
  .badge--sm,
  .badge--md {
    padding-top: 0.1em;
  }
</style>
