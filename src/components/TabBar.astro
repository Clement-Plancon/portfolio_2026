---
// Phone navigation: a sign panel fixed within thumb reach, pictogram + label, "you are here" in yellow.
import Pictogram, { type PictogramName } from './Pictogram.astro';

const path = Astro.url.pathname;
const tabs: { href: string; label: string; icon: PictogramName }[] = [
  { href: '/', label: 'Accueil', icon: 'accueil' },
  { href: '/projets/', label: 'Projets', icon: 'projets' },
  { href: '/parcours/', label: 'Parcours', icon: 'parcours' },
  { href: '/a-propos/', label: 'À propos', icon: 'apropos' },
  { href: '/contact/', label: 'Contact', icon: 'contact' },
];
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<nav class="tabbar" aria-label="Navigation principale (mobile)">
  <ul role="list">
    {
      tabs.map((t) => (
        <li>
          <a href={t.href} aria-current={active(t.href) ? 'page' : undefined}>
            <span class="plate">
              <Pictogram name={t.icon} size={18} />
            </span>
            <span>{t.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tabbar {
    display: none;
  }
  @media (max-width: 47.99rem) {
    .tabbar {
      display: block;
      position: fixed;
      inset: auto 0 0 0;
      z-index: 50;
      padding: var(--joint) var(--joint) calc(var(--joint) + env(safe-area-inset-bottom));
      background: var(--ground);
      view-transition-name: tabbar;
    }
    ul {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: var(--joint);
    }
    a {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      height: calc(var(--tabbar-h) - 2 * var(--joint));
      background: var(--panel);
      color: var(--on-panel-2);
      border-radius: var(--radius);
      font-size: 0.6875rem;
      font-weight: 800;
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
    }
    .plate {
      display: grid;
      place-items: center;
      width: 26px;
      height: 26px;
      border-radius: 3px;
      background: var(--on-panel);
      color: var(--panel);
      transition: transform var(--dur-1) ease;
    }
    a:active .plate {
      transform: scale(0.9);
    }
    a[aria-current='page'] {
      background: var(--signal);
      color: var(--on-signal);
    }
    a[aria-current='page'] .plate {
      background: var(--panel);
      color: var(--signal);
    }
  }
</style>
