---
// Phone navigation, within thumb reach: a floating bar at the bottom of the screen.
const path = Astro.url.pathname;
const tabs = [
  { href: '/', label: 'Accueil' },
  { href: '/projets/', label: 'Projets' },
  { href: '/parcours/', label: 'Parcours' },
  { href: '/a-propos/', label: 'À propos' },
  { href: '/contact/', label: 'Contact' },
];
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<nav class="tabbar" aria-label="Navigation principale (mobile)">
  <ul role="list">
    {
      tabs.map((t) => (
        <li>
          <a href={t.href} aria-current={active(t.href) ? 'page' : undefined}>
            {t.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tabbar {
    display: none;
  }
  @media (max-width: 47.99rem) {
    .tabbar {
      display: block;
      position: fixed;
      z-index: 60;
      left: 0.5rem;
      right: 0.5rem;
      bottom: calc(0.5rem + env(safe-area-inset-bottom));
      padding: 0.3rem;
      border-radius: 99px;
      background: var(--prussian);
      color: var(--on-prussian);
      box-shadow: 0 12px 30px -12px rgb(8 16 39 / 0.6);
    }
    .tabbar ul {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .tabbar a {
      display: grid;
      place-items: center;
      min-height: 3rem;
      border-radius: 99px;
      font-family: var(--sans);
      font-size: clamp(0.75rem, 0.62rem + 0.6vw, 0.875rem);
      font-weight: 500;
      text-decoration: none;
      white-space: nowrap;
      transition: background var(--dur-1) ease;
    }
    .tabbar a:hover {
      color: inherit;
    }
    .tabbar a[aria-current='page'] {
      background: var(--on-prussian);
      color: var(--prussian);
    }
    .tabbar a:focus-visible {
      outline-color: var(--on-prussian);
      outline-offset: -3px;
    }
  }
</style>
