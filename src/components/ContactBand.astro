---
// The exit sign: every page ends on a signal-yellow panel that leads to the e-mail.
import type { Profile } from '../lib/schemas';

interface Props {
  profile: Profile;
  headingLevel?: 'h1' | 'h2';
  title?: string;
}
const { profile, headingLevel = 'h2', title = 'Écrire à Clément' } = Astro.props;
const H = headingLevel;
const cvHref = profile.cv?.startsWith('files/') ? `/${profile.cv}` : profile.cv;
---

<section class="wrap exit" aria-labelledby="exit-title">
  <div class="exit__sign">
    <p class="label">Contact</p>
    <H id="exit-title" class="exit__title">{title}</H>
    <a class="exit__email" href={`mailto:${profile.email}`}>
      <span class="exit__arrow" aria-hidden="true">→</span>
      <span>{profile.email}</span>
    </a>
    <p class="exit__note">
      Un projet, un poste, une question technique : je réponds personnellement.
      <button type="button" class="copy" data-copy={profile.email}><span data-copy-label>Copier l'adresse</span></button>
      <span class="visually-hidden" role="status" data-copy-status></span>
    </p>
  </div>
  <ul role="list" class="exit__links">
    {
      profile.socials.map((s) => (
        <li>
          <a href={s.url} rel="me noopener" target="_blank">
            {s.label}
            <span class="visually-hidden"> (nouvel onglet)</span>
            <span class="ext" aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
    {
      cvHref && (
        <li>
          <a href={cvHref}>
            CV (PDF) <span class="ext" aria-hidden="true">↓</span>
          </a>
        </li>
      )
    }
    <li class="exit__place"><span class="label">Basé à</span> {profile.location}</li>
  </ul>
</section>

<style>
  .exit {
    display: grid;
    gap: var(--joint);
    margin-top: var(--joint);
  }
  @media (min-width: 64rem) {
    .exit {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }
  }
  .exit__sign {
    padding: var(--pad);
    padding-block: clamp(2rem, 1.5rem + 3vw, 4rem);
    background: var(--signal);
    color: var(--on-signal);
    border-radius: var(--radius);
  }
  .exit__title {
    margin-top: 0.75rem;
    font-size: var(--step-3);
  }
  .exit__email {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    max-width: 100%;
    margin-top: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    /* sized so the address never breaks on a 320px screen */
    font-size: clamp(1rem, 5.1vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-decoration: none;
  }
  .exit__email span:last-child {
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.15em;
  }
  .exit__arrow {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 1.3em;
    height: 1.3em;
    border-radius: 6px;
    background: var(--panel);
    color: var(--signal);
    transition: transform var(--dur-2) var(--ease);
  }
  .exit__email:hover .exit__arrow,
  .exit__email:focus-visible .exit__arrow {
    transform: translateX(6px);
  }
  .exit__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 1.25rem;
    font-size: var(--step--1);
    font-weight: 600;
  }
  .copy {
    min-height: 40px;
    padding: 0.4rem 0.85rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: transparent;
    font-weight: 800;
  }
  .copy:hover {
    background: var(--ink);
    color: var(--signal);
  }
  .exit :focus-visible {
    outline-color: var(--ink);
    box-shadow: 0 0 0 5px var(--signal);
  }
  .exit__links {
    display: grid;
    gap: var(--joint);
    align-content: stretch;
  }
  .exit__links li {
    display: flex;
  }
  .exit__links a,
  .exit__place {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 0 var(--pad);
    padding-inline: 1.25rem;
    background: var(--panel);
    color: var(--on-panel);
    border-radius: var(--radius);
    font-weight: 800;
    text-decoration: none;
  }
  .exit__links a:hover .ext {
    transform: translate(2px, -2px);
  }
  .ext {
    color: var(--signal);
    transition: transform var(--dur-2) var(--ease);
  }
  .exit__links a:focus-visible {
    outline-color: var(--signal);
    box-shadow: 0 0 0 5px var(--ground);
  }
  .exit__place .label {
    color: var(--on-panel-2);
  }
  .exit__place {
    justify-content: flex-start;
    font-weight: 600;
  }
  @media (max-width: 63.99rem) {
    .exit__links {
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    }
    .exit__links .exit__place {
      grid-column: 1 / -1;
    }
  }
</style>
