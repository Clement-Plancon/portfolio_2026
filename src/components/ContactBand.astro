---
// Every page ends on one last print: a large Prussian blue sheet that leads to the e-mail.
import { photogram } from '../lib/photogram';
import type { Profile } from '../lib/schemas';

interface Props {
  profile: Profile;
  headingLevel?: 'h1' | 'h2';
}
const { profile, headingLevel: H = 'h2' } = Astro.props;
const cvHref = profile.cv?.startsWith('files/') ? `/${profile.cv}` : profile.cv;
const { edge } = photogram('contact-band');
const firstName = profile.name.split(' ')[0];
---

<section class="wrap contact" aria-labelledby="contact-title">
  <div class="contact__sheet" style="clip-path:url(#edge-contact)">
    <p class="eyebrow contact__eyebrow">Contact</p>
    <H id="contact-title" class="contact__title">Écrire à <em>{firstName}</em></H>
    <a class="contact__email" href={`mailto:${profile.email}`}>{profile.email}</a>
    <div class="contact__row">
      <button type="button" class="pill contact__copy" data-copy={profile.email}><span data-copy-label>Copier l'adresse</span></button>
      <span class="visually-hidden" role="status" data-copy-status></span>
      <ul role="list" class="contact__links">
        {
          profile.socials.map((s) => (
            <li>
              <a href={s.url} rel="me noopener" target="_blank">
                {s.label}
                <span class="visually-hidden"> (nouvel onglet)</span> <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
        {
          cvHref && (
            <li>
              <a href={cvHref}>CV (PDF)</a>
            </li>
          )
        }
      </ul>
      <p class="contact__place">{profile.location}</p>
    </div>
  </div>
  <svg width="0" height="0" aria-hidden="true" focusable="false" class="contact__defs">
    <clipPath id="edge-contact" clipPathUnits="objectBoundingBox"><path d={edge}></path></clipPath>
  </svg>
</section>

<style>
  .contact {
    padding-block: clamp(2rem, 1rem + 4vw, 5rem);
  }
  .contact__sheet {
    background: var(--prussian);
    color: var(--on-prussian);
    padding: clamp(2.5rem, 1.5rem + 5vw, 7rem) clamp(1.75rem, 1rem + 5vw, 7rem);
  }
  .contact__eyebrow {
    color: var(--on-prussian-2);
  }
  .contact__title {
    margin-top: 1rem;
    font-size: var(--step-5);
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: -0.04em;
  }
  .contact__title em {
    font-style: italic;
  }
  .contact__email {
    display: inline-block;
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    font-size: clamp(1.15rem, 0.7rem + 2.6vw, 2.75rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .contact__email:hover {
    color: inherit;
    text-decoration-thickness: 2px;
  }
  .contact__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2.5rem;
    font-family: var(--sans);
    font-size: 0.9375rem;
  }
  .contact__copy:hover {
    background: var(--on-prussian);
    color: var(--prussian);
  }
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .contact__links a {
    display: inline-block;
    padding-block: 0.6rem;
    text-decoration: none;
  }
  .contact__links a:hover {
    color: inherit;
    text-decoration: underline;
  }
  .contact__place {
    color: var(--on-prussian-2);
  }
  .contact :focus-visible {
    outline-color: var(--on-prussian);
  }
  .contact__defs {
    position: absolute;
  }
</style>
