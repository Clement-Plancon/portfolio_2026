---
// Arrows are drawn (the text fonts have none). Decorative: the link or button carries the words.
interface Props {
  dir?: 'right' | 'left' | 'down' | 'up' | 'out';
}
const { dir = 'right' } = Astro.props;
const rot = { right: 0, down: 90, left: 180, up: 270, out: -45 }[dir];
---

<svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false" style={`transform:rotate(${rot}deg)`}>
  <path d="M2 8h11M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"></path>
</svg>
