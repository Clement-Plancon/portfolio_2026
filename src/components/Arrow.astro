---
// Arrows are drawn (the typeface has none). Decorative: the link or button carries the words.
interface Props {
  dir?: 'right' | 'left' | 'down' | 'up' | 'out';
}
const { dir = 'right' } = Astro.props;
const rot = { right: 0, down: 90, left: 180, up: 270, out: -45 }[dir];
---

<svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
  <path d="M1.5 8h11.5M8 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.2" transform={`rotate(${rot} 8 8)`}></path>
</svg>
