---
// Career as an editorial list: years in italic on the left, the position and what it involved on the right.
import type { ExperienceEntry } from '../lib/content';
import { formatPeriod } from '../lib/format';

interface Props {
  experiences: ExperienceEntry[];
}
const { experiences } = Astro.props;
const current = experiences.filter((e) => !e.end);
---

<ol role="list" class="xp">
  {
    experiences.map((e) => (
      <li class="xp__item">
        <div class="xp__when">
          <span class="xp__period">{formatPeriod(e.start, e.end, !e.end)}</span>
          {!e.end && <span class:list={['xp__state', { 'is-main': e === current[0] }]}>{e === current[0] ? 'En poste' : 'En parallèle'}</span>}
        </div>
        <div class="xp__body">
          <h3 class="xp__role">{e.role}</h3>
          <p class="xp__org">
            {e.url ? <a href={e.url}>{e.organisation}</a> : e.organisation}{e.parentOrganisation && `, ${e.parentOrganisation}`}{e.location && ` · ${e.location}`}
          </p>
          {e.summary && <p class="xp__summary">{e.summary}</p>}
          {e.responsibilities.length > 0 && (
            <ul role="list" class="xp__resp">
              {e.responsibilities.map((r) => (
                <li>{r}</li>
              ))}
            </ul>
          )}
          {e.skills.length > 0 && (
            <ul role="list" class="xp__skills" aria-label="Technologies et pratiques">
              {e.skills.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .xp {
    border-top: 1px solid var(--rule);
  }
  .xp__item {
    display: grid;
    gap: 1rem 3rem;
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 56rem) {
    .xp__item {
      grid-template-columns: minmax(12rem, 1fr) minmax(0, 2.6fr);
    }
  }
  .xp__when {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .xp__period {
    font-style: italic;
    font-size: var(--step-2);
    line-height: 1.05;
    color: var(--blue);
    font-variant-numeric: oldstyle-nums;
  }
  .xp__state {
    font-family: var(--sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-2);
  }
  .xp__state.is-main::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--blue);
    vertical-align: 0.05em;
  }
  .xp__role {
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.1;
    max-width: 26ch;
  }
  .xp__org {
    margin-top: 0.6rem;
    font-family: var(--sans);
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .xp__summary {
    margin-top: 1.25rem;
    max-width: 40rem;
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .xp__resp {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.5rem;
    max-width: 42rem;
  }
  .xp__resp li {
    position: relative;
    padding-left: 1.75rem;
  }
  .xp__resp li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 1rem;
    height: 1px;
    background: var(--blue);
  }
  .xp__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .xp__skills li {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 99px;
    font-family: var(--sans);
    font-size: 0.8125rem;
  }
</style>
