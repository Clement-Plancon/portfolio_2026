---
// Career as stops along one line: each position is a panel, the line runs through all of them.
import type { ExperienceEntry } from '../lib/content';
import { formatPeriod } from '../lib/format';

interface Props {
  experiences: ExperienceEntry[];
}
const { experiences } = Astro.props;
const current = experiences.filter((e) => !e.end);
const state = (e: ExperienceEntry) => (e.end ? 'Terminé' : e === current[0] ? 'En service' : 'En parallèle');
---

<ol role="list" class="xp">
  {
    experiences.map((e) => (
      <li class:list={['panel panel--sheet xp__item', { 'is-now': !e.end, 'is-main': e === current[0] }]}>
        <div class="xp__when">
          <span class="xp__state">{state(e)}</span>
          <span class="xp__period">{formatPeriod(e.start, e.end, !e.end)}</span>
        </div>
        <div class="xp__body">
          <h3 class="xp__role">{e.role}</h3>
          <p class="xp__org">
            {e.url ? <a href={e.url}>{e.organisation}</a> : <strong>{e.organisation}</strong>}
            {e.parentOrganisation && <span> · {e.parentOrganisation}</span>}
            {e.location && <span> · {e.location}</span>}
          </p>
          {e.summary && <p class="xp__summary">{e.summary}</p>}
          {e.responsibilities.length > 0 && (
            <ul role="list" class="xp__resp">
              {e.responsibilities.map((r) => (
                <li>{r}</li>
              ))}
            </ul>
          )}
          {e.skills.length > 0 && (
            <ul class="slash-list xp__skills" aria-label="Technologies">
              {e.skills.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .xp {
    display: grid;
    gap: var(--joint);
  }
  .xp__item {
    position: relative;
    display: grid;
    gap: 1rem var(--gutter);
    padding-left: calc(var(--pad) + 2.25rem);
  }
  /* The line through all panels, and the stop of each position. */
  .xp__item::before {
    content: '';
    position: absolute;
    left: calc(var(--pad) + 7px);
    top: 0;
    bottom: calc(-1 * var(--joint));
    width: 4px;
    background: var(--panel);
  }
  .xp__item:last-child::before {
    bottom: 50%;
  }
  .xp__item:first-child::before {
    top: calc(var(--pad) + 0.3rem);
  }
  .xp__item::after {
    content: '';
    position: absolute;
    left: var(--pad);
    top: calc(var(--pad) + 0.15rem);
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--sheet);
    border: 4px solid var(--panel);
  }
  .xp__item.is-now::after {
    background: var(--signal);
  }
  @media (min-width: 56rem) {
    .xp__item {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }
  .xp__when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
  }
  @media (min-width: 56rem) {
    .xp__when {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .xp__state {
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    background: var(--panel);
    color: var(--on-panel);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .is-main .xp__state {
    background: var(--signal);
    color: var(--on-signal);
  }
  .xp__period {
    font-family: var(--mono);
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  .xp__role {
    font-size: var(--step-2);
    max-width: 40rem;
  }
  .xp__org {
    margin-top: 0.5rem;
  }
  .xp__org span {
    color: var(--ink-2);
  }
  .xp__summary {
    margin-top: 0.75rem;
    max-width: var(--measure);
    color: var(--ink-2);
  }
  .xp__resp {
    display: grid;
    gap: var(--joint);
    margin-top: 1rem;
    max-width: 48rem;
  }
  .xp__resp li {
    padding: 0.6rem 0.9rem;
    background: var(--ground);
    border-radius: 3px;
    font-size: 0.9375rem;
  }
  .xp__skills {
    margin-top: 1rem;
    color: var(--ink-2);
  }
</style>
