---
// The DSFR poster: the project as a card of the French State's design system (fr-card with a picture),
// with its colour tokens and proportions. The picture area is bleu France with the project's number,
// or the project's image or video when it has one; the status badge sits on it. Under it: detail,
// title, description, and the footer with the frame and the arrow of a link card. Grey border and blue
// bottom line, as on DSFR cards. Scoped here so the fr-* names never leak into the rest of the site.
// The State's logo (bloc-marque) and the Marianne font are not used: they are reserved to State services.
// Sized like every poster, in cqi of its width, so it reads in large and in the strip.
import type { ProjectEntry } from '../lib/snapshot';

interface Props {
  project: ProjectEntry;
  n: string;
  kind: string;
  year: string;
  /** The project has an image or a video: it fills the picture area, given as the slot. */
  withMedia?: boolean;
}
const { project: p, n, kind, year, withMedia = false } = Astro.props;
const status = p.status === 'en-cours' ? { label: 'En cours', cls: 'info' } : p.status === 'termine' ? { label: 'Terminé', cls: 'success' } : null;
const frame = p.category === 'pro' && p.organisation ? p.organisation : 'Projet personnel';
const detail = [kind, year].filter(Boolean).join(' · ');
const longest = p.title.split(/\s+/).reduce((a, b) => ([...b].length > [...a].length ? b : a), '');
// the title fills the card's width without cutting its longest word and keeps to about three lines
// (Arial bold ≈ 0.62 em per letter)
const em = 0.62;
const titleSize = Math.round(Math.min(10, 86 / (Math.max(4, [...longest].length) * em), (3 * 86) / ([...p.title].length * em)) * 10) / 10;
---

<div class="fr-card">
  <div class:list={['fr-card__img', { 'fr-card__img--media': withMedia }]}>
    {withMedia ? <slot /> : <span class="fr-card__number">{n}</span>}
    {status && <p class={`fr-badge fr-badge--${status.cls}`}>{status.label}</p>}
  </div>
  <div class="fr-card__body">
    {detail && <p class="fr-card__detail">{detail}</p>}
    <p class="fr-card__title" style={`--s:${titleSize}`}>{p.title}</p>
    <p class:list={['fr-card__desc', { 'fr-card__desc--short': [...p.title].length > 24 }]}>{p.summary}</p>
    <div class="fr-card__end">
      <span>{frame}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.17 13 10.8 18.36l1.42 1.42L20 12l-7.78-7.78-1.42 1.42L16.17 11H4v2z" /></svg>
    </div>
  </div>
</div>

<style>
  /* DSFR tokens (v1): blue-france-sun-113 and its light tint, grey text, border and mention colours. */
  .fr-card {
    --blue: #000091;
    --blue-light: #8585f6;
    --text: #161616;
    --text-2: #3a3a3a;
    --mention: #666666;
    --border: #dddddd;
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    color: var(--text);
    font-family: Marianne, Arial, Helvetica, sans-serif;
    text-align: left;
    box-shadow:
      inset 0 0 0 0.4cqi var(--border),
      inset 0 -1.8cqi 0 0 var(--blue);
  }

  /* Picture area: bleu France and the number, or the project's image or video. */
  .fr-card__img {
    position: relative;
    flex: none;
    height: 42%;
    display: flex;
    align-items: flex-end;
    padding: 6cqi 7cqi;
    background: var(--blue);
    overflow: hidden;
  }
  .fr-card__number {
    font-size: 33cqi;
    font-weight: 700;
    line-height: 0.78;
    letter-spacing: -0.02em;
    color: var(--blue-light);
  }
  .fr-card__img--media {
    padding: 0;
  }
  .fr-card__img--media :global(.media) {
    position: absolute;
    inset: 0;
  }
  .fr-card__img--media :global(img),
  .fr-card__img--media :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    border-radius: 0;
  }

  /* Badge, on the picture as on DSFR cards. */
  .fr-badge {
    position: absolute;
    top: 6cqi;
    right: 7cqi;
    display: inline-flex;
    align-items: center;
    gap: 1.2cqi;
    padding: 0.5cqi 2.4cqi;
    border-radius: 1cqi;
    font-size: 4cqi;
    font-weight: 700;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .fr-badge::before {
    content: '';
    width: 3cqi;
    height: 3cqi;
    border-radius: 50%;
    border: 0.6cqi solid currentColor;
  }
  .fr-badge--info {
    background: #e8edff;
    color: #0063cb;
  }
  .fr-badge--success {
    background: #b8fec9;
    color: #18753c;
  }
  .fr-badge--success::before {
    background: currentColor;
  }

  /* Body: detail, title in bleu France, description, footer. */
  .fr-card__body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 3cqi;
    padding: 6cqi 7cqi 8cqi;
  }
  .fr-card__detail {
    font-size: 4.6cqi;
    line-height: 1.3;
    color: var(--mention);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .fr-card__title {
    font-size: calc(var(--s) * 1cqi);
    font-weight: 700;
    line-height: 1.1;
    color: var(--blue);
    overflow-wrap: break-word;
  }
  .fr-card__desc {
    min-height: 0;
    font-size: 5.2cqi;
    line-height: 1.45;
    color: var(--text-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* a long title leaves room for two lines of description */
  .fr-card__desc--short {
    -webkit-line-clamp: 2;
  }
  .fr-card__end {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3cqi;
    padding-top: 3.4cqi;
    border-top: 0.4cqi solid var(--border);
    font-size: 4.6cqi;
    color: var(--mention);
  }
  .fr-card__end span {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .fr-card__end svg {
    flex: none;
    width: 7.6cqi;
    height: 7.6cqi;
    fill: var(--blue);
  }
</style>
