---
import type { ExperienceEntry } from '../lib/content';
import { formatPeriod } from '../lib/format';
import Arrow from './Arrow.astro';

interface Props {
  experiences: ExperienceEntry[];
}
const { experiences } = Astro.props;
---

<section class="journey section" id="parcours" aria-labelledby="journey-title">
  <div class="wrap">
    <header class="sec-head">
      <h2 id="journey-title">Parcours</h2>
      <p class="label">{experiences.length} postes</p>
    </header>

    <ol role="list" class="xp">
      {
        experiences.map((e, i) => (
          <li class="xp__item grid" data-reveal style={`--d:${i % 3}`}>
            <p class="xp__when label">
              {formatPeriod(e.start, e.end, !e.end)}
              {e.location && <span>{e.location}</span>}
            </p>
            <div class="xp__who">
              <h3 class="xp__role serif">{e.role}</h3>
              <p class="xp__org">
                {e.url ? (
                  <a class="link" href={e.url} rel="noopener">
                    {e.organisation} <Arrow dir="out" />
                  </a>
                ) : (
                  e.organisation
                )}
                {e.parentOrganisation && <span class="muted"> — {e.parentOrganisation}</span>}
              </p>
            </div>
            <div class="xp__what">
              {e.summary && <p class="xp__sum">{e.summary}</p>}
              {e.responsibilities.length > 0 && (
                <ul role="list" class="xp__list">
                  {e.responsibilities.map((r) => (
                    <li>{r}</li>
                  ))}
                </ul>
              )}
              {e.skills.length > 0 && <p class="xp__skills label">{e.skills.join(' · ')}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .xp__item {
    padding-block: clamp(1.75rem, 3vw, 2.75rem);
    border-bottom: 1px solid var(--rule);
    row-gap: 1rem;
  }
  .xp__when {
    grid-column: 1 / span 2;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .xp__who {
    grid-column: 3 / span 5;
  }
  .xp__role {
    font-weight: 300;
    font-size: clamp(1.6rem, 1rem + 1.6vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .xp__org {
    margin-top: 0.75rem;
  }
  .xp__org .arrow {
    width: 0.7em;
  }
  .xp__what {
    grid-column: 8 / span 5;
  }
  .xp__sum {
    font-size: 1.0625rem;
  }
  .xp__list {
    margin-top: 1rem;
    color: var(--fg-2);
    font-size: 0.9375rem;
  }
  .xp__list li {
    position: relative;
    padding-left: 1.1rem;
    margin-top: 0.4rem;
  }
  .xp__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.5rem;
    border-top: 1px solid var(--rule-strong);
  }
  .xp__skills {
    margin-top: 1.25rem;
    letter-spacing: 0.06em;
  }
  @media (max-width: 63.99rem) {
    .xp__when {
      grid-column: 1 / -1;
      flex-direction: row;
      gap: 1rem;
    }
    .xp__who {
      grid-column: 1 / span 6;
    }
    .xp__what {
      grid-column: 7 / -1;
    }
  }
  @media (max-width: 47.99rem) {
    .xp__who,
    .xp__what {
      grid-column: 1 / -1;
    }
    .xp__when {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
