---
// The whole public site: one page rendered from content data. Used by "/" (published content) and by the
// admin preview of the draft ("/admin/apercu/"), so both are guaranteed to look the same.
// Import order = CSS order: the sections before the layout, as when this markup lived in pages/index.astro.
import About from './About.astro';
import Contact from './Contact.astro';
import Hero from './Hero.astro';
import Journey from './Journey.astro';
import Projects from './Projects.astro';
import Skills from './Skills.astro';
import Base from '../layouts/Base.astro';
import type { MediaResolver } from '../lib/media';
import { resolveSite } from '../lib/site';
import type { SiteData } from '../lib/snapshot';
import { personLd, profilePageLd, projectsLd } from '../lib/structured-data';

interface Props {
  data: SiteData;
  media: MediaResolver;
  /** Admin preview: not indexable, with a banner. */
  preview?: boolean;
  /** Text of the banner (default: draft preview). */
  note?: string;
}
const { data, media, preview = false, note } = Astro.props;
const { profile, seo, projects, experiences, skills } = data;
const page = seo.pages.home;
const share = media(page.ogImage ?? seo.defaultOgImage);
// Everything the page shows is decided from the content (src/lib/site.ts).
const site = resolveSite(data);
const cvUrl = profile.cv?.startsWith('files/') ? media(profile.cv)?.src : profile.cv;
---

<Base
  title={page.title ?? `${profile.name} — ${profile.jobTitle}`}
  description={page.description ?? seo.defaultDescription}
  image={share?.src}
  noindex={preview || page.noindex}
  profile={profile}
  sections={site.sections}
  threads={site.threads}
  ambiance={site.site.appearance.ambiance}
  scene={site.site.appearance.scene}
  type="profile"
  jsonLd={preview
    ? []
    : [personLd(profile, experiences, skills.groups.flatMap((g) => g.items)), profilePageLd('/', page.title ?? profile.name), projectsLd(projects)]}
>
  {
    preview && (
      <p class="preview-banner" role="note">
        {note ?? 'Aperçu du brouillon, visible par vous seul.'} <a href="/admin/">Retour à l'administration</a>
      </p>
    )
  }
  <Hero site={site} media={media} />
  {
    site.sections.map((sec) => {
      switch (sec.id) {
        case 'projets':
          return <Projects section={sec} featured={site.featured} others={site.others} othersTitle={site.othersTitle} threads={site.threads} media={media} />;
        case 'parcours':
          return <Journey section={sec} chapters={site.chapters} rest={site.rest} threads={site.threads} glow={site.ambiance.glow} />;
        case 'competences':
          return <Skills section={sec} skills={skills} threads={site.threads} glow={site.ambiance.glow} />;
        case 'a-propos':
          return <About section={sec} profile={profile} experiences={experiences} site={site.site} cvUrl={cvUrl} threads={site.threads} media={media} glow={site.ambiance.glow} />;
        case 'contact':
          return <Contact section={sec} profile={profile} site={site.site} cvUrl={cvUrl} threads={site.threads} glow={site.ambiance.contact} />;
        default:
          return null;
      }
    })
  }
</Base>

<style>
  .preview-banner {
    position: fixed;
    /* above the phones' navigation bar */
    inset: auto 0 var(--bar-h) 0;
    z-index: 60;
    padding: 0.6rem 1rem;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.875rem;
    text-align: center;
  }
  .preview-banner a {
    color: inherit;
    text-decoration: underline;
  }
</style>
