---
import { Image } from 'astro:assets';
import PageHead from '../components/PageHead.astro';
import Base from '../layouts/Base.astro';
import { getExperiences, getProfile, getSeo, getSkills, paragraphs } from '../lib/content';
import { getMedia } from '../lib/media';
import { breadcrumbLd, personLd, profilePageLd } from '../lib/structured-data';

const seo = getSeo();
const page = seo.pages.about;
const profile = getProfile();
const experiences = getExperiences();
const [lead, ...rest] = paragraphs(profile.bio);
// The last paragraph of the bio is a motto: it gets its own sign.
const motto = rest.length > 1 ? rest.at(-1) : undefined;
const bio = motto ? rest.slice(0, -1) : rest;
const photo = getMedia(profile.photo?.src);
const cvHref = profile.cv?.startsWith('files/') ? `/${profile.cv}` : profile.cv;
const current = experiences.find((e) => !e.end);
const skills = getSkills().groups.flatMap((g) => g.items);
---

<Base
  title={page.title ?? 'À propos'}
  description={page.description ?? seo.defaultDescription}
  image={getMedia(page.ogImage ?? seo.defaultOgImage)}
  noindex={page.noindex}
  type="profile"
  jsonLd={[
    personLd(profile, experiences, skills),
    profilePageLd('/a-propos/', page.title ?? 'À propos'),
    breadcrumbLd([{ name: 'Accueil', path: '/' }, { name: 'À propos', path: '/a-propos/' }]),
  ]}
>
  <PageHead label={`${profile.name} · ${profile.jobTitle}`} title="À propos" />

  <div class="wrap about">
    <div class="about__main">
      <section class="panel panel--sheet about__text" aria-label="Présentation">
        <p class="about__lead">{lead}</p>
        <div class="prose">
          {bio.map((t) => <p>{t}</p>)}
        </div>
      </section>
      {
        motto && (
          <p class="panel panel--signal about__motto">
            <span class="label">En une phrase</span>
            {motto}
          </p>
        )
      }
    </div>

    <aside class="about__facts" aria-label="En bref">
      {
        photo && profile.photo && (
          <figure class="panel about__photo">
            <Image src={photo} alt={profile.photo.alt} widths={[360, 720]} sizes="(min-width: 64rem) 22rem, 80vw" />
          </figure>
        )
      }
      <dl class="panel facts">
        <div>
          <dt>Basé à</dt>
          <dd>{profile.location}</dd>
        </div>
        {
          current && (
            <div>
              <dt>En service</dt>
              <dd>
                {current.role.split(' — ')[0]}
                <span>{current.organisation}</span>
              </dd>
            </div>
          )
        }
        <div>
          <dt>Contact</dt>
          <dd>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </dd>
        </div>
      </dl>
      <div class="facts__links">
        <a class="go" href="/parcours/">Parcours complet</a>
        {cvHref && <a class="go" href={cvHref}>Télécharger le CV</a>}
      </div>
    </aside>
  </div>

  {
    profile.principles.length > 0 && (
      <section class="wrap principles" aria-labelledby="principes-title">
        <h2 id="principes-title" class="panel principles__title">
          Ma façon de travailler
        </h2>
        <ul role="list" class="principles__list">
          {profile.principles.map((p) => (
            <li class="panel panel--sheet">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .about {
    display: grid;
    gap: var(--joint);
    padding-top: var(--joint);
  }
  @media (min-width: 64rem) {
    .about {
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: start;
    }
  }
  .about__main {
    display: grid;
    gap: var(--joint);
  }
  .about__lead {
    max-width: 46rem;
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.4;
  }
  @media (min-width: 48rem) {
    .about__lead {
      font-size: var(--step-2);
      line-height: 1.3;
    }
  }
  .about__text .prose {
    margin-top: 1.5rem;
    color: var(--ink-2);
  }
  .about__motto {
    display: grid;
    gap: 0.5rem;
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .about__facts {
    display: grid;
    gap: var(--joint);
  }
  .about__photo :global(img) {
    width: 100%;
    border-radius: 3px;
  }
  .facts {
    display: grid;
    gap: 1rem;
  }
  .facts dt {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-panel-2);
  }
  .facts dd {
    margin-top: 0.15rem;
    font-weight: 800;
    overflow-wrap: anywhere;
  }
  .facts dd span {
    display: block;
    font-weight: 400;
    color: var(--on-panel-2);
  }
  .facts__links {
    display: grid;
    gap: var(--joint);
  }
  .facts__links .go {
    justify-content: space-between;
    padding: 0 1rem;
    background: var(--sheet);
    border-radius: var(--radius);
  }

  .principles {
    display: grid;
    gap: var(--joint);
    margin-top: var(--joint);
  }
  .principles__title {
    font-size: var(--step-3);
  }
  .principles__list {
    display: grid;
    gap: var(--joint);
  }
  @media (min-width: 48rem) {
    .principles__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .principles__list li {
    border-top: 6px solid var(--panel);
  }
  .principles__list h3 {
    font-size: var(--step-1);
  }
  .principles__list p {
    margin-top: 0.5rem;
    color: var(--ink-2);
  }
</style>
