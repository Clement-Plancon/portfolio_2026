---
import { Image } from 'astro:assets';
import PageHead from '../components/PageHead.astro';
import Base from '../layouts/Base.astro';
import { getExperiences, getProfile, getSeo, getSkills, paragraphs } from '../lib/content';
import { getMedia } from '../lib/media';
import { breadcrumbLd, personLd, profilePageLd } from '../lib/structured-data';

const seo = getSeo();
const page = seo.pages.about;
const profile = getProfile();
const experiences = getExperiences();
const [lead, ...rest] = paragraphs(profile.bio);
// The last paragraph of the bio is a motto: it is set apart, in large italic.
const motto = rest.length > 1 ? rest.at(-1) : undefined;
const bio = motto ? rest.slice(0, -1) : rest;
const photo = getMedia(profile.photo?.src);
const cvHref = profile.cv?.startsWith('files/') ? `/${profile.cv}` : profile.cv;
const current = experiences.find((e) => !e.end);
const skills = getSkills().groups.flatMap((g) => g.items);
const numerals = ['i', 'ii', 'iii', 'iv', 'v', 'vi', 'vii', 'viii'];
---

<Base
  title={page.title ?? 'À propos'}
  description={page.description ?? seo.defaultDescription}
  image={getMedia(page.ogImage ?? seo.defaultOgImage)}
  noindex={page.noindex}
  type="profile"
  jsonLd={[
    personLd(profile, experiences, skills),
    profilePageLd('/a-propos/', page.title ?? 'À propos'),
    breadcrumbLd([{ name: 'Accueil', path: '/' }, { name: 'À propos', path: '/a-propos/' }]),
  ]}
>
  <PageHead label={`${profile.name} · ${profile.jobTitle}`} title="À propos" />

  <div class="wrap about">
    <div class="about__text">
      <p class="about__lead">{lead}</p>
      <div class="prose">
        {bio.map((t) => <p>{t}</p>)}
      </div>
    </div>

    <aside class="about__facts" aria-label="En bref">
      {
        photo && profile.photo && (
          <figure class="about__photo">
            <Image src={photo} alt={profile.photo.alt} widths={[360, 720]} sizes="(min-width: 64rem) 22rem, 80vw" />
          </figure>
        )
      }
      <dl>
        <div>
          <dt class="eyebrow">Basé à</dt>
          <dd>{profile.location}</dd>
        </div>
        {
          current && (
            <div>
              <dt class="eyebrow">En poste</dt>
              <dd>
                {current.role}
                <span>{current.organisation}</span>
              </dd>
            </div>
          )
        }
        <div>
          <dt class="eyebrow">Contact</dt>
          <dd>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </dd>
        </div>
      </dl>
      <div class="about__links">
        <a class="arrow" href="/parcours/">Parcours complet</a>
        {cvHref && <a class="arrow" href={cvHref}>Télécharger le CV</a>}
      </div>
    </aside>
  </div>

  {
    motto && (
      <figure class="wrap motto">
        <blockquote>
          <p>{motto}</p>
        </blockquote>
      </figure>
    )
  }

  {
    profile.principles.length > 0 && (
      <section class="wrap section principles" aria-labelledby="principes-title">
        <h2 id="principes-title" class="section__title">
          Ma façon de <em>travailler</em>
        </h2>
        <ol role="list" class="principles__list">
          {profile.principles.map((p, i) => (
            <li>
              <span class="principles__no" aria-hidden="true">
                {numerals[i]}.
              </span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</Base>

<style>
  .about {
    display: grid;
    gap: 3rem clamp(3rem, 2rem + 4vw, 7rem);
    padding-bottom: clamp(3rem, 2rem + 3vw, 5rem);
  }
  @media (min-width: 64rem) {
    .about {
      grid-template-columns: minmax(0, 1fr) 22rem;
    }
  }
  .about__lead {
    font-size: var(--step-2);
    line-height: 1.3;
    letter-spacing: -0.01em;
    max-width: 30ch;
    margin-bottom: 2rem;
  }
  .about__text .prose {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 38ch;
  }
  .about__facts dl {
    display: grid;
    gap: 1.5rem;
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
  }
  .about__facts dd {
    margin-top: 0.35rem;
    overflow-wrap: anywhere;
  }
  .about__facts dd span {
    display: block;
    font-family: var(--sans);
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .about__photo {
    margin-bottom: 2rem;
  }
  .about__photo :global(img) {
    width: 100%;
    filter: grayscale(1) contrast(1.05);
  }
  .about__links {
    display: grid;
    justify-items: start;
    gap: 1rem;
    margin-top: 2rem;
  }
  .motto blockquote {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
    border-block: 1px solid var(--rule);
  }
  .motto p {
    font-style: italic;
    font-size: var(--step-4);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
    max-width: 18ch;
    color: var(--blue);
  }
  .principles .section__title {
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .principles .section__title em {
    color: var(--blue);
  }
  .principles__list {
    display: grid;
    gap: 2.5rem clamp(2rem, 1rem + 4vw, 6rem);
  }
  @media (min-width: 48rem) {
    .principles__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .principles__list li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: 1rem;
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
  }
  .principles__no {
    grid-row: span 2;
    font-style: italic;
    font-size: var(--step-2);
    line-height: 1;
    color: var(--blue);
  }
  .principles__list h3 {
    font-size: var(--step-2);
    line-height: 1.08;
  }
  .principles__list p {
    grid-column: 2;
    margin-top: 0.85rem;
    color: var(--ink-2);
    max-width: 38ch;
  }
</style>
