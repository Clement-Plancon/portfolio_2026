---
import ExperienceList from '../components/ExperienceList.astro';
import PageHead from '../components/PageHead.astro';
import SkillGroups from '../components/SkillGroups.astro';
import Base from '../layouts/Base.astro';
import { getExperiences, getSeo, getSkills } from '../lib/content';
import { getMedia } from '../lib/media';
import { breadcrumbLd } from '../lib/structured-data';

const seo = getSeo();
const page = seo.pages.experience;
const experiences = getExperiences();
const skills = getSkills();
---

<Base
  title={page.title ?? 'Parcours'}
  description={page.description ?? seo.defaultDescription}
  image={getMedia(page.ogImage ?? seo.defaultOgImage)}
  noindex={page.noindex}
  jsonLd={[breadcrumbLd([{ name: 'Accueil', path: '/' }, { name: 'Parcours', path: '/parcours/' }])]}
>
  <PageHead
    label={`${experiences.length} postes · ${skills.groups.length} domaines`}
    title="Parcours"
    lead="Du Lab de la Transformation de Bercy à la police scientifique : des applications métiers pour le service public, et de plus en plus de responsabilités techniques."
  >
    <nav class="jump" aria-label="Sur cette page">
      <a href="#experience">Expérience</a>
      <a href="#competences">Compétences</a>
    </nav>
  </PageHead>

  <div class="wrap sections">
    <section id="experience" aria-labelledby="experience-title">
      <h2 id="experience-title" class="visually-hidden">Expérience</h2>
      <ExperienceList experiences={experiences} />
    </section>

    <section id="competences" class="skills-block" aria-labelledby="competences-title">
      <div class="panel panel--signal skills-block__head">
        <h2 id="competences-title">Compétences</h2>
        <p>Ce que je pratique au quotidien, sans catalogue exhaustif.</p>
      </div>
      <SkillGroups skills={skills} />
    </section>
  </div>
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--joint);
    margin-top: 1.5rem;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.9rem;
    background: var(--panel-2);
    border-radius: 3px;
    font-weight: 800;
    text-decoration: none;
  }
  .jump a:hover {
    background: var(--signal);
    color: var(--on-signal);
  }
  .sections {
    display: grid;
    gap: var(--joint);
    padding-top: var(--joint);
  }
  section {
    scroll-margin-top: 1rem;
  }
  .skills-block {
    display: grid;
    gap: var(--joint);
  }
  .skills-block__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }
  .skills-block__head h2 {
    font-size: var(--step-3);
  }
  .skills-block__head p {
    font-weight: 600;
  }
</style>
