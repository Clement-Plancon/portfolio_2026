---
import ExperienceList from '../components/ExperienceList.astro';
import PageHead from '../components/PageHead.astro';
import SkillGroups from '../components/SkillGroups.astro';
import Base from '../layouts/Base.astro';
import { getExperiences, getSeo, getSkills } from '../lib/content';
import { getMedia } from '../lib/media';
import { breadcrumbLd } from '../lib/structured-data';

const seo = getSeo();
const page = seo.pages.experience;
const experiences = getExperiences();
const skills = getSkills();
---

<Base
  title={page.title ?? 'Parcours'}
  description={page.description ?? seo.defaultDescription}
  image={getMedia(page.ogImage ?? seo.defaultOgImage)}
  noindex={page.noindex}
  jsonLd={[breadcrumbLd([{ name: 'Accueil', path: '/' }, { name: 'Parcours', path: '/parcours/' }])]}
>
  <PageHead
    label={`${experiences.length} postes · ${skills.groups.length} domaines`}
    title="Parcours"
    lead="Du Lab de la Transformation de Bercy à la police scientifique : des applications métiers pour le service public, et de plus en plus de responsabilités techniques."
  >
    <nav class="jump" aria-label="Sur cette page">
      <a class="pill" href="#experience">Expérience</a>
      <a class="pill" href="#competences">Compétences</a>
    </nav>
  </PageHead>

  <section class="wrap" id="experience" aria-labelledby="experience-title">
    <h2 id="experience-title" class="visually-hidden">Expérience</h2>
    <ExperienceList experiences={experiences} />
  </section>

  <section class="wrap section" id="competences" aria-labelledby="competences-title">
    <div class="section__head">
      <h2 class="section__title" id="competences-title">Compétences</h2>
      <p class="meta">Ce que je pratique au quotidien, sans catalogue exhaustif.</p>
    </div>
    <SkillGroups skills={skills} />
  </section>
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
