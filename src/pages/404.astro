---
import Base from '../layouts/Base.astro';

// Built once with the site (no content needed beyond the name in the header and footer).
const profile = { name: 'Clément Plançon', location: 'Paris' };
---

<Base title="Page introuvable — Clément Plançon" description="Cette page n'existe pas : tout le site tient sur une seule page." noindex nav={false} profile={profile}>
  <section class="nf part tone-hero" data-tone="hero" data-part>
    <div class="wrap">
      <p class="label">Erreur 404</p>
      <h1 class="display">Page introuvable</h1>
      <p class="nf__lead">Tout le site tient sur une seule page. Par où reprendre&#8239;?</p>
      <ul role="list" class="nf__ways">
        <li><a class="btn" href="/#projets">Les projets</a></li>
        <li><a class="btn" href="/#a-propos">À propos</a></li>
        <li><a class="btn btn--fill" href="/#contact">Le contact</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 100svh;
    padding-top: calc(var(--header-h) + 4rem);
    padding-bottom: 4rem;
  }
  .nf h1 {
    margin-top: 1.5rem;
    font-size: clamp(3.4rem, 1rem + 11vw, 13rem);
    max-width: 9ch;
  }
  .nf__lead {
    margin-top: 2rem;
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
  }
  .nf__ways {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }
</style>
