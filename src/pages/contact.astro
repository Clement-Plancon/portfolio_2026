---
import ContactBand from '../components/ContactBand.astro';
import Base from '../layouts/Base.astro';
import { getProfile, getSeo } from '../lib/content';
import { getMedia } from '../lib/media';
import { breadcrumbLd } from '../lib/structured-data';

const seo = getSeo();
const page = seo.pages.contact;
const profile = getProfile();
---

<Base
  title={page.title ?? 'Contact'}
  description={page.description ?? seo.defaultDescription}
  image={getMedia(page.ogImage ?? seo.defaultOgImage)}
  noindex={page.noindex}
  contactBand={false}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'ContactPage',
      url: 'https://clementplancon.fr/contact/',
      name: page.title ?? 'Contact',
      mainEntity: { '@id': 'https://clementplancon.fr/#person' },
    },
    breadcrumbLd([{ name: 'Accueil', path: '/' }, { name: 'Contact', path: '/contact/' }]),
  ]}
>
  <div class="contact-page">
    <ContactBand profile={profile} headingLevel="h1" />
  </div>
</Base>

<style>
  .contact-page :global(.contact) {
    padding-top: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }
  .contact-page :global(.contact__sheet) {
    min-height: calc(100svh - var(--header-h) - var(--tabbar-h) - 9rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>
