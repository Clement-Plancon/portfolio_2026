---
import Gallery from '../components/Gallery.astro';
import Base from '../layouts/Base.astro';
import { getExperiences, getProfile, getProjects, getSeo, getSkills } from '../lib/content';
import { emphasis, formatPeriod } from '../lib/format';
import { getMedia } from '../lib/media';
import { personLd, profilePageLd } from '../lib/structured-data';

const profile = getProfile();
const seo = getSeo();
const projects = getProjects();
const experiences = getExperiences();
const current = experiences.filter((e) => !e.end);
const skills = getSkills().groups.flatMap((g) => g.items);
const page = seo.pages.home;
const numerals = ['i', 'ii', 'iii', 'iv', 'v', 'vi', 'vii', 'viii'];
---

<Base
  title={page.title ?? `${profile.name} — ${profile.jobTitle}`}
  description={page.description ?? seo.defaultDescription}
  image={getMedia(page.ogImage ?? seo.defaultOgImage)}
  noindex={page.noindex}
  type="profile"
  jsonLd={[personLd(profile, experiences, skills), profilePageLd('/', page.title ?? profile.name)]}
>
  <section class="wrap intro" aria-labelledby="intro-title">
    <h1 id="intro-title">
      <span class="intro__who eyebrow">{profile.name} — {profile.jobTitle}</span>
      <span class="intro__statement" set:html={emphasis(profile.statement ?? profile.headline)} />
    </h1>
    <div class="intro__cols">
      <p class="intro__text">{profile.intro}</p>
      {
        current.length > 0 && (
          <dl class="intro__now">
            {current.map((e, i) => (
              <div>
                <dt class="eyebrow">{i === 0 ? 'En poste' : 'En parallèle'}</dt>
                <dd>
                  {e.role}
                  <span>{[e.organisation, e.parentOrganisation].filter(Boolean).join(', ')}</span>
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
    <a class="intro__down meta" href="#tirages-title">Voir les projets ↓</a>
  </section>

  <Gallery projects={projects} />

  {
    profile.principles.length > 0 && (
      <section class="wrap section method" aria-labelledby="method-title">
        <h2 class="section__title method__title" id="method-title">
          <span class="eyebrow">Méthode</span>
          <span>
            Comment je <em>travaille</em>
          </span>
        </h2>
        <ol role="list" class="method__list">
          {profile.principles.map((p, i) => (
            <li>
              <span class="method__no" aria-hidden="true">
                {numerals[i]}.
              </span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="wrap section path" aria-labelledby="path-title">
    <div class="section__head">
      <h2 class="section__title" id="path-title">Parcours</h2>
      <a class="arrow" href="/parcours/">Tout le parcours</a>
    </div>
    <ol role="list" class="path__list">
      {
        experiences.map((e) => (
          <li class="path__item">
            <span class="path__years">{formatPeriod(e.start, e.end, !e.end)}</span>
            <span class="path__role">{e.role}</span>
            <span class="path__org meta">{[e.organisation, e.parentOrganisation].filter(Boolean).join(', ')}</span>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    align-content: end;
    min-height: calc(100svh - var(--header-h) - var(--tabbar-h));
    padding-block: clamp(2rem, 1rem + 4vw, 5rem) clamp(2rem, 1rem + 3vw, 4rem);
  }
  .intro h1 {
    display: grid;
    gap: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    font-weight: 300;
  }
  .intro__who {
    line-height: 1.4;
  }
  .intro__statement {
    font-size: var(--step-5);
    line-height: 0.92;
    letter-spacing: -0.04em;
    max-width: 12.5ch;
  }
  .intro__statement :global(em) {
    font-weight: 400;
  }
  .intro__cols {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2rem, 1.5rem + 3vw, 4rem);
  }
  .intro__text {
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 30ch;
  }
  .intro__now {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .intro__now dd {
    margin-top: 0.35rem;
    font-size: 1.0625rem;
    line-height: 1.4;
  }
  .intro__now dd span {
    display: block;
    font-family: var(--sans);
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .intro__now div:first-child dt::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--blue);
    vertical-align: 0.1em;
  }
  .intro__down {
    justify-self: start;
    margin-top: 2.5rem;
    padding-block: 0.6rem;
    text-decoration: none;
  }
  @media (min-width: 48rem) {
    .intro__cols {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1fr);
    }
    .intro__now {
      grid-column: 2 / -1;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .method__title {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 5rem);
  }
  .method__title em {
    color: var(--blue);
  }
  .method__list {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 4rem) clamp(2rem, 1rem + 4vw, 6rem);
  }
  @media (min-width: 48rem) {
    .method__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .method__list li:nth-child(even) {
      margin-top: clamp(2rem, 1rem + 4vw, 6rem);
    }
  }
  .method__list li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: 1rem;
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
  }
  .method__no {
    grid-row: span 2;
    font-style: italic;
    font-size: var(--step-2);
    line-height: 1;
    color: var(--blue);
  }
  .method__list h3 {
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.08;
  }
  .method__list p {
    grid-column: 2;
    margin-top: 0.85rem;
    max-width: 38ch;
    color: var(--ink-2);
  }

  .path__list {
    border-top: 1px solid var(--rule);
  }
  .path__item {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .path__years {
    font-style: italic;
    color: var(--blue);
    font-variant-numeric: oldstyle-nums;
  }
  .path__role {
    font-size: var(--step-1);
    line-height: 1.3;
  }
  @media (min-width: 48rem) {
    .path__item {
      grid-template-columns: 14rem minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: baseline;
    }
  }
</style>
