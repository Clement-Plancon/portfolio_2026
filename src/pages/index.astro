---
// The public one-page, rendered on request from the PUBLISHED content in Netlify Blobs, then cached by
// Netlify's CDN until the next publication (which purges it). No rebuild is needed to publish.
import OnePage from '../components/OnePage.astro';
import { seedSnapshot } from '../lib/seed';
import { mediaResolver } from '../lib/media';
import { toSiteData, type Snapshot } from '../lib/snapshot';
import { setPublicCache } from '../server/public-cache';
import { contentStore } from '../server/runtime';

export const prerender = false;

let snap: Snapshot;
try {
  snap = await contentStore().published();
  setPublicCache(Astro.response.headers);
} catch (e) {
  // Blobs unreachable: show the repository content rather than an error page, and do not cache it.
  console.error(`[site] published content unavailable, showing the repository version: ${(e as Error).name}`);
  snap = seedSnapshot();
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
  Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, s-maxage=60');
}
const data = toSiteData(snap);
---

<OnePage data={data} media={mediaResolver(data, 'public')} />
