---
import Name from '../components/Name.astro';
import ProjectBoard from '../components/ProjectBoard.astro';
import Base from '../layouts/Base.astro';
import { getExperiences, getProfile, getProjects, getSeo, getSkills } from '../lib/content';
import { formatPeriod } from '../lib/format';
import { getMedia } from '../lib/media';
import { personLd, profilePageLd } from '../lib/structured-data';

const profile = getProfile();
const seo = getSeo();
const projects = getProjects();
const experiences = getExperiences();
const current = experiences.filter((e) => !e.end);
const past = experiences.filter((e) => e.end);
const skills = getSkills().groups.flatMap((g) => g.items);
const page = seo.pages.home;
---

<Base
  title={page.title ?? `${profile.name} — ${profile.jobTitle}`}
  description={page.description ?? seo.defaultDescription}
  image={getMedia(page.ogImage ?? seo.defaultOgImage)}
  noindex={page.noindex}
  type="profile"
  jsonLd={[personLd(profile, experiences, skills), profilePageLd('/', page.title ?? profile.name)]}
>
  <div class="wrap home">
    <section class="panel display" aria-labelledby="who">
      <div class="display__top">
        <div class="display__id">
          <h1 id="who" class="display__name"><Name text={profile.name} /></h1>
          <p class="display__role">{profile.jobTitle}</p>
          <p class="display__headline">{profile.headline}</p>
        </div>
        {
          current.length > 0 && (
            <dl class="display__status">
              {current.map((e, i) => (
                <div class:list={{ 'is-main': i === 0 }}>
                  <dt>{i === 0 ? 'En service' : 'En parallèle'}</dt>
                  <dd>
                    {e.role.split(' — ')[0]}
                    <span>
                      {e.organisation}
                      {e.parentOrganisation && ` · ${e.parentOrganisation}`}
                    </span>
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>

      <div class="display__board">
        <h2 class="visually-hidden">Projets</h2>
        <ProjectBoard projects={projects} />
      </div>
    </section>

    <div class="below">
      <section class="panel panel--sheet route" aria-labelledby="parcours-title">
        <div class="below__head">
          <h2 id="parcours-title">Parcours</h2>
          <a class="go" href="/parcours/">Parcours et compétences</a>
        </div>
        <ol role="list" class="stops">
          {
            [...current, ...past].map((e) => (
              <li class:list={{ 'is-now': !e.end }}>
                <span class="stops__when">{formatPeriod(e.start, e.end, !e.end)}</span>
                <span class="stops__what">
                  <strong>{e.role.split(' — ')[0]}</strong>
                  <span>
                    {e.organisation}
                    {e.parentOrganisation && ` · ${e.parentOrganisation}`}
                  </span>
                </span>
              </li>
            ))
          }
        </ol>
      </section>

      {
        profile.principles.length > 0 && (
          <section class="panel panel--sheet method" aria-labelledby="methode-title">
            <div class="below__head">
              <h2 id="methode-title">Ma façon de travailler</h2>
              <a class="go" href="/a-propos/">
                À propos
              </a>
            </div>
            <ul role="list" class="method__list">
              {profile.principles.map((p) => (
                <li>
                  <h3>{p.title}</h3>
                  <p>{p.text}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </div>
</Base>

<style>
  .home {
    display: grid;
    gap: var(--joint);
    padding-top: var(--joint);
  }

  /* --- The display: identity + project board in one sign --- */
  .display {
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
  }
  .display__top {
    display: grid;
    gap: 1.75rem;
    padding-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  @media (min-width: 64rem) {
    .display__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
      align-items: end;
      gap: 3rem;
    }
  }
  .display__name {
    font-size: clamp(2.6rem, 1.6rem + 4.4vw, 5.75rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }
  .display__role {
    margin-top: 0.9rem;
    font-size: var(--step-1);
    font-weight: 800;
    color: var(--signal);
  }
  .display__headline {
    margin-top: 0.4rem;
    max-width: 38rem;
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--on-panel-2);
  }
  .display__status {
    display: grid;
    gap: var(--joint);
    font-size: 0.9375rem;
  }
  .display__status > div {
    padding: 0.75rem 0.9rem;
    background: var(--panel-2);
    border-radius: 3px;
  }
  .display__status dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-panel-2);
  }
  .display__status .is-main dt {
    color: var(--signal);
  }
  .display__status .is-main dt::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal);
    animation: live 2.4s steps(2, jump-none) infinite;
  }
  @keyframes live {
    50% {
      opacity: 0.25;
    }
  }
  .display__status dd {
    margin-top: 0.2rem;
    font-weight: 800;
    line-height: 1.3;
  }
  .display__status dd span {
    display: block;
    font-weight: 400;
    color: var(--on-panel-2);
  }

  /* --- Below the display --- */
  .below {
    display: grid;
    gap: var(--joint);
  }
  @media (min-width: 64rem) {
    .below {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
  .below__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1.25rem;
  }
  .below__head h2 {
    font-size: var(--step-2);
  }
  .below__head .go {
    font-size: var(--step--1);
  }

  /* Experience as stops on a line: the current stop is marked */
  .stops {
    position: relative;
  }
  .stops::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 4px;
    background: var(--panel);
    border-radius: 2px;
  }
  .stops li {
    position: relative;
    display: grid;
    gap: 0.15rem;
    padding: 0 0 1.25rem 2.25rem;
  }
  .stops li:last-child {
    padding-bottom: 0;
  }
  .stops li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.25rem;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--sheet);
    border: 4px solid var(--panel);
  }
  .stops li.is-now::before {
    background: var(--signal);
  }
  .stops__when {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .stops__what strong {
    display: block;
    font-weight: 800;
    line-height: 1.3;
  }
  .stops__what span {
    display: block;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .method__list {
    display: grid;
    gap: 1.25rem 2rem;
  }
  @media (min-width: 40rem) {
    .method__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .method__list li {
    padding-top: 0.75rem;
    border-top: 4px solid var(--panel);
  }
  .method__list h3 {
    font-size: var(--step-0);
  }
  .method__list p {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
</style>
