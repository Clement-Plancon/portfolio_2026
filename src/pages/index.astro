---
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Cover from '../components/Cover.astro';
import Journey from '../components/Journey.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Base from '../layouts/Base.astro';
import { getExperiences, getProfile, getProjects, getSeo, getSkills } from '../lib/content';
import { getMedia } from '../lib/media';
import { personLd, profilePageLd, projectsLd } from '../lib/structured-data';

const profile = getProfile();
const seo = getSeo();
const projects = getProjects();
const experiences = getExperiences();
const skills = getSkills();
const page = seo.pages.home;
---

<Base
  title={page.title ?? `${profile.name} — ${profile.jobTitle}`}
  description={page.description ?? seo.defaultDescription}
  image={getMedia(page.ogImage ?? seo.defaultOgImage)}
  noindex={page.noindex}
  type="profile"
  jsonLd={[
    personLd(profile, experiences, skills.groups.flatMap((g) => g.items)),
    profilePageLd('/', page.title ?? profile.name),
    projectsLd(projects),
  ]}
>
  <Cover profile={profile} projects={projects} experiences={experiences} />
  <About profile={profile} />
  <Projects projects={projects} />
  <Journey experiences={experiences} />
  <Skills skills={skills} />
  <Contact profile={profile} />
</Base>
