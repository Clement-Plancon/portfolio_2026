---
import { Image } from 'astro:assets';
import LineBadge from '../../components/LineBadge.astro';
import Pictogram from '../../components/Pictogram.astro';
import Base from '../../layouts/Base.astro';
import { getProjects, getSeo, type ProjectEntry, paragraphs } from '../../lib/content';
import { formatPeriod } from '../../lib/format';
import { lineCode, lineStyle } from '../../lib/lines';
import { getMedia } from '../../lib/media';
import { breadcrumbLd, PERSON_ID, SITE } from '../../lib/structured-data';

export function getStaticPaths() {
  const projects = getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

interface Props {
  project: ProjectEntry;
  prev: ProjectEntry;
  next: ProjectEntry;
}
const { project: p, prev, next } = Astro.props;
const seo = getSeo();
const period = p.period?.start ? formatPeriod(p.period.start, p.period.end, p.status === 'en-cours') : '';
const path = `/projets/${p.id}/`;
const cover = getMedia(p.cover.image?.src);

const meta = [
  { label: 'Période', value: period || undefined },
  { label: 'Cadre', value: p.organisation === 'Projet personnel' ? undefined : p.organisation },
  { label: 'Type', value: p.category === 'pro' ? 'Projet professionnel' : 'Projet personnel' },
  { label: 'État', value: p.status === 'en-cours' ? 'En développement' : p.status === 'termine' ? 'Terminé' : undefined },
].filter((m) => m.value);

const texts = [
  { id: 'contexte', title: 'Contexte', text: p.context },
  { id: 'probleme', title: 'Problème', text: p.problem },
  { id: 'role', title: 'Mon rôle', text: p.role },
  { id: 'approche', title: 'Approche', text: p.approach },
].filter((s) => s.text);

// The line map: one stop per section actually present on the page.
const stops = [
  ...texts.map((t) => ({ id: t.id, title: t.title })),
  ...(p.contributions.length ? [{ id: 'contributions', title: p.category === 'pro' ? 'Contributions' : 'Fonctionnalités' }] : []),
  ...(p.results.length ? [{ id: 'resultats', title: 'Résultats' }] : []),
  ...(p.technologies.length ? [{ id: 'technologies', title: 'Technologies' }] : []),
  ...(p.gallery.length ? [{ id: 'images', title: 'Images' }] : []),
  ...(p.links.length ? [{ id: 'liens', title: 'Liens' }] : []),
];

const ogImage = getMedia(p.seo.ogImage ?? p.cover.image?.src ?? seo.defaultOgImage);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: p.title,
    description: p.summary,
    url: `${SITE}${path}`,
    inLanguage: 'fr-FR',
    creator: { '@id': PERSON_ID },
    ...(p.period?.start && { dateCreated: p.period.start }),
    ...(p.technologies.length && { keywords: p.technologies.join(', ') }),
  },
  breadcrumbLd([
    { name: 'Accueil', path: '/' },
    { name: 'Projets', path: '/projets/' },
    { name: p.title, path },
  ]),
];
---

<Base
  title={p.seo.title ?? `${p.title} — Projet de Clément Plançon`}
  description={p.seo.description ?? p.summary.slice(0, 165)}
  image={ogImage}
  imageAlt={p.cover.image?.alt}
  noindex={p.seo.noindex}
  type="article"
  jsonLd={jsonLd}
>
  <article class="wrap project" style={lineStyle(p.cover.color)}>
    <div class="crumbs">
      <a class="go go--back" href="/projets/">Tous les projets</a>
      <span class="crumbs__line" aria-hidden="true">Ligne {lineCode(p)}</span>
    </div>

    <header class="head">
      <div class="panel head__info">
        <p class="label">
          {p.kind}
          {!p.visible && <span class="draft">Masqué : visible seulement dans l'aperçu</span>}
        </p>
        <h1>{p.title}</h1>
        <p class="head__summary">{p.summary}</p>
        <dl class="head__meta">
          {
            meta.map((m) => (
              <div>
                <dt>{m.label}</dt>
                <dd>{m.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      {
        cover && p.cover.image ? (
          <figure class="head__sign head__sign--screen">
            <div class="screen">
              <Image
                src={cover}
                alt={p.cover.image.alt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 64rem) 42vw, 100vw"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <figcaption>
              <LineBadge project={p} size="md" transition />
              <span>Capture réelle du site</span>
            </figcaption>
          </figure>
        ) : (
          <figure class="head__sign" aria-label={`Pictogramme de la ligne ${lineCode(p)} (interprétation graphique)`}>
            <LineBadge project={p} size="xl" transition />
            {p.pictogram && <Pictogram name={p.pictogram} size={240} class="head__picto" />}
            <figcaption class="label">Interprétation graphique — pas une capture du produit</figcaption>
          </figure>
        )
      }
    </header>

    <div class="body">
      {
        stops.length > 1 && (
          <nav class="route" aria-label="Sections de la page" data-route>
            <ol role="list">
              {stops.map((s) => (
                <li>
                  <a href={`#${s.id}`}>{s.title}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="sections">
        {
          texts.map((s) => (
            <section class="panel panel--sheet block" id={s.id} aria-labelledby={`${s.id}-t`}>
              <h2 id={`${s.id}-t`}>{s.title}</h2>
              <div class="prose">
                {paragraphs(s.text).map((t) => (
                  <p>{t}</p>
                ))}
              </div>
            </section>
          ))
        }

        {
          p.contributions.length > 0 && (
            <section class="panel panel--sheet block" id="contributions" aria-labelledby="contributions-t">
              <h2 id="contributions-t">{p.category === 'pro' ? 'Contributions' : 'Fonctionnalités'}</h2>
              <ul role="list" class="items">
                {p.contributions.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          p.results.length > 0 && (
            <section class="panel panel--sheet block" id="resultats" aria-labelledby="resultats-t">
              <h2 id="resultats-t">Résultats</h2>
              <ul role="list" class="items">
                {p.results.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          p.technologies.length > 0 && (
            <section class="panel block" id="technologies" aria-labelledby="technologies-t">
              <h2 id="technologies-t">Technologies</h2>
              <ul role="list" class="techs">
                {p.technologies.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          p.gallery.length > 0 && (
            <section class="panel panel--sheet block" id="images" aria-labelledby="images-t">
              <h2 id="images-t">Images</h2>
              <div class="gallery">
                {p.gallery.map((g) => (
                  <figure>
                    <Image src={getMedia(g.src)!} alt={g.alt} widths={[480, 900, 1400]} sizes="(min-width: 64rem) 40vw, 100vw" loading="lazy" />
                    {g.caption && <figcaption>{g.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            </section>
          )
        }

        {
          p.links.length > 0 && (
            <section class="panel panel--signal block" id="liens" aria-labelledby="liens-t">
              <h2 id="liens-t">Liens</h2>
              <ul role="list" class="links">
                {p.links.map((l) => (
                  <li>
                    <a class="go" href={l.url} rel="noopener" target="_blank">
                      {l.label}
                      <span class="visually-hidden"> (nouvel onglet)</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>

    {
      prev.id !== p.id && (
        <nav class="pager" aria-label="Autres projets">
          <a href={`/projets/${prev.id}/`} rel="prev" style={lineStyle(prev.cover.color)}>
            <span class="label">← Projet précédent</span>
            <span class="pager__line">
              <LineBadge project={prev} size="sm" />
              {prev.title}
            </span>
          </a>
          <a href={`/projets/${next.id}/`} rel="next" class="pager__next" style={lineStyle(next.cover.color)}>
            <span class="label">Projet suivant →</span>
            <span class="pager__line">
              {next.title}
              <LineBadge project={next} size="sm" />
            </span>
          </a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .project {
    display: grid;
    gap: var(--joint);
    padding-top: var(--joint);
  }
  .crumbs {
    display: flex;
    gap: var(--joint);
  }
  .crumbs > * {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1rem;
    border-radius: var(--radius);
    background: var(--panel);
    color: var(--on-panel);
  }
  .crumbs .go {
    font-size: 0.9375rem;
  }
  .crumbs .go::before {
    background: var(--panel-2);
  }
  .crumbs__line {
    flex: 1;
    justify-content: flex-end;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--on-panel-2);
    border-right: 10px solid var(--line);
  }

  /* --- Head: the information panel + the line sign --- */
  .head {
    display: grid;
    gap: var(--joint);
  }
  @media (min-width: 64rem) {
    .head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .head__info {
    padding-block: clamp(1.5rem, 1rem + 2.5vw, 3.25rem);
  }
  .draft {
    display: inline-block;
    margin-left: 0.75rem;
    padding: 0.1rem 0.5rem;
    background: var(--signal);
    color: var(--on-signal);
    border-radius: 3px;
  }
  .head h1 {
    margin-top: 0.75rem;
    font-size: var(--step-4);
    letter-spacing: -0.035em;
  }
  .head__summary {
    margin-top: 1.1rem;
    max-width: 42rem;
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--on-panel-2);
  }
  .head__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--joint);
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  .head__meta > div {
    padding: 0.7rem 0.9rem;
    background: var(--panel-2);
    border-radius: 3px;
  }
  .head__meta dt {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-panel-2);
  }
  .head__meta dd {
    margin-top: 0.15rem;
    font-weight: 800;
  }

  .head__sign {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(16rem, 12rem + 16vw, 30rem);
    padding: var(--pad);
    border-radius: var(--radius);
    background: var(--line);
    color: var(--line-text);
    overflow: hidden;
  }
  .head__sign > :global(.badge) {
    position: absolute;
    top: var(--pad);
    left: var(--pad);
    background: var(--panel);
    color: var(--line);
  }
  .head__sign :global(.head__picto) {
    width: min(62%, 15rem);
    height: auto;
    stroke-width: 1.5;
  }
  .head__sign figcaption.label {
    position: absolute;
    left: var(--pad);
    right: var(--pad);
    bottom: 1rem;
    font-size: 0.6875rem;
    color: inherit;
  }
  .head__sign--screen {
    background: var(--panel);
    color: var(--on-panel);
    place-items: stretch;
    grid-template-rows: 1fr auto;
    gap: 1rem;
  }
  .screen {
    display: grid;
    place-items: center;
    padding: clamp(0.5rem, 1.5vw, 1rem);
    background: #000;
    border-radius: 6px;
    border: 3px solid var(--line);
  }
  .screen :global(img) {
    width: 100%;
    border-radius: 2px;
  }
  .head__sign--screen figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--on-panel-2);
  }

  /* --- Body: line map + sections --- */
  .body {
    display: grid;
    gap: var(--joint);
  }
  @media (min-width: 64rem) {
    .body {
      grid-template-columns: 15rem minmax(0, 1fr);
      align-items: start;
    }
  }
  .route {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--panel);
    color: var(--on-panel);
    border-radius: var(--radius);
    padding: 1.25rem 1rem;
  }
  .route ol {
    position: relative;
  }
  .route ol::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 1rem;
    bottom: 1rem;
    width: 4px;
    border-radius: 2px;
    background: var(--line);
  }
  .route a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    padding-left: 2rem;
    color: var(--on-panel-2);
    font-weight: 700;
    text-decoration: none;
  }
  .route a::before {
    content: '';
    position: absolute;
    left: 0;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--panel);
    border: 4px solid var(--line);
    transition:
      background-color var(--dur-1) ease,
      transform var(--dur-2) var(--ease);
  }
  .route a:hover {
    color: var(--on-panel);
  }
  .route a[aria-current='location'] {
    color: var(--signal);
  }
  .route a[aria-current='location']::before {
    background: var(--signal);
    transform: scale(1.15);
  }
  @media (min-width: 64rem) {
    .route {
      top: 1rem;
    }
  }
  /* Phones and tablets: the map becomes a horizontal line of stops, stuck to the top. */
  @media (max-width: 63.99rem) {
    .route {
      padding: 0.25rem 0.5rem;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .route ol {
      display: flex;
      width: max-content;
    }
    .route ol::before {
      top: auto;
      bottom: 12px;
      left: 1rem;
      right: 1rem;
      width: auto;
      height: 4px;
    }
    .route a {
      flex-direction: column;
      justify-content: flex-start;
      gap: 0.35rem;
      min-height: 3.25rem;
      padding: 0.5rem 0.9rem 0;
      font-size: 0.8125rem;
      white-space: nowrap;
    }
    .route a::before {
      position: static;
      order: 2;
      width: 16px;
      height: 16px;
      border-width: 3px;
    }
  }

  .sections {
    display: grid;
    gap: var(--joint);
    min-width: 0;
  }
  .block h2 {
    margin-bottom: 1rem;
    font-size: var(--step-2);
  }
  .block {
    scroll-margin-top: 5rem;
  }
  .prose {
    font-size: var(--step-0);
  }
  .items {
    display: grid;
    gap: var(--joint);
  }
  .items li {
    position: relative;
    padding: 0.75rem 1rem 0.75rem 2.75rem;
    background: var(--ground);
    border-radius: 3px;
  }
  .items li::before {
    content: '';
    position: absolute;
    left: 1rem;
    top: 1.15rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 3px solid var(--panel);
    background: var(--line);
  }
  .techs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--joint);
  }
  .techs li {
    padding: 0.55rem 0.85rem;
    background: var(--panel-2);
    border-radius: 3px;
    font-family: var(--mono);
    font-size: 0.9375rem;
  }
  .links {
    display: grid;
    gap: 0.5rem;
  }
  .links .go {
    font-size: var(--step-1);
  }
  .gallery {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 48rem) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .gallery :global(img) {
    width: 100%;
    border-radius: 3px;
  }
  .gallery figcaption {
    margin-top: 0.4rem;
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  /* --- Pager --- */
  .pager {
    display: grid;
    gap: var(--joint);
  }
  @media (min-width: 48rem) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pager a {
    display: grid;
    gap: 0.6rem;
    padding: var(--pad);
    border-radius: var(--radius);
    background: var(--panel);
    color: var(--on-panel);
    text-decoration: none;
    border-bottom: 6px solid var(--line);
    transition: background-color var(--dur-1) ease;
  }
  .pager a:hover {
    background: var(--panel-2);
  }
  .pager .label {
    color: var(--on-panel-2);
  }
  .pager__line {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: var(--step-2);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .pager__next {
    justify-items: end;
    text-align: right;
  }
</style>
