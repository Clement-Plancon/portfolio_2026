---
import { Image } from 'astro:assets';
import Print from '../../components/Print.astro';
import Base from '../../layouts/Base.astro';
import { getProjects, getSeo, type ProjectEntry, paragraphs } from '../../lib/content';
import { formatPeriod } from '../../lib/format';
import { getMedia } from '../../lib/media';
import { PHOTOGRAM_LABELS, photogram } from '../../lib/photogram';
import { breadcrumbLd, PERSON_ID, SITE } from '../../lib/structured-data';

export function getStaticPaths() {
  const projects = getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      index: i,
      total: projects.length,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

interface Props {
  project: ProjectEntry;
  index: number;
  total: number;
  prev: ProjectEntry;
  next: ProjectEntry;
}
const { project: p, index, total, prev, next } = Astro.props;
const seo = getSeo();
const period = p.period?.start ? formatPeriod(p.period.start, p.period.end, p.status === 'en-cours') : '';
const path = `/projets/${p.id}/`;
const cover = getMedia(p.cover.image?.src);
const pg = photogram(p.id, p.cover.color, p.pictogram);
const no = String(index + 1).padStart(2, '0');
const numerals = ['i', 'ii', 'iii', 'iv', 'v', 'vi', 'vii', 'viii', 'ix', 'x'];

const facts = [
  { label: 'Cadre', value: p.organisation === 'Projet personnel' ? undefined : p.organisation },
  { label: 'Période', value: period || undefined },
  { label: 'Nature', value: p.kind },
  { label: 'État', value: p.status === 'en-cours' ? 'En développement' : p.status === 'termine' ? 'Terminé' : undefined },
].filter((m) => m.value);

const texts = [
  { id: 'contexte', title: 'Contexte', text: p.context },
  { id: 'probleme', title: 'Problème', text: p.problem },
  { id: 'role', title: 'Mon rôle', text: p.role },
  { id: 'approche', title: 'Approche', text: p.approach },
].filter((s) => s.text);

const sections = [
  ...texts.map((t) => ({ id: t.id, title: t.title })),
  ...(p.contributions.length ? [{ id: 'contributions', title: p.category === 'pro' ? 'Contributions' : 'Fonctionnalités' }] : []),
  ...(p.results.length ? [{ id: 'resultats', title: 'Résultats' }] : []),
  ...(p.technologies.length ? [{ id: 'technologies', title: 'Technologies' }] : []),
  ...(p.gallery.length ? [{ id: 'images', title: 'Images' }] : []),
  ...(p.links.length ? [{ id: 'liens', title: 'Liens' }] : []),
];
const num = (id: string) => numerals[sections.findIndex((s) => s.id === id)];

const ogImage = getMedia(p.seo.ogImage ?? p.cover.image?.src ?? seo.defaultOgImage);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: p.title,
    description: p.summary,
    url: `${SITE}${path}`,
    inLanguage: 'fr-FR',
    creator: { '@id': PERSON_ID },
    ...(p.period?.start && { dateCreated: p.period.start }),
    ...(p.technologies.length && { keywords: p.technologies.join(', ') }),
  },
  breadcrumbLd([
    { name: 'Accueil', path: '/' },
    { name: 'Projets', path: '/projets/' },
    { name: p.title, path },
  ]),
];
---

<Base
  title={p.seo.title ?? `${p.title} — Projet de Clément Plançon`}
  description={p.seo.description ?? p.summary.slice(0, 165)}
  image={ogImage}
  imageAlt={p.cover.image?.alt}
  noindex={p.seo.noindex}
  type="article"
  jsonLd={jsonLd}
>
  <article class="project">
    <header class="wrap head">
      <a class="arrow arrow--back head__back" href="/projets/">Tous les projets</a>
      <div class="head__grid">
        <div class="head__text">
          <p class="eyebrow">
            Tirage {no} / {String(total).padStart(2, '0')} · {p.category === 'pro' ? 'Projet professionnel' : 'Projet personnel'}
          </p>
          <h1>{p.title}</h1>
          <p class="lede head__lede">{p.summary}</p>
          {
            facts.length > 0 && (
              <dl class="facts">
                {facts.map((f) => (
                  <div>
                    <dt class="eyebrow">{f.label}</dt>
                    <dd>{f.value}</dd>
                  </div>
                ))}
              </dl>
            )
          }
        </div>
        <figure class="head__print" id="project-print">
          <Print project={p} transition eager sizes="(min-width: 64rem) 38vw, 90vw" />
          <figcaption class="meta">
            {
              cover ? (
                <>
                  <span>Capture réelle, tirée en cyanotype.</span>
                  <button type="button" class="pill head__toggle" data-true-colors aria-pressed="false" aria-controls="project-print">
                    Voir en couleurs réelles
                  </button>
                </>
              ) : (
                <span>
                  Photogramme ({PHOTOGRAM_LABELS[pg.kind].toLowerCase()}) : un visuel de présentation, pas une capture du produit.
                </span>
              )
            }
          </figcaption>
        </figure>
      </div>
    </header>

    {
      sections.length > 0 && (
        <div class="wrap body">
          {sections.length > 1 && (
            <nav class="toc" aria-label="Sommaire du projet" data-toc>
              <p class="eyebrow">Sommaire</p>
              <ol role="list">
                {sections.map((s, i) => (
                  <li>
                    <a href={`#${s.id}`}>
                      <span aria-hidden="true">{numerals[i]}.</span> {s.title}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )}

          <div class="sections">
            {texts.map((s) => (
              <section class="block" id={s.id} aria-labelledby={`${s.id}-t`}>
                <h2 id={`${s.id}-t`}>
                  <span class="block__no" aria-hidden="true">
                    {num(s.id)}.
                  </span>
                  {s.title}
                </h2>
                <div class="prose">
                  {paragraphs(s.text).map((t) => (
                    <p>{t}</p>
                  ))}
                </div>
              </section>
            ))}

            {p.contributions.length > 0 && (
              <section class="block" id="contributions" aria-labelledby="contributions-t">
                <h2 id="contributions-t">
                  <span class="block__no" aria-hidden="true">
                    {num('contributions')}.
                  </span>
                  {p.category === 'pro' ? 'Contributions' : 'Fonctionnalités'}
                </h2>
                <ol role="list" class="items">
                  {p.contributions.map((c) => (
                    <li>{c}</li>
                  ))}
                </ol>
              </section>
            )}

            {p.results.length > 0 && (
              <section class="block" id="resultats" aria-labelledby="resultats-t">
                <h2 id="resultats-t">
                  <span class="block__no" aria-hidden="true">
                    {num('resultats')}.
                  </span>
                  Résultats
                </h2>
                <ol role="list" class="items">
                  {p.results.map((r) => (
                    <li>{r}</li>
                  ))}
                </ol>
              </section>
            )}

            {p.technologies.length > 0 && (
              <section class="block" id="technologies" aria-labelledby="technologies-t">
                <h2 id="technologies-t">
                  <span class="block__no" aria-hidden="true">
                    {num('technologies')}.
                  </span>
                  Technologies
                </h2>
                <ul role="list" class="techs">
                  {p.technologies.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </section>
            )}

            {p.gallery.length > 0 && (
              <section class="block" id="images" aria-labelledby="images-t">
                <h2 id="images-t">
                  <span class="block__no" aria-hidden="true">
                    {num('images')}.
                  </span>
                  Images
                </h2>
                <div class="shots">
                  {p.gallery.map((g) => (
                    <figure>
                      <Image src={getMedia(g.src)!} alt={g.alt} widths={[480, 900, 1400]} sizes="(min-width: 64rem) 50vw, 100vw" loading="lazy" />
                      {g.caption && <figcaption class="meta">{g.caption}</figcaption>}
                    </figure>
                  ))}
                </div>
              </section>
            )}

            {p.links.length > 0 && (
              <section class="block" id="liens" aria-labelledby="liens-t">
                <h2 id="liens-t">
                  <span class="block__no" aria-hidden="true">
                    {num('liens')}.
                  </span>
                  Liens
                </h2>
                <ul role="list" class="links">
                  {p.links.map((l) => (
                    <li>
                      <a class="pill" href={l.url} rel="noopener" target="_blank">
                        {l.label} <span aria-hidden="true">↗</span>
                        <span class="visually-hidden"> (nouvel onglet)</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        </div>
      )
    }

    {
      next.id !== p.id && (
        <nav class="wrap pager" aria-label="Autres projets">
          <a class="pager__prev arrow arrow--back" href={`/projets/${prev.id}/`} rel="prev">
            {prev.title}
          </a>
          <a class="pager__next" href={`/projets/${next.id}/`} rel="next" data-card>
            <span class="eyebrow">Tirage suivant</span>
            <span class="pager__title">{next.title}</span>
            <Print project={next} transition sizes="(min-width: 64rem) 22vw, 60vw" />
          </a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .head {
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(3rem, 2rem + 4vw, 6rem);
  }
  .head__back {
    margin-bottom: clamp(2rem, 1.5rem + 3vw, 4rem);
  }
  .head__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 5rem);
    align-items: start;
  }
  @media (min-width: 64rem) {
    .head__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
    .head__print {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }
  @media (max-width: 63.99rem) {
    /* On phones the print comes first: it is the image the visitor just tapped. */
    .head__print {
      order: -1;
      width: min(100%, 26rem);
    }
  }
  .head h1 {
    margin-top: 1.25rem;
    font-size: var(--step-4);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  .head__lede {
    margin-top: 1.75rem;
    max-width: 32ch;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.5rem 2rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .facts dd {
    margin-top: 0.35rem;
    font-size: 1.0625rem;
    line-height: 1.4;
  }
  .head__print figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 1.25rem;
  }
  .head__toggle[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
  }

  .body {
    display: grid;
    gap: 3rem;
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
  }
  @media (min-width: 64rem) {
    .body {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: clamp(3rem, 2rem + 4vw, 7rem);
    }
    .toc {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }
  }
  .toc ol {
    margin-top: 1rem;
    display: grid;
    gap: 0.15rem;
  }
  .toc a {
    display: block;
    padding-block: 0.4rem;
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--dur-1) ease;
  }
  .toc a span {
    display: inline-block;
    min-width: 2.25rem;
    font-style: italic;
    color: var(--ink-3);
  }
  .toc a[aria-current='location'] {
    color: var(--ink);
  }
  .toc a[aria-current='location'] span {
    color: var(--blue);
  }
  @media (max-width: 63.99rem) {
    .toc ol {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.25rem;
    }
  }

  .sections {
    display: grid;
    gap: clamp(3rem, 2.5rem + 3vw, 5.5rem);
  }
  .block {
    border-top: 1px solid var(--rule);
    padding-top: 1.75rem;
  }
  .block h2 {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-size: var(--step-3);
    font-weight: 300;
    margin-bottom: 1.5rem;
  }
  .block__no {
    font-style: italic;
    font-size: 0.55em;
    color: var(--blue);
    min-width: 2.5rem;
  }
  .block .prose {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 38ch;
  }
  .items {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
    counter-reset: item;
  }
  .items li {
    counter-increment: item;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .items li::before {
    content: counter(item, decimal-leading-zero);
    font-family: var(--sans);
    font-size: 0.8125rem;
    color: var(--ink-3);
    padding-top: 0.45em;
  }
  .techs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .techs li {
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--rule);
    border-radius: 99px;
    font-family: var(--sans);
    font-size: 0.9375rem;
  }
  .shots {
    display: grid;
    gap: 2rem;
  }
  .shots figcaption {
    margin-top: 0.75rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .pager {
    display: grid;
    gap: 2.5rem;
    align-items: end;
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(1rem, 0.5rem + 2vw, 3rem);
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 48rem) {
    .pager {
      grid-template-columns: 1fr minmax(14rem, 22rem);
    }
  }
  .pager__prev {
    justify-self: start;
  }
  .pager__next {
    display: grid;
    gap: 0.75rem;
    text-decoration: none;
  }
  .pager__title {
    font-size: var(--step-2);
    line-height: 1.05;
  }
  .pager__next :global(.print) {
    margin-top: 0.75rem;
    transition: transform var(--dur-3) var(--ease);
  }
  .pager__next:hover :global(.print) {
    transform: translateY(-6px) rotate(0.6deg);
  }
  .pager__next:hover :global(.print__light) {
    opacity: 1;
  }
</style>
