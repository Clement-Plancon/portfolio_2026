---
import PageHead from '../../components/PageHead.astro';
import PrintCard from '../../components/PrintCard.astro';
import Base from '../../layouts/Base.astro';
import { getProjects, getSeo } from '../../lib/content';
import { getMedia } from '../../lib/media';
import { breadcrumbLd } from '../../lib/structured-data';

const seo = getSeo();
const page = seo.pages.projects;
const projects = getProjects();
const groups = [
  { id: 'pro', title: 'Projets professionnels', items: projects.filter((p) => p.category === 'pro') },
  { id: 'perso', title: 'Projets personnels', items: projects.filter((p) => p.category === 'perso') },
].filter((g) => g.items.length > 0);
---

<Base
  title={page.title ?? 'Projets'}
  description={page.description ?? seo.defaultDescription}
  image={getMedia(page.ogImage ?? seo.defaultOgImage)}
  noindex={page.noindex}
  jsonLd={[breadcrumbLd([{ name: 'Accueil', path: '/' }, { name: 'Projets', path: '/projets/' }])]}
>
  <PageHead
    label={`${projects.length} projets`}
    title="La planche *contact*"
    lead="Logiciels pour l'administration, recherche utilisateur, données publiques, application mobile. Chaque projet est un tirage : ouvrez celui qui vous intrigue."
  >
    <nav class="jump" aria-label="Catégories de projets">
      {
        groups.map((g) => (
          <a class="pill" href={`#${g.id}`}>
            {g.title} <span>{g.items.length}</span>
          </a>
        ))
      }
    </nav>
  </PageHead>

  {
    groups.map((g) => (
      <section class="wrap sheet" id={g.id} aria-labelledby={`${g.id}-title`}>
        <h2 id={`${g.id}-title`} class="sheet__title">
          {g.title}
        </h2>
        <ol role="list" class="sheet__grid">
          {g.items.map((p) => (
            <li>
              <PrintCard project={p} index={projects.indexOf(p)} total={projects.length} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 90vw" />
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .jump span {
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .jump a:hover span {
    color: inherit;
  }
  .sheet {
    padding-block: clamp(2rem, 1.5rem + 3vw, 5rem);
  }
  .sheet__title {
    font-size: var(--step-2);
    font-style: italic;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }
  .sheet__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 3vw, 5rem) clamp(1.5rem, 1rem + 3vw, 4.5rem);
  }
  @media (min-width: 40rem) {
    .sheet__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sheet__grid li:nth-child(even) {
      margin-top: clamp(3rem, 1rem + 6vw, 7rem);
    }
  }
  @media (min-width: 64rem) {
    .sheet__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .sheet__grid li:nth-child(even) {
      margin-top: 0;
    }
    .sheet__grid li:nth-child(3n + 2) {
      margin-top: clamp(4rem, 2rem + 6vw, 9rem);
    }
    .sheet__grid li:nth-child(3n) {
      margin-top: clamp(2rem, 1rem + 3vw, 4.5rem);
    }
  }
</style>
