---
import PageHead from '../../components/PageHead.astro';
import ProjectBoard from '../../components/ProjectBoard.astro';
import Base from '../../layouts/Base.astro';
import { getProjects, getSeo } from '../../lib/content';
import { getMedia } from '../../lib/media';
import { breadcrumbLd } from '../../lib/structured-data';

const seo = getSeo();
const page = seo.pages.projects;
const projects = getProjects();
const groups = [
  { id: 'pro', title: 'Projets professionnels', label: 'Projet', items: projects.filter((p) => p.category === 'pro') },
  { id: 'perso', title: 'Projets personnels', label: 'Projet', items: projects.filter((p) => p.category === 'perso') },
].filter((g) => g.items.length > 0);
---

<Base
  title={page.title ?? 'Projets'}
  description={page.description ?? seo.defaultDescription}
  image={getMedia(page.ogImage ?? seo.defaultOgImage)}
  noindex={page.noindex}
  jsonLd={[breadcrumbLd([{ name: 'Accueil', path: '/' }, { name: 'Projets', path: '/projets/' }])]}
>
  <PageHead
    label={`${projects.length} projets`}
    title="Projets"
    lead="Logiciels pour l'administration, recherche utilisateur, donnée publique et application mobile. Chaque projet a sa ligne : choisissez-en une."
  >
    <nav class="jump" aria-label="Catégories de projets">
      {
        groups.map((g) => (
          <a href={`#${g.id}`}>
            {g.title} <span>{g.items.length}</span>
          </a>
        ))
      }
    </nav>
  </PageHead>

  <div class="wrap groups">
    {
      groups.map((g) => (
        <section class="panel" id={g.id} aria-labelledby={`${g.id}-title`}>
          <h2 id={`${g.id}-title`} class="group__title">
            {g.title}
          </h2>
          <ProjectBoard projects={g.items} id={`board-${g.id}`} label={g.label} />
        </section>
      ))
    }
  </div>
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--joint);
    margin-top: 1.5rem;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0 0.9rem;
    background: var(--panel-2);
    border-radius: 3px;
    font-weight: 800;
    text-decoration: none;
  }
  .jump a:hover {
    background: var(--signal);
    color: var(--on-signal);
  }
  .jump span {
    font-family: var(--mono);
    font-weight: 500;
    color: var(--signal);
  }
  .jump a:hover span {
    color: var(--on-signal);
  }
  .groups {
    display: grid;
    gap: var(--joint);
    padding-top: var(--joint);
  }
  .group__title {
    margin-bottom: 1.5rem;
    font-size: var(--step-2);
  }
</style>
