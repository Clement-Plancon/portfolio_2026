---
import PageHead from '../../components/PageHead.astro';
import ProjectIndex from '../../components/ProjectIndex.astro';
import Base from '../../layouts/Base.astro';
import { getProjects, getSeo } from '../../lib/content';
import { getMedia } from '../../lib/media';
import { breadcrumbLd } from '../../lib/structured-data';

const seo = getSeo();
const page = seo.pages.projects;
const projects = getProjects();
const groups = [
  { id: 'pro', title: 'Projets professionnels', items: projects.filter((p) => p.category === 'pro') },
  { id: 'perso', title: 'Projets personnels', items: projects.filter((p) => p.category === 'perso') },
].filter((g) => g.items.length > 0);
---

<Base
  title={page.title ?? 'Projets'}
  description={page.description ?? seo.defaultDescription}
  image={getMedia(page.ogImage ?? seo.defaultOgImage)}
  noindex={page.noindex}
  jsonLd={[breadcrumbLd([{ name: 'Accueil', path: '/' }, { name: 'Projets', path: '/projets/' }])]}
>
  <PageHead
    title="Projets"
    lead="Des logiciels pour l'administration, de la recherche utilisateur, de la donnée publique et une application mobile : une sélection de ce que je conçois et construis."
  >
    <nav class="jump" aria-label="Catégories de projets">
      {
        groups.map((g) => (
          <a href={`#${g.id}`}>
            {g.title} <span>({g.items.length})</span>
          </a>
        ))
      }
    </nav>
  </PageHead>

  {
    groups.map((g) => (
      <section class="section wrap" id={g.id} aria-labelledby={`${g.id}-title`}>
        <div class="section-head">
          <h2 id={`${g.id}-title`}>{g.title}</h2>
          <span class="section-head__note">
            {g.items.length} projet{g.items.length > 1 ? 's' : ''}
          </span>
        </div>
        <ProjectIndex projects={g.items} />
      </section>
    ))
  }
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-6);
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }
  .jump span {
    margin-left: 0.3em;
    font-weight: 400;
    color: var(--ink-3);
  }
</style>
