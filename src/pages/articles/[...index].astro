---
// The articles index only exists when at least one article is published (no empty section).
import PageHead from '../../components/PageHead.astro';
import Base from '../../layouts/Base.astro';
import { getArticles, getSeo } from '../../lib/content';
import { formatDate } from '../../lib/format';
import { readingTime } from '../../lib/markdown';
import { getMedia } from '../../lib/media';

export function getStaticPaths() {
  return getArticles().length > 0 ? [{ params: { index: undefined } }] : [];
}

const seo = getSeo();
const page = seo.pages.articles;
const articles = getArticles();
---

<Base
  title={page.title ?? 'Articles'}
  description={page.description ?? seo.defaultDescription}
  image={getMedia(page.ogImage ?? seo.defaultOgImage)}
  noindex={page.noindex}
>
  <PageHead label={`${articles.length} article${articles.length > 1 ? 's' : ''}`} title="Articles" lead="Notes techniques sur l'architecture, le développement et la conception de produits." />
  <section class="wrap list" aria-label="Liste des articles">
    <ol role="list" class="articles">
      {
        articles.map((a) => (
          <li>
            <a class="article-row" href={`/articles/${a.id}/`}>
              <span class="eyebrow">
                {a.status === 'draft' ? 'Brouillon' : formatDate(a.publishedAt)} · {readingTime(a.body)} min
              </span>
              <h2>{a.title}</h2>
              <span class="article-row__excerpt">{a.excerpt}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .articles {
    border-top: 1px solid var(--rule);
    padding-bottom: 4rem;
  }
  .article-row {
    display: grid;
    gap: 0.6rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }
  h2 {
    font-size: var(--step-3);
    font-weight: 300;
  }
  .article-row:hover h2 {
    color: var(--blue);
  }
  .article-row__excerpt {
    max-width: var(--measure);
    color: var(--ink-2);
  }
</style>
