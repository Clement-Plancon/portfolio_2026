---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { type ArticleEntry, getArticles } from '../../lib/content';
import { formatDate } from '../../lib/format';
import { readingTime, renderMarkdown } from '../../lib/markdown';
import { getMedia } from '../../lib/media';
import { breadcrumbLd, PERSON_ID, SITE } from '../../lib/structured-data';

export function getStaticPaths() {
  return getArticles().map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article: a } = Astro.props as { article: ArticleEntry };
const path = `/articles/${a.id}/`;
const cover = getMedia(a.cover?.src);
// Safe pipeline: raw HTML is escaped and only http(s)/mailto/relative links survive (see lib/markdown.ts).
const html = renderMarkdown(a.body);
---

<Base
  title={a.seo.title ?? `${a.title} — Clément Plançon`}
  description={a.seo.description ?? a.excerpt.slice(0, 165)}
  image={getMedia(a.seo.ogImage) ?? cover}
  noindex={a.seo.noindex}
  type="article"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: a.title,
      description: a.excerpt,
      url: `${SITE}${path}`,
      inLanguage: 'fr-FR',
      author: { '@id': PERSON_ID },
      ...(a.publishedAt && { datePublished: a.publishedAt }),
      ...(a.updatedAt && { dateModified: a.updatedAt }),
    },
    breadcrumbLd([
      { name: 'Accueil', path: '/' },
      { name: 'Articles', path: '/articles/' },
      { name: a.title, path },
    ]),
  ]}
>
  <article class="wrap article">
    <a class="panel go go--back article__back" href="/articles/">Tous les articles</a>
    <header class="panel article__head">
      {a.status === 'draft' && <p class="draft-flag">Brouillon : visible seulement dans l'aperçu</p>}
      <p class="label">
        {a.publishedAt && <time datetime={a.publishedAt}>{formatDate(a.publishedAt)}</time>}
        {a.publishedAt && ' · '}
        {readingTime(a.body)} min de lecture
      </p>
      <h1>{a.title}</h1>
      <p class="article__excerpt">{a.excerpt}</p>
    </header>
    {
      cover && a.cover && (
        <Image src={cover} alt={a.cover.alt} widths={[640, 1000, 1400]} sizes="(min-width: 64rem) 60rem, 100vw" class="article__cover" loading="eager" />
      )
    }
    <div class="panel panel--sheet article__body">
      <div class="prose" set:html={html} />
    </div>
  </article>
</Base>

<style>
  .article {
    display: grid;
    gap: var(--joint);
    padding-top: var(--joint);
  }
  .article__back {
    justify-self: start;
    padding: 0 1rem;
  }
  .article__back::before {
    background: var(--panel-2);
  }
  .draft-flag {
    display: inline-block;
    margin-bottom: 0.75rem;
    padding: 0.15rem 0.5rem;
    background: var(--signal);
    color: var(--on-signal);
    border-radius: 3px;
    font-weight: 800;
  }
  h1 {
    margin-top: 0.75rem;
    max-width: 52rem;
    font-size: var(--step-4);
    letter-spacing: -0.03em;
  }
  .article__excerpt {
    margin-top: 1rem;
    max-width: 42rem;
    font-size: var(--step-1);
    color: var(--on-panel-2);
  }
  .article__cover {
    width: 100%;
    border-radius: var(--radius);
  }
  .article__body {
    padding-block: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    font-size: var(--step-0);
    line-height: 1.7;
  }
  .article__body .prose {
    margin-inline: auto;
  }
</style>
