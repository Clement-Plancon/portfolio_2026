---
// Preview of the DRAFT, for the authenticated administrator only. Never cached, never indexed.
import OnePage from '../../../components/OnePage.astro';
import { mediaResolver } from '../../../lib/media';
import { toSiteData } from '../../../lib/snapshot';
import { setPrivate } from '../../../server/public-cache';
import { adminAuth, contentStore } from '../../../server/runtime';
import { logLine, redact, StorageError } from '../../../server/storage-error';

export const prerender = false;

setPrivate(Astro.response.headers);
const auth = adminAuth();
let allowed = false;
try {
  if (auth) {
    await auth.verify(Astro.request);
    allowed = true;
  }
} catch {
  allowed = false;
}
if (!allowed) return Astro.redirect('/admin/', 303);

let snap;
try {
  ({ snap } = await contentStore().working());
} catch (e) {
  console.error(`[preview] ${logLine({ event: 'storage_error', type: (e as Error)?.name, message: e instanceof StorageError ? e.message : redact(String((e as Error)?.message ?? e)) })}`);
  return new Response('Le stockage du contenu est momentanément indisponible. Réessayez dans un instant.', {
    status: 503,
    headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'private, no-store', 'Retry-After': '5' },
  });
}
const data = toSiteData(snap, { includeHidden: true });
---

<OnePage data={data} media={mediaResolver(data, 'preview')} preview />
