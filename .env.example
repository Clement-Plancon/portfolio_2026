# Copier dans Netlify > Site configuration > Environment variables (jamais dans le dépôt).

# Jeton GitHub "fine-grained" limité au dépôt du site.
# Permissions : Contents (Read and write), Commit statuses (Read-only), Metadata (Read-only).
GITHUB_TOKEN=

# Dépôt et branches utilisés par le CMS.
GITHUB_REPO=Clement-Plancon/portfolio_2026
GITHUB_BRANCH=main
GITHUB_DRAFT_BRANCH=cms-draft

# Adresses autorisées à utiliser /admin (séparées par des virgules).
ADMIN_EMAILS=

# URL du déploiement de branche de cms-draft (aperçu). Exemple : https://cms-draft--mon-site.netlify.app
PREVIEW_URL=
